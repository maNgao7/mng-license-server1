{
  "name": "mng-tiktok-game",
  "version": "6.5.17",
  "description": "TikMnG Canlı Yayın Oyun Platformu",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable",
    "dist": "electron-builder",
    "test:packaged-games": "node scripts/smoke-packaged-games.mjs"
  },
  "build": {
    "appId": "com.mng.tiktokgame",
    "productName": "TikMnG",
    "electronVersion": "31.7.7",
    "compression": "maximum",
    "copyright": "Copyright © 2024 MNG",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "license-server.txt",
      "renderer/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "renderer/assets/icon-v3.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "deleteAppDataOnUninstall": false,
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "installerIcon": "renderer/assets/icon-v3.ico",
      "uninstallerIcon": "renderer/assets/icon-v3.ico",
      "installerHeaderIcon": "renderer/assets/icon-v3.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "TikMnG",
      "differentialPackage": true,
      "preCompressedFileExtensions": []
    },
    "publish": [{ "provider": "github", "owner": "maNgao7", "repo": "mng-license-server1" }]
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "6.8.9",
    "extract-zip": "2.0.1",
    "lucide": "0.468.0",
    "matter-js": "^0.20.0",
    "tiktok-live-connector": "2.4.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^24.13.3"
  }
}
