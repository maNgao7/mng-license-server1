{
  "name": "mng-tiktok-game",
  "version": "7.0.38",
  "description": "TikMnG Canlı Yayın Oyun Platformu",
  "main": "main.js",
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "6.8.10",
    "extract-zip": "2.0.1",
    "lucide": "0.468.0",
    "matter-js": "^0.20.0",
    "semver": "7.7.4",
    "tiktok-live-connector": "2.4.4",
    "ws": "8.22.0",
    "yauzl": "2.10.0",
    "tiktok-live-api-sdk": "0.4.0-beta1"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable",
    "dist": "electron-builder",
    "test:packaged-games": "node scripts/smoke-packaged-games.mjs"
  },
  "build": {
    "appId": "com.mng.tiktokgame",
    "productName": "TikMnG",
    "electronVersion": "31.7.7",
    "compression": "maximum",
    "copyright": "Copyright © 2024 MNG",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "license-server.txt",
      "renderer/**/*",
      "!node_modules/**/*.map",
      "!renderer/assets/streamer-entry-v1.png",
      "!renderer/assets/streamer-entry-v2.png",
      "!renderer/assets/game-covers/orbit-v3.png",
      "!renderer/assets/game-covers/crowd-control-v3.png",
      "!renderer/assets/game-covers/vs-v3.png",
      "!renderer/assets/game-covers/puanlama-v3.png",
      "!renderer/assets/game-covers/tightrope-balance-v3.png",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**/*",
      "!lib/portrait-engine/**/*",
      "!node_modules/onnxruntime-node/**/*",
      "!lib/fetih-preview*",
      "!renderer/launcher-theme.css",
      "!renderer/assets/icon-v5.*"
    ],
    "extraResources": [],
    "asarUnpack": [
      "lib/minecraft-path-compat.cjs",
      "renderer/assets/**/*",
      "renderer/gift-assets/**/*",
      "renderer/widgets/cinematic/**/*",
      "renderer/widgets/royal-assets/**/*",
      "renderer/fonts/**/*",
      "node_modules/onnxruntime-node/bin/**/*",
      "lib/vendor/*-worker.cjs",
      "lib/vendor/onnx-wasm/**/*",
      "lib/vendor/*-worker.py"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "renderer/assets/icon-v4.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "include": "build/installer-compatibility.nsh",
      "deleteAppDataOnUninstall": false,
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "installerIcon": "renderer/assets/icon-v4.ico",
      "uninstallerIcon": "renderer/assets/icon-v4.ico",
      "installerHeaderIcon": "renderer/assets/icon-v4.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "TikMnG",
      "differentialPackage": true,
      "preCompressedFileExtensions": [],
      "artifactName": "TikMnG-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "maNgao7",
        "repo": "mng-license-server1"
      }
    ],
    "releaseInfo": {
      "releaseNotes": "Ring\n• Yeni oyun Ring, kütüphaneye ve oyun detayına eklendi.\n• Kurulum ve kullanım videosu, Steam demo bağlantısı ve altı maddelik kurallar yer alır.\n• FPS görüntü hızı değildir; ringe giriş sıra puanıdır. Hediye coin değeri kadar FPS, her 100 beğenide 1 FPS ve ilk takipte 5 FPS eklenir.\n• Standart beğeni kuralı 100 beğeni / 2 yumruktur. Eşik, adet ve hasar B menüsünde ayarlanabilir.\n• Mavi Gül, kırmızı TikTok hediyesiyle desteklenir; köşe hediyeleri değiştirilebilir.\n• Ring ayrı indirilir. Steam Online Boxing 3D Demo bir kez kurulmalıdır. Python kurulumu gerekmez.\n\nKorunan ayarlar\n• Mevcut oyunlar, lisans, yayın bağlantısı ve kayıtlı ayarlar korunur. Render dağıtımı kullanıcı tarafından ayrıca yapılır."
    },
    "portable": {
      "artifactName": "TikMnG-${version}-Portable.${ext}"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
