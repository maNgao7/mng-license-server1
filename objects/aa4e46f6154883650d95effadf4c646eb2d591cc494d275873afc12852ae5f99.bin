<!doctype html>
<html lang="tr"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>TikMnG Yılan Arena</title>
<style>
:root{color-scheme:dark;--accent:#6ce2bb;--muted:#bfd1cc}*{box-sizing:border-box}body{margin:0;background:transparent;color:#f5faf7;font-family:Arial,sans-serif;letter-spacing:0}main{width:min(100%,480px);padding:12px}header{display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid var(--accent);padding:12px 4px 14px;background:#101a18ee}h1{font-size:23px;margin:0;font-weight:800}small{font-size:11px;color:var(--muted)}ol{list-style:none;margin:0;padding:0}li{display:grid;grid-template-columns:28px 48px minmax(0,1fr) auto;align-items:center;gap:12px;min-height:70px;background:#111a18e8;border-bottom:1px solid #ffffff20;padding:10px 14px}li:first-child{background:#203b32ed;min-height:90px;border-left:4px solid var(--accent);padding-left:10px}li:first-child .avatar{width:56px;height:56px}li:first-child{grid-template-columns:28px 56px minmax(0,1fr) auto}.avatar{width:44px;height:44px;border:2px solid var(--accent);border-radius:50%;object-fit:cover;background:#30483e;display:grid;place-items:center;font-size:20px;font-weight:bold}.rank{font-size:18px;color:var(--accent);font-variant-numeric:tabular-nums}.name{font-size:18px;font-weight:700;overflow-wrap:anywhere;min-width:0}.value{text-align:right;font-size:26px;font-weight:800;font-variant-numeric:tabular-nums}.unit{display:block;font-size:11px;font-weight:400;color:var(--muted);margin-top:3px}#empty{padding:24px;background:#111a18db;font-size:15px;color:var(--muted)}footer{padding:8px 4px;color:#d8e6dd;font-size:11px;background:#101a18c0}.wins{--accent:#ffd66b}.wins li:first-child{background:#433b21ed}@media(prefers-reduced-motion:no-preference){li.changed{animation:arrive .3s ease-out}@keyframes arrive{from{transform:translateX(12px);opacity:.5}to{transform:translateX(0);opacity:1}}}@media(max-width:340px){li{gap:7px;padding:9px 7px;grid-template-columns:20px 36px minmax(0,1fr) auto}li:first-child{grid-template-columns:20px 40px minmax(0,1fr) auto}.avatar,li:first-child .avatar{width:36px;height:36px}.name{font-size:14px}.value{font-size:20px}h1{font-size:19px}}
</style>
<style>.avatar img{display:block;width:100%;height:100%;border:0}</style>
<main><header><h1 id="title">En Büyük Yılanlar</h1><small>TikMnG</small></header><ol id="ranking"></ol><div id="empty">Katılımcı bekleniyor</div><footer id="status">Arena bağlantısı bekleniyor</footer></main>
<script>
const stateURL=__STATE_URL__,isWins=new URLSearchParams(location.search).get('type')==='snake-wins';
document.body.classList.toggle('wins',isWins);document.getElementById('title').textContent=isWins?'Kazananlar':'En Büyük Yılanlar';
const rows=new Map(),list=document.getElementById('ranking');let busy=false;
async function update(){if(busy)return;busy=true;try{const response=await fetch(stateURL,{cache:'no-store'});if(!response.ok)throw Error();const data=await response.json();const values=(isWins?data.winners:data.snakes).filter(p=>!isWins||p.wins>0).slice(0,10),kept=new Set();
values.forEach((p,i)=>{let entry=rows.get(p.id);if(!entry){const li=document.createElement('li'),rank=document.createElement('span'),avatar=document.createElement('span'),name=document.createElement('span'),value=document.createElement('span'),amount=document.createElement('span'),unit=document.createElement('span');rank.className='rank';avatar.className='avatar';name.className='name';value.className='value';unit.className='unit';value.append(amount,unit);li.append(rank,avatar,name,value);entry={li,rank,avatar,name,amount,unit,profile:null};rows.set(p.id,entry);}const {li}=entry;kept.add(p.id);entry.rank.textContent=i+1;entry.name.textContent=p.name;entry.amount.textContent=isWins?p.wins+'x':Math.floor(p.mass).toLocaleString('tr-TR');entry.unit.textContent=isWins?'galibiyet':'kütle';if(entry.profile!==p.profile){entry.profile=p.profile;entry.avatar.replaceChildren();if(p.profile){const image=new Image();image.alt='';image.src=p.profile;image.className='avatar';image.onerror=()=>entry.avatar.replaceChildren(document.createTextNode((p.name||'?').slice(0,1).toUpperCase()));entry.avatar.append(image);}else entry.avatar.textContent=(p.name||'?').slice(0,1).toUpperCase();}if(list.children[i]!==li){li.classList.remove('changed');list.insertBefore(li,list.children[i]||null);li.classList.add('changed');}});
for(const [id,entry]of rows)if(!kept.has(id)){entry.li.remove();rows.delete(id);}document.getElementById('empty').hidden=values.length>0;document.getElementById('status').textContent=data.online?'Canlı arena':'Arena bağlantısı bekleniyor';
}catch{document.getElementById('status').textContent='Yeniden bağlanıyor';}finally{busy=false;}}
update();setInterval(update,800);
</script></html>
