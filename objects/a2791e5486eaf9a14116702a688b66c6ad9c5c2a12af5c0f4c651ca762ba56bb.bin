   for(let i=-2;i<=2;i++)for(let j=-2;j<=2;j++){const c=G.get((gx+i)*1000+gz+j);if(c)for(const e of c){if(e.a===s.a||e.hp<=0||e.held)continue;const ex=e.x-s.x,ez=e.z-s.z,d=Math.hypot(ex,ez);
    if(d<REACH*1.6&&(d<.01||(ex*fx+ez*fz)/d>.1)&&d<hitDistance){hitTarget=e;hitDistance=d}}}if(hitTarget){hurt(hitTarget,s,12);if(hitTarget.hp<=0)s.kills++}}
  if(s.swing>0){s.swing-=dt;s.st=2;s.ang=Math.atan2(-Math.sin(P.yaw),-Math.cos(P.yaw))}else if(moving){s.st=1;s.ang=Math.atan2(dx,dz)}else s.st=0}
 // yükseklik / düşme
 for(const s of SO){if(s.held)continue;const g=Hh(s.x,s.z);
  if(s.air){s.vy-=30*dt;s.y+=s.vy*dt;s.fy=Math.max(s.fy,s.y);if(s.y<=g){const drop=s.fy-g;if(drop>14)s.hp-=(drop-14)*1.5;s.y=g;s.vy=0;s.air=false;s.fy=0}}else s.y=g}
 // ölenler -> ceset animasyonu
  for(let i=SO.length-1;i>=0;i--)if(SO[i].hp<=0){const s=SO[i];s.dead=true;if(s.target?.engagedBy===s)s.target.engagedBy=null;if(s.engagedBy)s.engagedBy.target=null;if(s.commander)s.a.commanderUid=null;if(VAT){if(DEAD.length>=DMAX)DEAD.shift();DEAD.push({x:s.x,y:s.y,z:s.z,ang:s.ang,age:0,col:s.a.dcol})}SO[i]=SO[SO.length-1];SO.pop()}
  for(const a of AR)if(a.alive&&!a.commanderUid){const next=SO.find(s=>s.a===a&&s.hp>0);if(next){next.commander=true;next.hp=Math.max(next.hp,60);a.commanderUid=next.uid}}
 for(let i=DEAD.length-1;i>=0;i--){DEAD[i].age+=dt;if(DEAD[i].age>6)DEAD.splice(i,1)}
 if(ctl&&ctl.hp<=0)exitCtl('💀 Askerin düştü! Tanrı moduna döndün');
 // ---- kamera ----
 if(ctl){const s=ctl;P.pitch=clamp(P.pitch,-.9,1.3);const cp=Math.cos(P.pitch),fx=-Math.sin(P.yaw)*cp,fy=Math.sin(P.pitch),fz=-Math.cos(P.yaw)*cp,hx=s.x,hy=s.y+KNIGHT_H*.85,hz=s.z;
  if(fp)cam.position.set(hx+fx*.4,hy,hz+fz*.4);else{const D=8,cx=hx-fx*D,cz=hz-fz*D;cam.position.set(cx,Math.max(hy-fy*D,Hh(cx,cz)+1.2),cz)}
  cam.rotation.set(P.pitch,P.yaw,0)}
 else{cam.position.set(P.x,P.y,P.z);cam.rotation.set(P.pitch,P.yaw,0)}
 cam.updateMatrixWorld(true);
 const ct=clamp((cam.position.y-Math.max(Hh(cam.position.x,cam.position.z),-4))/150,0,1);S.fog.near=150+550*ct;S.fog.far=950+1650*ct;
 // ---- artı işareti: seç / taşı ----
 if(!ctl){const h=pickAt();hover=h;
  if(grabReq&&!hold&&h){const L=h.s,list=[L];for(const s of SO){if(list.length>=GRAB_MAX)break;if(s===L||s.pl||s.held||s.hp<=0)continue;if(Math.hypot(s.x-L.x,s.z-L.z)<GRAB_R&&Math.abs(s.y-L.y)<3)list.push(s)}
   hold={dist:h.t,L,items:list.map(s=>({s,ox:s.x-L.x,oy:s.y-L.y,oz:s.z-L.z}))};for(const s of list){s.held=true;s.air=false}}
  grabReq=false;
  if(hold&&!mouseL){for(const it of hold.items){it.s.held=false;it.s.air=true;it.s.vy=0;it.s.fy=it.s.y}hold=null}
  if(hold){cam.getWorldDirection(fwd);const px=cam.position.x+fwd.x*hold.dist,py=cam.position.y+fwd.y*hold.dist,pz=cam.position.z+fwd.z*hold.dist,ly=Math.max(py,Hh(px,pz)+1);
   for(const it of hold.items){const s=it.s;s.x=clamp(px+it.ox,-W+20,W-20);s.z=clamp(pz+it.oz,-W+20,W-20);s.y=ly+it.oy;s.st=1}}}
 else{hover=null;grabReq=false;if(hold)hold=null}
 const cr=$('cross');cr.style.display=ctl?'none':'';cr.style.setProperty('--cc',hold?'#4cff4c':hover?'#ff4040':'#ffffff');
 const tg=$('tgt');if(hover&&!hold){tg.style.display='block';tg.textContent=`${hover.s.a.name} • ❤ ${Math.ceil(hover.s.hp)}`;tg.style.color='#'+hover.s.a.color.getHexString()}else tg.style.display='none';
 // ---- yakındaki askerlere gerçek şövalye modeli ver ----
 const CX=cam.position.x,CY=cam.position.y,CZ=cam.position.z;
 lr+=dt;if(pool.length&&lr>.25){lr=0;for(const it of pool){if(it.s)it.s.rich=null;it.s=null}
  const near=[];for(const s of SO){if(s.pl)continue;const d=(s.x-CX)**2+(s.z-CZ)**2+(s.y-CY)**2;if(d<4900)near.push([d,s])}
  near.sort((a,b)=>a[0]-b[0]);for(let i=0;i<pool.length&&i<near.length;i++){const s=near[i][1];pool[i].s=s;s.rich=pool[i];const c=pool[i];
   if(c.army!==s.a){c.army=s.a;tint(c,s.a.color)}}}
 for(const it of pool){const s=it.s;if(!s||s.dead||s.hp<=0||s.pl){it.root.visible=false;continue}
   it.root.visible=true;it.root.position.set(s.x,s.y,s.z);it.root.rotation.y=s.ang+FACE;it.root.scale.setScalar(s.commander?COMMANDER_SCALE:1);
  setAnim(it,s.st,s);it.mx.update(dt)}
 // oynanan asker (şövalye modeli)
 if(ctl){const s=ctl;if(PK){PK.root.visible=!fp;PK.root.position.set(s.x,s.y,s.z);PK.root.rotation.y=s.ang+FACE;PK.root.scale.setScalar(s.commander?COMMANDER_SCALE:1);if(PK.army!==s.a){PK.army=s.a;tint(PK,s.a.color)}setAnim(PK,s.st,s);PK.mx.update(dt)}
  else{pl.visible=!fp;pl.position.set(s.x,s.y,s.z);pl.rotation.y=s.ang}}
 // ---- toplu çizim (animasyonlu) ----
 if(VAT)VAT.U.uTime.value=gt;
 const aa=VAT?SM.geometry.attributes.aAnim:null;
  let j=0;for(let i=0;i<SO.length;i++){const s=SO[i];if(s.rich||s.pl)continue;dm.position.set(s.x,s.y,s.z);dm.rotation.y=s.ang+FACE;dm.scale.setScalar(s.commander?COMMANDER_SCALE:1);dm.updateMatrix();SM.setMatrixAt(j,dm.matrix);SM.setColorAt(j,s.a.tint);
  if(aa){aa.array[j*2]=s.st;aa.array[j*2+1]=(s.st===2||s.st===4)?-s.atkT*VAT.fps[s.st]/VF:s.ph}j++}
 if(aa)for(const d of DEAD){if(j>=MAX+DMAX)break;dm.position.set(d.x,d.y-Math.max(0,d.age-4)*.8,d.z);dm.rotation.y=d.ang+FACE;dm.scale.setScalar(1);dm.updateMatrix();SM.setMatrixAt(j,dm.matrix);SM.setColorAt(j,d.col);aa.array[j*2]=3;aa.array[j*2+1]=d.age;j++}
 SM.count=j;SM.instanceMatrix.needsUpdate=true;SM.instanceColor.needsUpdate=true;if(aa)aa.needsUpdate=true;
 // ---- etiketler / HUD ----
  const v=new THREE.Vector3();for(const a of AR){const commander=SO.find(s=>s.uid===a.commanderUid&&s.hp>0);if(commander)v.set(commander.x,commander.y+.1,commander.z);else v.set(a.cx,Hh(a.cx,a.cz)+KNIGHT_H*2.2,a.cz);v.project(cam);
  const show=hudOn&&v.z<1&&a.alive>0&&Math.abs(v.x)<1.1&&Math.abs(v.y)<1.1;a.el.style.display=show?'':'none';
   if(show){a.el.style.transform=`translate(${(v.x*.5+.5)*innerWidth}px,${(-v.y*.5+.5)*innerHeight}px) translate(-50%,12px)`;
     a.el.innerHTML=`<img src="${a.avatar||''}" onerror="this.style.display='none'" style="width:30px;height:30px;border-radius:50%;vertical-align:middle;border:2px solid currentColor"> <span><b>${a.name}</b><small style="display:block">KOMUTAN • ${a.alive} asker</small></span>`}}
 lt+=dt;if(lt>.25){lt=0;let tot=0;
  for(const [k,a] of A){if(a.alive===0&&a.pending===0){a.el.remove();A.delete(k)}else tot+=a.alive+a.pending}
  const totEl=$('tot'); if(totEl) totEl.textContent=`AKTİF ORDULAR: ${A.size} • TOPLAM ASKER: ${tot}`;
  updateArmyLeaderboard();
 }
 R.render(S,cam)}
requestAnimationFrame(loop);

// ============================================================
// UI MODÜLÜ: Ayarlar, Sürüklenebilir Paneller, WebSocket
// ============================================================
function makeDraggable(panelId, headerId) {
  const panel = document.getElementById(panelId);
  const header = document.getElementById(headerId);
  if (!panel || !header) return;
  const saved = (() => { try { const p = JSON.parse(localStorage.getItem('mng_battle_panel_' + panelId)); return p; } catch { return null; } })();
  if (saved) { panel.style.top = saved.top; panel.style.left = saved.left; panel.style.right = 'auto'; panel.style.bottom = 'auto'; }
  let ox = 0, oy = 0, dragging = false;
  header.addEventListener('pointerdown', e => {
    if (e.target.tagName === 'BUTTON') return;
    dragging = true; header.setPointerCapture(e.pointerId);
    const r = panel.getBoundingClientRect(); ox = e.clientX - r.left; oy = e.clientY - r.top;
  });
  header.addEventListener('pointermove', e => {
    if (!dragging) return;
    const left = Math.max(0, Math.min(e.clientX - ox, innerWidth - panel.offsetWidth));
    const top = Math.max(0, Math.min(e.clientY - oy, innerHeight - panel.offsetHeight));
    panel.style.left = left + 'px'; panel.style.top = top + 'px'; panel.style.right = 'auto'; panel.style.bottom = 'auto';
  });
  header.addEventListener('pointerup', () => {
    dragging = false;
    try { localStorage.setItem('mng_battle_panel_' + panelId, JSON.stringify({ top: panel.style.top, left: panel.style.left })); } catch {}
  });
}
makeDraggable('armyLeaderboardPanel', 'armyHeader');
makeDraggable('winsPanel', 'winsHeader');

// Ordu Liderlik tablosu güncellemesi
const winsMap = new Map();
const winnerProfiles = new Map();
function updateWinsPanel() {
  const el = document.getElementById('winsList');
  if (!el) return;
  const entries = [...winsMap.entries()]
    .filter(([, count]) => count > 0)
    .map(([id, count]) => ({ id, count, ...(winnerProfiles.get(id) || {}) }))
    .sort((a, b) => b.count - a.count || String(a.name || a.id).localeCompare(String(b.name || b.id)));
  el.replaceChildren();
  if (!entries.length) { el.innerHTML = '<div style="text-align:center;padding:10px;color:#94a3b8;font-size:12px;">Henüz galip yok</div>'; return; }
  entries.forEach((entry, index) => {
    const row = document.createElement('div'); row.className = 'rank-row';
    const rank = document.createElement('span'); rank.className = 'rank-num'; rank.textContent = index === 0 ? '👑' : String(index + 1);
    const avatar = document.createElement('img'); avatar.className = 'rank-avatar'; avatar.src = entry.avatar || '/api/avatar?user=' + encodeURIComponent(entry.name || entry.id); avatar.onerror = () => { avatar.src = '/api/avatar?user=winner'; };
    const info = document.createElement('div'); info.className = 'rank-info';
    const name = document.createElement('div'); name.className = 'rank-name'; name.textContent = entry.name || entry.id;
    const wins = document.createElement('div'); wins.className = 'rank-count'; wins.textContent = `${entry.count}X turnuva galibiyeti`;
    info.append(name, wins); row.append(rank, avatar, info); el.appendChild(row);
  });
}
function updateArmyLeaderboard() {
  const el = document.getElementById('armyList');
  if (!el) return;
  const sorted = [...A.values()].sort((a, b) => (b.alive + b.pending) - (a.alive + a.pending)).slice(0, 10);
  if (!sorted.length) { el.innerHTML = '<div style="text-align:center;padding:10px;color:#94a3b8;font-size:12px;">Henüz ordu kurulmadı</div>'; return; }
  el.innerHTML = '';
  sorted.forEach((a, i) => {
    const crown = i === 0 ? '👑' : i === 1 ? '🥈' : i === 2 ? '🥉' : '';
    const wins = winsMap.get(a.name) || 0;
    const row = document.createElement('div'); row.className = 'rank-row';
    row.innerHTML = `<span class="rank-num" style="color:${i===0?'#fbbf24':i===1?'#94a3b8':i===2?'#cd7f32':'#64748b'}">${crown||('#'+(i+1))}</span>
      <img class="rank-avatar" src="${a.avatar||'/api/avatar?user='+encodeURIComponent(a.name)}" onerror="this.src='/api/avatar?user=u'">
      <div class="rank-info"><div class="rank-name">${a.name}</div><div class="rank-count">⚔ ${a.alive+a.pending} asker | 🏆 ${wins} galibiyet</div></div>
      <div class="win-controls"><button class="win-btn" onclick="addWin('${a.name}')">+</button><button class="win-btn" onclick="removeWin('${a.name}')">−</button></div>`;
    el.appendChild(row);
  });
  if (ws && ws.readyState === WebSocket.OPEN) {
    ws.send(JSON.stringify({ type: 'army-leaderboard', entries: sorted.map((a, i) => ({ rank:i+1, name:a.name, avatar:a.avatar||'', soldiers:a.alive+a.pending })) }));
  }
}
function tournamentChange(name, delta) {
  const army = [...A.values()].find(entry => entry.name === name);
  const current = Math.max(0, (winsMap.get(name) || 0) + delta);
  winsMap.set(name, current);
  if (army) winnerProfiles.set(name, { name: army.name, avatar: army.avatar || '' });
  updateArmyLeaderboard(); updateWinsPanel();
  if (ws && ws.readyState === WebSocket.OPEN) {
    ws.send(JSON.stringify({ type: 'tournament-win', delta, player: { id: name, name, avatar: army?.avatar || '' } }));
  }
}
window.addWin = name => tournamentChange(name, 1);
window.removeWin = name => tournamentChange(name, -1);
updateWinsPanel();

// Hediye Kuralları
const DEFAULT_RULES = [
  { id: '5655', name: 'Gül', image: '/catalog-assets/gift-images/Rose.png', soldiers: 5 },
  { id: '6531', name: 'Donut', image: '/catalog-assets/gift-images/Doughnut.png', soldiers: 30 },
  { id: '7046', name: 'Çay', image: '/catalog-assets/gift-images/Tea.png', soldiers: 50 },
  { id: '7419', name: 'Para Tabancası', image: '/catalog-assets/gift-images/Money_Gun.png', soldiers: 200 }
];
let giftRules = (() => { try { return JSON.parse(localStorage.getItem('mng_battle_rules')) || [...DEFAULT_RULES]; } catch { return [...DEFAULT_RULES]; } })();
let editingRuleIdx = null;
let giftCatalogCache = [];

function saveRules() { try { localStorage.setItem('mng_battle_rules', JSON.stringify(giftRules)); } catch {} }

function renderRules() {
  const el = document.getElementById('rulesListContainer');
  if (!el) return;
  el.innerHTML = '';
  giftRules.forEach((r, i) => {
    const d = document.createElement('div'); d.className = 'rule-item';
    d.innerHTML = `<img class="rule-gift-img" src="${r.image}" onerror="this.src='/api/avatar?user=gift'">
      <span class="rule-gift-name">${r.name}</span>
      <div class="rule-soldier-count"><span>Asker:</span><input class="rule-soldier-input" type="number" min="1" max="9999" value="${r.soldiers}" data-idx="${i}"></div>
      <button class="rule-change-btn" data-idx="${i}">Hediye Değiştir</button>
      <button class="rule-del-btn" data-idx="${i}">🗑</button>`;
    d.querySelector('.rule-soldier-input').addEventListener('change', e => { giftRules[i].soldiers = Math.max(1, parseInt(e.target.value) || 1); saveRules(); });
    d.querySelector('.rule-change-btn').addEventListener('click', () => openGiftPicker(i));
    d.querySelector('.rule-del-btn').addEventListener('click', () => { giftRules.splice(i, 1); saveRules(); renderRules(); });
    el.appendChild(d);
  });
}

async function openGiftPicker(ruleIdx) {
  editingRuleIdx = ruleIdx;
  const m = document.getElementById('giftPickerModal'); if (!m) return;
  m.style.display = 'flex';
  document.getElementById('giftPickerTitle').textContent = (ruleIdx === null ? 'Yeni Kural için' : giftRules[ruleIdx].name + ' Yerine') + ' Hediye Seçin';
  document.getElementById('giftPickerSearch').value = '';
  if (!giftCatalogCache.length) {
    try { const r = await fetch('/api/gifts?limit=700'); giftCatalogCache = await r.json(); } catch {}
  }
  renderGiftPickerItems(giftCatalogCache);
}

function renderGiftPickerItems(items) {
  const g = document.getElementById('giftPickerGrid'); if (!g) return;
  g.innerHTML = '';
  (items || []).forEach(item => {
    const d = document.createElement('div'); d.className = 'picker-item';
    d.innerHTML = `<img src="${item.image}" onerror="this.src=''"><span>${item.name}</span><small>${item.coins} coin</small>`;
    d.addEventListener('click', () => {
      if (editingRuleIdx === null) {
        giftRules.push({ id: String(item.id), name: item.name, image: item.image, soldiers: 10 });
      } else {
        giftRules[editingRuleIdx].id = String(item.id);
        giftRules[editingRuleIdx].name = item.name;
        giftRules[editingRuleIdx].image = item.image;
      }
      saveRules(); renderRules();
      document.getElementById('giftPickerModal').style.display = 'none';
    });
    g.appendChild(d);
  });
}

document.getElementById('giftPickerSearch')?.addEventListener('input', e => {
  const q = e.target.value.toLowerCase().trim();
  const filtered = q ? giftCatalogCache.filter(g => g.name.toLowerCase().includes(q) || String(g.coins).includes(q)) : giftCatalogCache;
  renderGiftPickerItems(filtered);
});
document.getElementById('closeGiftPickerBtn')?.addEventListener('click', () => { document.getElementById('giftPickerModal').style.display = 'none'; });
document.getElementById('addRuleBtn')?.addEventListener('click', () => openGiftPicker(null));

// Ayarlar Modal
const settingsBtn = document.getElementById('openSettingsBtn');
const closeSettingsBtn = document.getElementById('closeSettingsBtn');
const settingsModal = document.getElementById('settingsModal');
if (settingsBtn) settingsBtn.addEventListener('click', () => { renderRules(); settingsModal.style.display = 'flex'; });
if (closeSettingsBtn) closeSettingsBtn.addEventListener('click', () => { settingsModal.style.display = 'none'; });
document.getElementById('battleMapSelect')?.addEventListener('change', event => applyBattleMap(event.target.value));
document.getElementById('roundDuration')?.addEventListener('change', resetRound);
document.getElementById('roundStartBtn')?.addEventListener('click', () => { if(roundFinished)resetRound();roundRunning=true;msg('⚔️ Tur başladı!'); });
document.getElementById('roundPauseBtn')?.addEventListener('click', () => { roundRunning=false;msg('⏸ Tur duraklatıldı'); });
document.getElementById('roundRestartBtn')?.addEventListener('click', resetRound);

// Test Butonları
const spawnTestGift = (soldiers, label) => {
  const nm = ['Ahmet','Mehmet','Ali','Ayşe','Murat'][Math.floor(Math.random()*5)];
  addGift(nm, soldiers, '', label);
};
document.getElementById('test10Btn')?.addEventListener('click', () => spawnTestGift(10, 'Gül'));
document.getElementById('test50Btn')?.addEventListener('click', () => spawnTestGift(50, 'Donut'));
document.getElementById('test100Btn')?.addEventListener('click', () => spawnTestGift(100, 'Çay'));
document.getElementById('test500Btn')?.addEventListener('click', () => spawnTestGift(500, 'Para Tabancası'));

// WebSocket Bağlantısı
let ws = null, wsRetryTimer = null;
function connectWS() {
  if (ws && ws.readyState < 2) return;
  try {
    ws = new WebSocket(`ws://${location.host}`);
    ws.addEventListener('open', () => { const autoUser=new URLSearchParams(location.search).get('autoUser'); console.log('MNG Battle Game WS bağlantısı kuruldu.'); if(autoUser)ws.send(JSON.stringify({type:'connect',username:'@'+autoUser})); });
    ws.addEventListener('message', e => {
      try {
        const msg2 = JSON.parse(e.data);
        if (msg2.type === 'gift') {
          const p = msg2.player || {};
          const giftId = String(msg2.giftId || '');
          const coins = Number(msg2.coins) || 1;
          const rule = giftRules.find(r => r.id === giftId || r.name.toLowerCase() === (msg2.giftName||'').toLowerCase());
          const soldiers = rule ? rule.soldiers : Math.max(1, Math.ceil(coins / 10));
          addGift(p.username || p.nickname || 'İzleyici', soldiers, p.avatar || '', msg2.giftName || '');
        } else if (msg2.type === 'tournament-winners') {
          winsMap.clear(); winnerProfiles.clear();
          (msg2.entries || []).forEach(entry => {
            const id = String(entry.id || entry.name || '');
            if (!id) return;
            winsMap.set(id, Math.max(0, Number(entry.count) || 0));
            winnerProfiles.set(id, { name: entry.name || id, avatar: entry.avatar || '' });
          });
          updateArmyLeaderboard(); updateWinsPanel();
        } else if (msg2.type === 'status') {
          const cs = document.getElementById('connectionStatus');
          if (cs) {
            const labels = { connecting: '⏳ Bağlanıyor...', connected: '✅ Bağlandı: @' + msg2.username, error: '❌ Hata: ' + msg2.error, disconnected: '🔴 Bağlantı kesildi', streamEnd: '📴 Yayın sona erdi' };
            cs.textContent = 'Durum: ' + (labels[msg2.status] || msg2.status);
            cs.style.color = msg2.status === 'connected' ? '#22c55e' : msg2.status === 'error' || msg2.status === 'disconnected' ? '#ef4444' : '#94a3b8';
          }
        }
      } catch {}
    });
    ws.addEventListener('close', () => { wsRetryTimer = setTimeout(connectWS, 3000); });
    ws.addEventListener('error', () => ws.close());
  } catch (err) { console.warn('WS bağlantısı başlatılamadı:', err.message); }
}
connectWS();

async function copyLauncherWidget(mode, label) {
  try {
    const response = await fetch('/api/launcher-widget-links', { cache: 'no-store' });
    const data = await response.json();
    const url = data.links?.[mode];
    if (!response.ok || !data.ready || typeof url !== 'string' || new URL(url).protocol !== 'https:') throw new Error(data.message || 'HTTPS yayın bağlantısı hazır değil. Launcher içinden yayın bağlantısını hazırlayın.');
    try { await navigator.clipboard.writeText(url); msg(label + ' widget bağlantısı kopyalandı'); }
    catch { prompt('OBS Browser kaynağı bağlantısı:', url); }
  } catch (error) { msg(error.message || 'HTTPS yayın bağlantısı kullanılamıyor.'); }
}
document.getElementById('tournamentWidgetBtn')?.addEventListener('click', () => copyLauncherWidget('winners', 'Turnuva'));
document.getElementById('armyWidgetBtn')?.addEventListener('click', () => copyLauncherWidget('armies', 'Asker liderleri'));
document.getElementById('tournamentResetBtn')?.addEventListener('click', () => {
  winsMap.clear(); winnerProfiles.clear(); updateArmyLeaderboard(); updateWinsPanel();
  if (ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ type: 'tournament-reset' }));
});

// TikTok Bağlantı Butonu
document.getElementById('connectTiktokBtn')?.addEventListener('click', () => {
  const inp = document.getElementById('tiktokUsernameInput');
  const user = (inp ? inp.value : '').trim().replace(/^@/, '');
  if (!user) return;
  if (ws && ws.readyState === 1) {
    ws.send(JSON.stringify({ type: 'connect', username: '@' + user }));
  }
  settingsModal.style.display = 'none';
});
