let roundSeconds=300,roundRemaining=300,roundRunning=false,roundFinished=false;
function renderRoundClock(){const clock=$('roundClock');if(clock){const mins=Math.floor(roundRemaining/60),secs=Math.ceil(roundRemaining%60);clock.textContent=`${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;}}
function finishRound(){if(roundFinished)return;roundFinished=true;roundRunning=false;const winner=[...A.values()].sort((a,b)=>b.alive-a.alive||b.pending-a.pending)[0];if(!winner){msg('Tur bitti. Kazanan çıkmadı.');return}tournamentChange(winner.name,1);msg(`👑 TUR KAZANANI<br><b>${winner.name}</b><br>${winner.alive} asker hayatta kaldı`);}
function updateRound(dt){if(!roundRunning||roundFinished)return;roundRemaining=Math.max(0,roundRemaining-dt);renderRoundClock();if(roundRemaining<=0)finishRound();}
function resetRound(){roundSeconds=Math.max(10,Number($('roundDuration')?.value)||300);roundRemaining=roundSeconds;roundRunning=false;roundFinished=false;renderRoundClock();msg('Tur yeniden başlatmaya hazır');}
renderRoundClock();
function loop(now){requestAnimationFrame(loop);const dt=Math.min(.05,(now-last)/1e3);last=now;gt=now/1000;updSpark(dt);
 updateRound(dt);
 // E: askere gir / çık
 if(eReq){eReq=false;if(ctl)exitCtl();else if(!hold&&hover&&!hover.s.held&&hover.s.hp>0){const s=hover.s;ctl=s;s.pl=true;s.hp=Math.max(s.hp,80);s.kills=0;s.cd=0;s.swing=0;P.pitch=.25;hover=null;msg(`🎮 ${s.a.name} askerindesin!`)}}
 // girdi ekseni
 let f=(K.KeyW?1:0)-(K.KeyS?1:0),r=(K.KeyD?1:0)-(K.KeyA?1:0);if(joy){f+=-joy.dy;r+=joy.dx}
 const l=Math.hypot(f,r);if(l>1){f/=l;r/=l}
