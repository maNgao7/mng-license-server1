function spark(x,y,z,n){for(let k=0;k<n;k++){const i=spI++%SPN;spP[i*3]=x;spP[i*3+1]=y;spP[i*3+2]=z;spV[i*3]=rnd(-6,6);spV[i*3+1]=rnd(2,8);spV[i*3+2]=rnd(-6,6);spL[i]=rnd(.25,.5)}}
