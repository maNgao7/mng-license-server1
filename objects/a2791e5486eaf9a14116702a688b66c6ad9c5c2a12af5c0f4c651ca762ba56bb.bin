let lastBattleSound=0,battleAudio=null;
function ensureBattleAudio(){try{battleAudio=battleAudio||new (window.AudioContext||window.webkitAudioContext)();if(battleAudio.state==='suspended')battleAudio.resume();return battleAudio}catch{return null}}
function playBattleSound(force=false){const now=performance.now();if(!force&&now-lastBattleSound<85)return;lastBattleSound=now;const ac=ensureBattleAudio();if(!ac)return;try{const t=ac.currentTime,master=ac.createGain(),metal=ac.createOscillator(),ring=ac.createOscillator(),noise=ac.createBufferSource(),filter=ac.createBiquadFilter(),b=ac.createBuffer(1,Math.floor(ac.sampleRate*.18),ac.sampleRate),d=b.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=(Math.random()*2-1)*Math.exp(-i/(d.length*.16));metal.type='triangle';metal.frequency.setValueAtTime(rnd(720,980),t);metal.frequency.exponentialRampToValueAtTime(rnd(170,250),t+.16);ring.type='sine';ring.frequency.setValueAtTime(rnd(1500,2200),t);ring.frequency.exponentialRampToValueAtTime(rnd(700,980),t+.12);noise.buffer=b;filter.type='bandpass';filter.frequency.value=rnd(1800,2800);filter.Q.value=1.4;master.gain.setValueAtTime(.0001,t);master.gain.exponentialRampToValueAtTime(force?.28:.18,t+.004);master.gain.exponentialRampToValueAtTime(.0001,t+.2);metal.connect(master);ring.connect(master);noise.connect(filter);filter.connect(master);master.connect(ac.destination);metal.start(t);ring.start(t);noise.start(t);metal.stop(t+.2);ring.stop(t+.15);noise.stop(t+.18)}catch{}}
for(const ev of['pointerdown','keydown'])addEventListener(ev,()=>ensureBattleAudio(),{once:true});
function hurt(e,s,d){e.hp-=d;playBattleSound();const dx=e.x-s.x,dz=e.z-s.z,l=Math.hypot(dx,dz)||1;if(!e.held&&!e.pl){e.x+=dx/l*.7;e.z+=dz/l*.7}
