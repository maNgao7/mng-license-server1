import * as THREE from 'three';
import {GLTFLoader} from 'three/addons/loaders/GLTFLoader.js';
import {FBXLoader} from 'three/addons/loaders/FBXLoader.js';
import * as SU from 'three/addons/utils/SkeletonUtils.js';
import {mergeGeometries} from 'three/addons/utils/BufferGeometryUtils.js';
window.__ok=1;
// ---- AYARLAR (gerekirse değiştir) ----
// KNIGHT_H: şövalye boyu (eskisi 1.8 idi, şimdi daha büyük). KNIGHT_SCALE: 0=otomatik.
const W=700, MAX=4000, DMAX=500, NEAR=60, KNIGHT_H=3.6, COMMANDER_SCALE=3, FACE=0 /* asker ters bakıyorsa Math.PI yap */, KNIGHT_SCALE=0, VF=24 /* animasyon kare sayısı */;
const SC=KNIGHT_H/1.8, REACH=1.6*SC, GRID=8, GRAB_R=3.5, GRAB_MAX=1 /* tek seferde taşınan asker sayısı (1=tek asker) */, PICK=400;
const $=id=>document.getElementById(id), rnd=(a,b)=>a+Math.random()*(b-a), clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const riverZ=x=>150*Math.sin(x*.004)+60*Math.sin(x*.011);
const Hh=(x,z)=>{const h=(Math.sin(x*.012)*7+Math.cos(z*.015)*7+Math.sin((x+z)*.006)*12+Math.sin(x*.04)*Math.cos(z*.035)*2)*.3,c=Math.exp(-(((z-riverZ(x))/18)**2));return h*(1-c*.85)-c*7};
const R=new THREE.WebGLRenderer({canvas:$('c'),antialias:true});R.setPixelRatio(Math.min(devicePixelRatio,2));
const S=new THREE.Scene();S.background=new THREE.Color(0x8fd0ff);S.fog=new THREE.Fog(0xbfe6ff,150,950);
const cam=new THREE.PerspectiveCamera(65,1,.5,3000);cam.rotation.order='YXZ';
const skyLight=new THREE.HemisphereLight(0xffffff,0x6a8a50,1.1);S.add(skyLight);
const sun=new THREE.DirectionalLight(0xfff2d0,1.6);sun.position.set(200,300,100);S.add(sun);
// ---- ekstra arayüz (artı işareti, mod yazısı, dokunmatik tuşlar) ----
{const st=document.createElement('style');st.textContent=`
#cross{position:fixed;left:50%;top:50%;width:28px;height:28px;transform:translate(-50%,-50%);pointer-events:none;z-index:5;--cc:#fff}
#cross:before,#cross:after{content:'';position:absolute;background:var(--cc);box-shadow:0 0 3px #000}
#cross:before{left:13px;top:0;width:2px;height:28px}#cross:after{top:13px;left:0;height:2px;width:28px}
#tgt{top:calc(50% + 26px);left:50%;transform:translateX(-50%);white-space:nowrap;font-weight:700;display:none}
#mode{top:58px;left:50%;transform:translateX(-50%);white-space:nowrap;font-weight:700;background:rgba(20,60,100,.7)}
#help{bottom:70px;left:6px;max-width:92vw;line-height:1.5}`;document.head.appendChild(st);
 for(const [id,cls] of [['cross',''],['tgt','p'],['mode','p']]){const d=document.createElement('div');d.id=id;d.className=cls;document.body.appendChild(d)}}
const DIRT=new THREE.Color(0x9c8a5c);let terrainMesh=null,waterMesh=null;
// arazi (savaş alanı: ortası çiğnenmiş toprak)
{const g=new THREE.PlaneGeometry(W*2.2,W*2.2,260,260);g.rotateX(-Math.PI/2);const p=g.attributes.position,col=[],c=new THREE.Color();
for(let i=0;i<p.count;i++){const x=p.getX(i),z=p.getZ(i),y=Hh(x,z);p.setY(i,y);const sl=Math.abs(Hh(x+3,z)-y)+Math.abs(Hh(x,z+3)-y);
 const n=.5+.5*Math.sin(x*.05)*Math.cos(z*.045);
 if(y<-1.5)c.set(0xd9c68a);else if(sl>3.2)c.set(0x9b8458);else{c.set(0x62b83c).lerp(new THREE.Color(0xa6dc5a),n*.6+Math.max(0,y)*.01);c.lerp(DIRT,clamp(1-(Math.hypot(x,z)-110)/150,0,1)*(.5+.3*n))}col.push(c.r,c.g,c.b)}
g.setAttribute('color',new THREE.Float32BufferAttribute(col,3));g.computeVertexNormals();
terrainMesh=new THREE.Mesh(g,new THREE.MeshToonMaterial({vertexColors:true}));S.add(terrainMesh);
waterMesh=new THREE.Mesh(new THREE.PlaneGeometry(W*3,W*3).rotateX(-Math.PI/2),new THREE.MeshToonMaterial({color:0x3fb0e0,transparent:true,opacity:.8}));waterMesh.position.y=-3.2;S.add(waterMesh)}
// hazır modeller (Gobkit)
const gl=new GLTFLoader();
async function prop(name,n,th,ok,gen){try{const g=await gl.loadAsync(`assets/nature/${name}.glb`);let m;g.scene.traverse(o=>{if(o.isMesh&&!m)m=o});
 m.geometry.computeBoundingBox();const hh=m.geometry.boundingBox.max.y-m.geometry.boundingBox.min.y,o=m.material;
 const I=new THREE.InstancedMesh(m.geometry,new THREE.MeshToonMaterial({map:o.map,color:o.color,vertexColors:!!m.geometry.attributes.color}),n),d=new THREE.Object3D();let c=0;
 for(let t=0;t<n*10&&c<n;t++){let x,z,y;if(gen)[x,z,y]=gen(c);else{x=rnd(-W*.95,W*.95);z=rnd(-W*.95,W*.95);if(!ok(x,z))continue;y=Hh(x,z)-.2}
  d.position.set(x,y,z);d.rotation.y=rnd(0,6.28);d.scale.setScalar(th/hh*rnd(.75,1.3));d.updateMatrix();I.setMatrixAt(c++,d.matrix)}
 I.count=c;I.frustumCulled=false;S.add(I)}catch(e){window.show&&show('model yüklenemedi: '+name+' -> '+e.message)}}
const dry=(x,z)=>Math.abs(z-riverZ(x))>40, forest=(x,z)=>dry(x,z)&&Math.hypot(x,z)>250&&Math.sin(x*.01)*Math.cos(z*.012)>-.15, steep=(x,z)=>Math.abs(Hh(x+3,z)-Hh(x,z))>1.6;
const ring=(r,y)=>i=>{const a=i*2.4;return[Math.cos(a)*r,Math.sin(a)*r,y]};
$('load').textContent='Harita yükleniyor...';
await Promise.all([
 ...['TreeHigh001','TreeHigh002','TreeMed001','TreeMed002','TreeLow001','TreeLow002'].map(n=>prop(n,10,13,forest)),
 ...['Bush001','Bush002'].map(n=>prop(n,10,2,dry)),...['Grass001','Grass002','Grass003'].map(n=>prop(n,35,1.5,dry)),
 ...['Rock001','Rock002','Rock003'].map(n=>prop(n,8,3,dry)),...['Cliff001','Cliff002','Cliff003'].map(n=>prop(n,4,22,steep)),
 ...['MountainFar001','MountainFar002','MountainFar003'].map((n,i)=>prop(n,7,i?200:300,null,ring(1100+i*40,-40))),
 ...['Cloud001','Cloud002','Cloud003'].map(n=>prop(n,8,45,null,()=>[rnd(-900,900),rnd(160,260),rnd(-900,900)]))
]);
// ---- savaş alanı: kaleler ve çadırlar ----
{const M=c=>new THREE.MeshToonMaterial({color:c}),stone=M(0xb7b0a0),dark=M(0x6d675b),roof=M(0xb8432f),wood=M(0x6b4a2b);
 const box=(g,w,h,d,x,y,z,m)=>{const o=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);o.position.set(x,y,z);g.add(o);return o};
 const flag=(g,x,y,z,c)=>{box(g,.5,12,.5,x,y+6,z,wood);box(g,6,3.5,.3,x+3,y+10,z,M(c))};
 function castle(cx,cz,col){const g=new THREE.Group();g.position.set(cx,Hh(cx,cz),cz);g.rotation.y=Math.atan2(-cx,-cz);const T=34;
  for(const [sx,sz] of [[-1,-1],[1,-1],[-1,1],[1,1]]){const t=new THREE.Mesh(new THREE.CylinderGeometry(6,6.5,38,12),stone);t.position.set(sx*T,13,sz*T);g.add(t);
   const r=new THREE.Mesh(new THREE.ConeGeometry(8,10,12),roof);r.position.set(sx*T,37,sz*T);g.add(r);flag(g,sx*T,40,sz*T,col)}
  box(g,64,22,4,0,5,-T,stone);box(g,4,22,64,-T,5,0,stone);box(g,4,22,64,T,5,0,stone);
  box(g,26,22,4,-19,5,T,stone);box(g,26,22,4,19,5,T,stone);box(g,12,6,4,0,13,T,dark);
  box(g,22,36,22,0,12,-6,stone);const k=new THREE.Mesh(new THREE.ConeGeometry(17,12,4),roof);k.rotation.y=Math.PI/4;k.position.set(0,36,-6);g.add(k);flag(g,0,42,-6,col);S.add(g)}
 const tg=new THREE.ConeGeometry(3.6,4.2,8),tcol=[0xc0392b,0xe8e0c8,0x2e6fb0,0xd9a53a];
 function camp(cx,cz,col,i){const y=Hh(cx,cz);for(let k=0;k<3;k++){const a=k*2.1+i,x=cx+Math.cos(a)*7,z=cz+Math.sin(a)*7,t=new THREE.Mesh(tg,M(tcol[(i+k)%4]));t.position.set(x,Hh(x,z)+2.1,z);t.rotation.y=a;S.add(t)}
  const f=new THREE.Mesh(new THREE.ConeGeometry(1,1.6,6),M(0xff8a1f));f.position.set(cx,y+.8,cz);S.add(f);const g=new THREE.Group();g.position.set(cx,y,cz);flag(g,3,0,3,col);S.add(g)}
 castle(-480,-260,0x2e6fb0);castle(480,260,0xc0392b);
 for(let i=0;i<10;i++){const a=i/10*Math.PI*2+.3,r=290+(i%3)*35,x=Math.cos(a)*r,z=Math.sin(a)*r;if(Math.abs(z-riverZ(x))<50)continue;camp(x,z,i%2?0x2e6fb0:0xc0392b,i)}}
// savaşçı (KayKit manken + animasyon dosyaları)
let KN=null,clips=[],dbgT='';
try{$('load').textContent='Savaşçı yükleniyor...';const Ld=u=>gl.loadAsync('assets/knight/'+u);
 const [mm,a1,a2,a3]=await Promise.all([Ld('Mannequin_Medium.glb'),Ld('Rig_Medium_CombatMelee.glb'),Ld('Rig_Medium_General.glb'),Ld('Rig_Medium_MovementBasic.glb')]);
 clips=[...a1.animations,...a2.animations,...a3.animations];
 const f=mm.scene;f.updateMatrixWorld(true);const bb=new THREE.Box3().setFromObject(f),h=bb.max.y-bb.min.y;
 let tx=null;f.traverse(o=>{if(o.isMesh&&!tx&&o.material&&o.material.map)tx=o.material.map});f.userData.map=tx;
 // kılıç: sağ ele (hand.r) bağlanır. Yönü: SWORD_DIR (elin yerel ekseni; ileri-yukarı)
 let hb=null;f.traverse(o=>{if(o.isBone&&o.name.replace(/[._\s]/g,'')==='handr')hb=o});
 if(hb){
  const sw=new THREE.Group(),steel=new THREE.MeshToonMaterial({color:0xe8eef4}),gold=new THREE.MeshToonMaterial({color:0xe6b94d}),leather=new THREE.MeshToonMaterial({color:0x5b2f1d});
  const blade=new THREE.Mesh(new THREE.CylinderGeometry(.055,.11,1.18,4).translate(0,.93,0),steel);
  const tip=new THREE.Mesh(new THREE.ConeGeometry(.11,.28,4).translate(0,1.66,0),steel);
  const guard=new THREE.Mesh(new THREE.BoxGeometry(.46,.09,.09).translate(0,.29,0),gold);
  const grip=new THREE.Mesh(new THREE.CylinderGeometry(.055,.055,.29,8).translate(0,.1,0),leather);
  const pommel=new THREE.Mesh(new THREE.SphereGeometry(.09,10,8).translate(0,-.07,0),gold);
  for(const part of[blade,tip,guard,grip,pommel]){part.userData.noTint=true;sw.add(part)}
  sw.name='sword';const SWORD_DIR=new THREE.Vector3(-1,-.6,0).normalize();sw.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),SWORD_DIR);
  const ws=new THREE.Vector3();hb.getWorldScale(ws);sw.scale.setScalar(1/(ws.x||1));hb.add(sw)}
 else window.show&&show('hand.r kemiği bulunamadı, kılıç eklenmedi');
  // ZIRH: parçalar modelin dinlenme (T-poz) koordinatlarında kurulur, sonra kemiklere bağlanır (animasyonla birlikte hareket eder)
 {const Bn=n=>{let r=null;f.traverse(o=>{if(o.isBone&&o.name.replace(/[._\s]/g,'')===n)r=o});return r};
  const STEEL=[.31,.12],DARK=[.19,.12],GOLD=[.82,.2],RED=[.94,.2],AM=new THREE.MeshToonMaterial({map:tx,side:THREE.DoubleSide});
  const add=(bone,parts)=>{if(!bone){window.show&&show('zırh kemiği bulunamadı');return}
   const gs=parts.map(([g,c,p,sc,r])=>{const n=g.attributes.position.count,a=new Float32Array(n*2);for(let i=0;i<n;i++){a[i*2]=c[0];a[i*2+1]=c[1]}g.setAttribute('uv',new THREE.BufferAttribute(a,2));
    if(sc)g.scale(sc[0],sc[1],sc[2]);if(r){g.rotateX(r[0]);g.rotateY(r[1]);g.rotateZ(r[2])}if(p)g.translate(p[0],p[1],p[2]);return g});
   const m=new THREE.Mesh(mergeGeometries(gs),AM);m.name='zirh';f.add(m);m.updateMatrixWorld(true);bone.attach(m)};
  const PI=Math.PI,Sph=(a,b,c,d,e)=>new THREE.SphereGeometry(1,18,12,a,b,c,d),Bx=(w,h,d)=>new THREE.BoxGeometry(w,h,d),Cy=(o)=>new THREE.CylinderGeometry(1,.88,1,18,1,o),To=(t)=>new THREE.TorusGeometry(1,t,6,20);
  // kask: önü açık kubbe + kırmızı tepelik + arka tüy
  add(Bn('head'),[[new THREE.SphereGeometry(1,20,14,PI/2+.45,PI*2-.9,0,PI*.62),STEEL,[0,1.72,.02],[.5,.56,.58]],[Bx(.08,.2,.95),RED,[0,2.3,-.02]],[Bx(.08,.34,.24),RED,[0,2.22,-.5]],[Bx(.06,.3,.06),GOLD,[0,1.55,.57]]]);
  // göğüs zırhı, altın kuşak, arma, pelerin
  add(Bn('chest'),[[Cy(true),STEEL,[0,.85,.02],[.41,.5,.33]],[To(.06).rotateX(PI/2),GOLD,[0,1.1,.02],[.41,1,.33]],[To(.06).rotateX(PI/2),GOLD,[0,.6,.02],[.4,1,.32]],[Bx(.2,.24,.05),RED,[0,.88,.35]],[Bx(.62,.95,.04),RED,[0,.6,-.36],null,[.12,0,0]]]);
  // omuzluklar
  for(const [n,sx] of [['upperarmr',-1],['upperarml',1]])add(Bn(n),[[new THREE.SphereGeometry(1,14,10,0,PI*2,0,PI*.55),STEEL,[sx*.3,1.2,0],[.27,.21,.27]],[To(.04).rotateX(PI/2),GOLD,[sx*.3,1.2,0],[.27,1,.27]]]);
  // kalkan (sol kol)
  add(Bn('lowerarml'),[[new THREE.CylinderGeometry(1,1,.07,22).rotateX(PI/2),RED,[.62,1.08,.2],[.4,.4,1]],[To(.05),GOLD,[.62,1.08,.24],[.4,.4,1]],[Sph(0,PI*2,0,PI).scale(.1,.1,.08),GOLD,[.62,1.08,.28]]]);
 }
 f.userData.k=KNIGHT_SCALE||(h>1e-4?KNIGHT_H/h:1);f.userData.y0=bb.min.y;KN=f;dbgT=`Savaşçı: boy=${h.toFixed(2)} animasyon=${clips.length}`}
catch(e){window.show&&show('Savaşçı yüklenemedi: '+e.message)}
const clip=n=>clips.find(c=>c.name===n);
const durOf=n=>(clip(n)||{duration:1.2}).duration,ATK_D=[durOf('Melee_1H_Attack_Slice_Horizontal'),durOf('Melee_1H_Attack_Chop')],HIT_T=ATK_D.map(d=>d*.42);
// ---- Animasyonlu toplu çizim (VAT): her kemik animasyonu önceden dokuya pişirilir, GPU 4000 askeri animasyonlu çizer ----
function bake(){
 const names=['Idle_A','Running_A','Melee_1H_Attack_Slice_Horizontal','Death_A','Melee_1H_Attack_Chop'],C=5,F=VF,TW=2048;
 const cl=names.map(n=>clip(n)||clip('Idle_A')||clips[0]);if(!cl[0])throw new Error('animasyon bulunamadı');
 const root=SU.clone(KN),meshes=[];root.traverse(o=>{if(o.isMesh)meshes.push(o)});
 let V=0;const off=[];for(const m of meshes){off.push(V);V+=m.geometry.attributes.position.count}
 if(!V||V>40000)throw new Error('vertex sayısı uygun değil: '+V);
 const ROWS=Math.ceil(V/TW),H=ROWS*F*C;if(H>R.capabilities.maxTextureSize)throw new Error('doku çok büyük');
 const P=new Float32Array(TW*H*4),N=new Float32Array(TW*H*4);
 // her mesh için ön hazırlık
 const pre=meshes.map(m=>{const g=m.geometry,pa=g.attributes.position,na=g.attributes.normal,n=pa.count,sk=!!(m.isSkinnedMesh&&m.skeleton&&g.attributes.skinIndex);
  const pos=new Float32Array(n*3),nor=new Float32Array(n*3),si=new Uint16Array(n*4),sw=new Float32Array(n*4);
  for(let v=0;v<n;v++){pos[v*3]=pa.getX(v);pos[v*3+1]=pa.getY(v);pos[v*3+2]=pa.getZ(v);if(na){nor[v*3]=na.getX(v);nor[v*3+1]=na.getY(v);nor[v*3+2]=na.getZ(v)}else nor[v*3+1]=1;
   if(sk){const a=g.attributes.skinIndex,b=g.attributes.skinWeight;si[v*4]=a.getX(v);si[v*4+1]=a.getY(v);si[v*4+2]=a.getZ(v);si[v*4+3]=a.getW(v);sw[v*4]=b.getX(v);sw[v*4+1]=b.getY(v);sw[v*4+2]=b.getZ(v);sw[v*4+3]=b.getW(v)}}
  return{n,sk,pos,nor,si,sw}});
 const mx=new THREE.AnimationMixer(root),M4=new THREE.Matrix4(),B4=new THREE.Matrix4();
 for(let c=0;c<C;c++){
  mx.stopAllAction();const act=mx.clipAction(cl[c]);if(c===3){act.setLoop(THREE.LoopOnce,1);act.clampWhenFinished=true}act.play();
  for(let f=0;f<F;f++){
   mx.setTime(cl[c].duration*(c===3?f/(F-1):f/F));root.updateMatrixWorld(true);
   meshes.forEach((m,mi)=>{const d=pre[mi];let ML;
    if(d.sk){const sk=m.skeleton;sk.update();const nb=sk.bones.length;ML=new Float32Array(nb*16);
     for(let j=0;j<nb;j++){M4.multiplyMatrices(m.matrixWorld,m.bindMatrixInverse);B4.fromArray(sk.boneMatrices,j*16);M4.multiply(B4).multiply(m.bindMatrix);M4.toArray(ML,j*16)}}
    else ML=Float32Array.from(m.matrixWorld.elements);
    for(let v=0;v<d.n;v++){const x=d.pos[v*3],y=d.pos[v*3+1],z=d.pos[v*3+2],nx=d.nor[v*3],ny=d.nor[v*3+1],nz=d.nor[v*3+2];
     let px=0,py=0,pz=0,qx=0,qy=0,qz=0;
     if(d.sk){let ws=d.sw[v*4]+d.sw[v*4+1]+d.sw[v*4+2]+d.sw[v*4+3];if(!(ws>0))ws=1;
      for(let k=0;k<4;k++){const w=d.sw[v*4+k]/ws;if(!w)continue;const o=d.si[v*4+k]*16,e=ML;
       px+=w*(e[o]*x+e[o+4]*y+e[o+8]*z+e[o+12]);py+=w*(e[o+1]*x+e[o+5]*y+e[o+9]*z+e[o+13]);pz+=w*(e[o+2]*x+e[o+6]*y+e[o+10]*z+e[o+14]);
       qx+=w*(e[o]*nx+e[o+4]*ny+e[o+8]*nz);qy+=w*(e[o+1]*nx+e[o+5]*ny+e[o+9]*nz);qz+=w*(e[o+2]*nx+e[o+6]*ny+e[o+10]*nz)}}
     else{const e=ML;px=e[0]*x+e[4]*y+e[8]*z+e[12];py=e[1]*x+e[5]*y+e[9]*z+e[13];pz=e[2]*x+e[6]*y+e[10]*z+e[14];qx=e[0]*nx+e[4]*ny+e[8]*nz;qy=e[1]*nx+e[5]*ny+e[9]*nz;qz=e[2]*nx+e[6]*ny+e[10]*nz}
     const ql=Math.hypot(qx,qy,qz)||1,g=off[mi]+v,ti=((((c*F+f)*ROWS)+(g/TW|0))*TW+g%TW)*4;
     P[ti]=px;P[ti+1]=py;P[ti+2]=pz;P[ti+3]=1;N[ti]=qx/ql;N[ti+1]=qy/ql;N[ti+2]=qz/ql;N[ti+3]=0}})}}
 // boy ölçümü (Idle, ilk kare) ve ölçekleme
 let mn=1e9,mxY=-1e9;for(let g=0;g<V;g++){const y=P[(((g/TW|0))*TW+g%TW)*4+1];mn=Math.min(mn,y);mxY=Math.max(mxY,y)}
 const hh=mxY-mn;if(!(hh>1e-6))throw new Error('model boyu ölçülemedi');
 const k=KNIGHT_SCALE||KNIGHT_H/hh;
 for(let tf=0;tf<C*F;tf++)for(let g=0;g<V;g++){const ti=((tf*ROWS+(g/TW|0))*TW+g%TW)*4;P[ti]=P[ti]*k;P[ti+1]=(P[ti+1]-mn)*k;P[ti+2]=P[ti+2]*k}
 KN.userData.k=k;KN.userData.y0=mn; // havuzdaki gerçek modeller de aynı boyda olsun
 // renkler (malzeme rengi x köşe rengi)
 const col=new Float32Array(V*3),vid=new Float32Array(V),uvs=new Float32Array(V*2),idx=[];
 meshes.forEach((m,mi)=>{const g=m.geometry,n=pre[mi].n,cc=g.attributes.color,mats=Array.isArray(m.material)?m.material:[m.material],vm=new Int16Array(n);
  if(Array.isArray(m.material)&&g.groups&&g.groups.length)for(const gr of g.groups){for(let i=gr.start;i<gr.start+gr.count;i++){const vi=g.index?g.index.getX(i):i;if(vi<n)vm[vi]=gr.materialIndex}}
  for(let v=0;v<n;v++){const mt=mats[vm[v]]||mats[0],bc=(mt&&mt.color)||new THREE.Color(1,1,1),q=off[mi]+v;
   col[q*3]=(cc?cc.getX(v):1)*bc.r;col[q*3+1]=(cc?cc.getY(v):1)*bc.g;col[q*3+2]=(cc?cc.getZ(v):1)*bc.b;vid[q]=q;const ua=g.attributes.uv;uvs[q*2]=ua?ua.getX(v):0;uvs[q*2+1]=ua?ua.getY(v):0}
  if(g.index){for(let i=0;i<g.index.count;i++)idx.push(g.index.getX(i)+off[mi])}else{for(let v=0;v<n;v++)idx.push(off[mi]+v)}});
 const geo=new THREE.BufferGeometry();
