  const sp=(K.ShiftLeft?130:38)*spdM,cp=Math.cos(P.pitch),u=(K.Space?1:0)-(K.KeyC?1:0);
  P.x+=(-Math.sin(P.yaw)*cp*f+Math.cos(P.yaw)*r)*sp*dt;P.z+=(-Math.cos(P.yaw)*cp*f-Math.sin(P.yaw)*r)*sp*dt;P.y+=(Math.sin(P.pitch)*f+u)*sp*dt;
  P.x=clamp(P.x,-W,W);P.z=clamp(P.z,-W,W);P.y=clamp(P.y,Math.max(Hh(P.x,P.z),-4)+1.5,700)}
 // asker doğurma
 let bud=40;while(bud>0&&Q.length){const q=Q[0],k=Math.min(q.n,bud,MAX-SO.length);if(k<=0)break;const a=q.a,rad=(6+Math.sqrt(a.coins)*.6)*Math.sqrt(SC);
   for(let i=0;i<k;i++){const t=Math.random()*6.28,d=Math.sqrt(Math.random())*rad,x=a.sx+Math.cos(t)*d,z=a.sz+Math.sin(t)*d,uid=++unitSeq,commander=!a.commanderUid;a.commanderUid=commander?uid:a.commanderUid;SO.push({uid,x,z,y:Hh(x,z),vy:0,air:false,fy:0,hp:commander?60:10,a,commander,cd:0,ang:0,st:0,rich:null,ph:Math.random(),held:false,pl:false,kills:0,swing:0,sw:-1,hit:false,alt:false,atkT:0,target:null,engagedBy:null})}
  q.n-=k;a.pending-=k;bud-=k;if(q.n<=0)Q.shift()}
 for(const a of A.values()){a.alive=0;a.mx=0;a.mz=0}
 const G=new Map();
 for(const s of SO){s.a.alive++;s.a.mx+=s.x;s.a.mz+=s.z;const k=(Math.floor(s.x/GRID)+400)*1000+Math.floor(s.z/GRID)+400;(G.get(k)||G.set(k,[]).get(k)).push(s)}
 const AR=[...A.values()];for(const a of AR)if(a.alive){a.cx=a.mx/a.alive;a.cz=a.mz/a.alive}
 // savaş yapay zekâsı: her asker, hedefi düşene kadar yalnızca tek düşmana odaklanır.
  for(const s of SO){s.st=0;if(s.hp<=0||s.held||s.pl){if(!s.pl)s.sw=-1;continue}s.cd-=dt;let best=null,bd=1e9;const gx=Math.floor(s.x/GRID)+400,gz=Math.floor(s.z/GRID)+400;
   if(s.target&&s.target.hp>0&&!s.target.dead&&!s.target.held&&s.target.a!==s.a&&(!s.target.engagedBy||s.target.engagedBy===s)){best=s.target;best.engagedBy=s;bd=Math.hypot(best.x-s.x,best.z-s.z)}else{if(s.target?.engagedBy===s)s.target.engagedBy=null;s.target=null;for(let i=-2;i<=2;i++)for(let j=-2;j<=2;j++){const c=G.get((gx+i)*1000+gz+j);if(c)for(const e of c){if(e.a===s.a||e.hp<=0||e.held||(e.engagedBy&&e.engagedBy!==s))continue;const d=Math.hypot(e.x-s.x,e.z-s.z);if(d<bd){bd=d;best=e}}}if(best){s.target=best;best.engagedBy=s}}
   if(best){const reach=REACH*(s.commander?1.35:1);if(s.sw>=0){s.sw+=dt;s.st=s.alt?4:2;s.ang=Math.atan2(best.x-s.x,best.z-s.z);const ai=s.alt?1:0;if(!s.hit&&s.sw>=HIT_T[ai]){s.hit=true;if(bd<reach*1.5)hurt(best,s,(s.commander?12:5)+Math.random()*3)}if(s.sw>=ATK_D[ai]){s.sw=-1;s.cd=.1+Math.random()*.25}}
    else if(bd>reach)mv(s,best.x,best.z,8*SC,dt);
   else{s.ang=Math.atan2(best.x-s.x,best.z-s.z);if(s.cd<=0){s.sw=0;s.hit=false;s.alt=Math.random()<.5;s.atkT=gt;s.st=s.alt?4:2}}}
  else{s.sw=-1;let t=null,td=1e9;for(const a of AR){if(a===s.a||!a.alive)continue;const d=Math.hypot(a.cx-s.x,a.cz-s.z);if(d<td){td=d;t=a}}if(t)mv(s,t.cx,t.cz,10*SC,dt)}
  s.x=clamp(s.x,-W+20,W-20);s.z=clamp(s.z,-W+20,W-20)}
 // Yakın askerler birbirinin içine girmeden saflar halinde ilerler.
 const SEP=.72*SC,SEP2=SEP*SEP;
 for(const s of SO){if(s.hp<=0||s.held||s.pl)continue;const gx=Math.floor(s.x/GRID)+400,gz=Math.floor(s.z/GRID)+400;let corrected=0;
  for(let i=-1;i<=1&&corrected<6;i++)for(let j=-1;j<=1&&corrected<6;j++){const cell=G.get((gx+i)*1000+gz+j);if(!cell)continue;
   for(const e of cell){if(e.uid<=s.uid||e.hp<=0||e.held||e.pl)continue;let dx=e.x-s.x,dz=e.z-s.z,d2=dx*dx+dz*dz;if(d2>=SEP2)continue;
    if(d2<.0001){const a=(s.uid*2.399963)%6.283;dx=Math.cos(a)*.01;dz=Math.sin(a)*.01;d2=.0001}
    const d=Math.sqrt(d2),push=(SEP-d)*.5,px=dx/d*push,pz=dz/d*push;s.x-=px;s.z-=pz;e.x+=px;e.z+=pz;corrected++}
  }}
 // ASKERE GİRİLMİŞSE: oyuncu kontrolü
