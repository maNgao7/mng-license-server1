applyBattleMap(currentMap);
const zone=i=>{for(const r of[110,150,70,190]){const a=i/6*Math.PI*2+.3,x=Math.cos(a)*r,z=Math.sin(a)*r;if(Math.abs(z-riverZ(x))>45)return[x,z]}return[Math.cos(i)*110,Math.sin(i)*110+120]};
const msg=t=>{const b=$('banner');b.innerHTML=t;b.style.opacity=1;clearTimeout(b.t);b.t=setTimeout(()=>b.style.opacity=0,2200)};
function addGift(raw, coins, avatarUrl = "", giftLabel = ""){
  const n = '@' + raw.replace(/^@/, ''), k = n.toLowerCase();
  let a = A.get(k);
  if(!a){
    const used = [...A.values()].map(x => x.z);
    const free = [0,1,2,3,4,5].filter(i => !used.includes(i));
    const zi = (free.length ? free : [0,1,2,3,4,5])[Math.random() * (free.length || 6) | 0];
    let [sx, sz] = zone(zi);
    const av = avatarUrl || `/api/avatar?user=${encodeURIComponent(n)}`;
    a = {
      name: n,
      z: zi,
      sx, sz,
      cx: sx, cz: sz,
      coins: 0,
      alive: 0,
      pending: 0,
      commanderUid: null,
      avatar: av,
      color: new THREE.Color().setHSL(Math.random(), 0.8, 0.5),
      el: document.createElement('div')
    };
    a.tint = a.color.clone().lerp(new THREE.Color(1,1,1), 0.5);
    a.dcol = a.tint.clone().multiplyScalar(0.55);
    a.el.className = 'lb';
    a.el.style.color = '#' + a.color.getHexString();
    a.el.innerHTML = `<img src="${av}" onerror="this.style.display='none'"><span>${n}</span>`;
    document.body.appendChild(a.el);
    A.set(k, a);
  } else if (avatarUrl && !a.avatar) {
    a.avatar = avatarUrl;
    a.el.innerHTML = `<img src="${avatarUrl}" onerror="this.style.display='none'"><span>${n}</span>`;
  }
  a.coins += coins;
  a.pending += coins;
  Q.push({ a, n: coins });

  const f = document.createElement('div');
  const av = a.avatar || `/api/avatar?user=${encodeURIComponent(n)}`;
  f.innerHTML = `<img src="${av}" style="width:20px;height:20px;border-radius:50%;object-fit:cover;"> <b>${n}</b> ${giftLabel ? '• ' + giftLabel : ''} • +${coins} asker`;
  const feed = $('feed');
  if (feed) {
    feed.insertBefore(f, feed.children[1] || null);
    while (feed.children.length > 7) feed.lastChild.remove();
  }
  msg(`🎁 YENİ HEDİYE!<br>${n.toUpperCase()}<br>+${coins} ASKER KATILDI!`);
}

const gift = (c, av = "", lbl = "") => addGift($('nm') ? $('nm').value.trim() || names[Math.random() * names.length | 0] : names[Math.random() * names.length | 0], c, av, lbl);
let hudOn = true;
if ($('b1')) $('b1').onclick = () => gift(100);
if ($('b2')) $('b2').onclick = () => gift(500);
