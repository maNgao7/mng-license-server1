// =====================================================================
// SAĞDA VE SOLDA NET GÖRÜNEN AYICIKLAR & ÖDÜL SERGİSİ (x = ±7.4, z = 0.9)
// Kolonların içinde DEĞİL, kolonların yanında net ve sevimli şekilde durur!
// =====================================================================
function createCuteBear(colorHex, bowColorHex) {
  const g = new THREE.Group();
  const mat = new THREE.MeshLambertMaterial({ color: colorHex });
  const innerMat = new THREE.MeshLambertMaterial({ color: 0xffe3d8 });
  const eyeMat = new THREE.MeshBasicMaterial({ color: 0x111111 });
  const bowMat = new THREE.MeshLambertMaterial({ color: bowColorHex });

  // Chubby Body
  const body = new THREE.Mesh(new THREE.SphereGeometry(0.38, 14, 14), mat);
  body.scale.set(1.0, 1.15, 0.9);
  g.add(body);

  // Big Cute Head
  const head = new THREE.Mesh(new THREE.SphereGeometry(0.32, 14, 14), mat);
  head.position.set(0, 0.48, 0.05);
  g.add(head);

  // Round Ears with Inner Color
  const earL = new THREE.Mesh(new THREE.SphereGeometry(0.12, 10, 10), mat);
  earL.position.set(-0.25, 0.74, 0.02);
  const innerEarL = new THREE.Mesh(new THREE.SphereGeometry(0.07, 8, 8), innerMat);
  innerEarL.position.set(-0.25, 0.74, 0.08);

  const earR = new THREE.Mesh(new THREE.SphereGeometry(0.12, 10, 10), mat);
  earR.position.set(0.25, 0.74, 0.02);
  const innerEarR = new THREE.Mesh(new THREE.SphereGeometry(0.07, 8, 8), innerMat);
  innerEarR.position.set(0.25, 0.74, 0.08);
  g.add(earL, innerEarL, earR, innerEarR);

  // Snout & Button Nose
  const snout = new THREE.Mesh(new THREE.SphereGeometry(0.13, 10, 10), innerMat);
  snout.position.set(0, 0.44, 0.28);
  snout.scale.set(1.2, 0.9, 0.8);
  const nose = new THREE.Mesh(new THREE.SphereGeometry(0.045, 8, 8), eyeMat);
  nose.position.set(0, 0.48, 0.38);
  g.add(snout, nose);

  // Big Shiny Eyes
  const eyeL = new THREE.Mesh(new THREE.SphereGeometry(0.045, 8, 8), eyeMat);
  eyeL.position.set(-0.11, 0.54, 0.3);
  const eyeR = new THREE.Mesh(new THREE.SphereGeometry(0.045, 8, 8), eyeMat);
  eyeR.position.set(0.11, 0.54, 0.3);
  g.add(eyeL, eyeR);

  // Festive Bow Tie
  const bowCenter = new THREE.Mesh(new THREE.SphereGeometry(0.06, 8, 8), bowMat);
  bowCenter.position.set(0, 0.22, 0.35);
  const bowL = new THREE.Mesh(new THREE.ConeGeometry(0.1, 0.16, 6), bowMat);
  bowL.rotation.z = Math.PI / 2;
  bowL.position.set(-0.1, 0.22, 0.35);
  const bowR = new THREE.Mesh(new THREE.ConeGeometry(0.1, 0.16, 6), bowMat);
  bowR.rotation.z = -Math.PI / 2;
  bowR.position.set(0.1, 0.22, 0.35);
  g.add(bowCenter, bowL, bowR);

  return g;
}

const plushieSideGroup = new THREE.Group();
boothGroup.add(plushieSideGroup);

// Left & Right Stand Tiers (x = -7.4 & x = +7.4, z = 0.9)
const plushieColorsL = [0x3a86ff, 0xff006e, 0x06d6a0];
const plushieColorsR = [0xffbe0b, 0x8338ec, 0xff5400];
const bowColors = [0xffeb3b, 0x00f2fe, 0xff0055];
const shelfYPositions = [-1.9, 0.4, 2.7];

shelfYPositions.forEach((sy, idx) => {
  // Left plushie stand
  const shelfL = new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.14, 0.9), new THREE.MeshLambertMaterial({ color: 0x3d2817 }));
  shelfL.position.set(-7.4, sy - 0.45, 0.9);
  plushieSideGroup.add(shelfL);

  const bearL = createCuteBear(plushieColorsL[idx], bowColors[idx]);
  bearL.position.set(-7.4, sy - 0.05, 0.9);
  bearL.rotation.y = 0.4;
  plushieSideGroup.add(bearL);

  // Right plushie stand
  const shelfR = new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.14, 0.9), new THREE.MeshLambertMaterial({ color: 0x3d2817 }));
  shelfR.position.set(7.4, sy - 0.45, 0.9);
  plushieSideGroup.add(shelfR);

  const bearR = createCuteBear(plushieColorsR[idx], bowColors[(idx + 1) % 3]);
  bearR.position.set(7.4, sy - 0.05, 0.9);
  bearR.rotation.y = -0.4;
  plushieSideGroup.add(bearR);
});

