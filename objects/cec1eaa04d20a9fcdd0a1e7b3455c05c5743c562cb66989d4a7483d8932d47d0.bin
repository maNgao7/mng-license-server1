          <option value="jam_gun" ${g.action === 'jam_gun' ? 'selected' : ''}>🔒 Tüfeği Kilitle (Sabotaj)</option>
          <option value="mud_splash" ${g.action === 'mud_splash' ? 'selected' : ''}>☕ Ekrana Çamur At!</option>
          <option value="rapid_fire" ${g.action === 'rapid_fire' ? 'selected' : ''}>⚡ Taramalı Silah</option>
        </select>
        ${durationHTML}
      </div>
    `;
    container.appendChild(card);
  });

  // Action Change Listener
  container.querySelectorAll('.catalog-action-select').forEach(sel => {
    sel.addEventListener('change', (e) => {
      const slotIdx = Number(e.target.getAttribute('data-slot'));
      if (CUSTOM_GIFT_SLOTS[slotIdx]) {
        CUSTOM_GIFT_SLOTS[slotIdx].action = e.target.value;
        saveSettings();
        renderCatalogDrawer();
        renderTestPanelButtons();
      }
    });
  });

  // Duration Change Listener (İki Yönlü Eşzamanlama)
  container.querySelectorAll('.gift-duration-select').forEach(sel => {
    sel.addEventListener('change', (e) => {
      const slotIdx = Number(e.target.getAttribute('data-slot'));
      const field = e.target.getAttribute('data-field') || 'jamDuration';
      const val = Number(e.target.value);
      if (CUSTOM_GIFT_SLOTS[slotIdx]) {
        CUSTOM_GIFT_SLOTS[slotIdx][field] = val;
        if (field === 'jamDuration') {
          jamDurationSetting = val;
          if (selectJamDuration) selectJamDuration.value = String(val);
          CUSTOM_GIFT_SLOTS.forEach(s => {
            if (s.action === 'jam_gun') s.jamDuration = val;
          });
        } else if (field === 'rapidDuration') {
          rapidDurationSetting = val;
          if (selectRapidDuration) selectRapidDuration.value = String(val);
          CUSTOM_GIFT_SLOTS.forEach(s => {
            if (s.action === 'rapid_fire') s.rapidDuration = val;
          });
        }
        saveSettings();
        renderCatalogDrawer();
        renderTestPanelButtons();
      }
    });
  });

  // Change Gift Button -> Open Picker Modal
  container.querySelectorAll('.btn-change-gift').forEach(btn => {
    btn.addEventListener('click', (e) => {
      activeSlotIndexForPicker = Number(e.target.getAttribute('data-slot'));
      openGiftPicker();
    });
  });
}

function openGiftPicker() {
  if (!giftPickerModal) return;
  giftPickerModal.classList.add('open');
  renderGiftPickerGrid(giftPickerSearch ? giftPickerSearch.value : '');
}

function closeGiftPicker() {
  if (!giftPickerModal) return;
  giftPickerModal.classList.remove('open');
}

if (btnPickerClose) btnPickerClose.addEventListener('click', closeGiftPicker);

if (giftPickerSearch) {
  giftPickerSearch.addEventListener('input', (e) => {
    renderGiftPickerGrid(e.target.value);
  });
}

if (giftPickerSort) {
  giftPickerSort.addEventListener('change', () => {
    renderGiftPickerGrid(giftPickerSearch ? giftPickerSearch.value : '');
  });
}

if (giftPickerChips) {
  giftPickerChips.querySelectorAll('.gift-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      giftPickerChips.querySelectorAll('.gift-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      selectedPickerChipRange = chip.getAttribute('data-range') || 'all';
      renderGiftPickerGrid(giftPickerSearch ? giftPickerSearch.value : '');
    });
  });
}

function renderGiftPickerGrid(filter = '') {
  if (!giftPickerGrid) return;
  giftPickerGrid.innerHTML = '';

  const q = normalizeTr(filter);
  const sortMode = giftPickerSort ? giftPickerSort.value : 'coins_asc';

  const list = fullGiftCatalog.length ? fullGiftCatalog : [
    { name: 'Rose', trName: 'Gül', file: 'Rose.png', coins: 1 },
    { name: 'Blue Bead', trName: 'Nazar Boncuğu', file: 'Blue_Bead.png', coins: 5 },
    { name: 'Roses', trName: 'Kırmızı Gül', file: 'Roses.png', coins: 500 },
    { name: 'Bouquet', trName: 'Çiçek Buketi', file: 'Bouquet.png', coins: 20 },
    { name: 'Perfume', trName: 'Parfüm', file: 'Perfume.png', coins: 20 },
    { name: 'Doughnut', trName: 'Donut', file: 'Doughnut.png', coins: 30 },
    { name: 'Tea', trName: 'Çay', file: 'Tea.png', coins: 50 },
    { name: 'Heart Me', trName: 'Kalp', file: 'Heart_Me.png', coins: 1 },
    { name: 'Hat and Mustache', trName: 'Şapka & Bıyık', file: 'Hat_and_Mustache.png', coins: 99 }
  ];

  const enriched = list.map(g => {
    const tr = g.trName || getGiftTurkishName(g.name, g.file);
    const nName = normalizeTr(g.name);
    const nTr = normalizeTr(tr);
    const nFile = normalizeTr(g.file);
    const coins = Number(g.coins) || 1;
    return {
      name: g.name,
      trName: tr,
      file: g.file,
      coins,
      nName,
      nTr,
      nFile
    };
  });

  let filtered = enriched;

  // Filter by Coin Range Chip
  if (selectedPickerChipRange && selectedPickerChipRange !== 'all') {
    if (selectedPickerChipRange === '1-10') {
      filtered = filtered.filter(g => g.coins >= 1 && g.coins <= 10);
    } else if (selectedPickerChipRange === '11-99') {
      filtered = filtered.filter(g => g.coins >= 11 && g.coins <= 99);
    } else if (selectedPickerChipRange === '100-999') {
      filtered = filtered.filter(g => g.coins >= 100 && g.coins <= 999);
    } else if (selectedPickerChipRange === '1000+') {
      filtered = filtered.filter(g => g.coins >= 1000);
    }
  }

  // Filter by Search Query
  if (q) {
    const isParfQuery = q.startsWith('par') || q.includes('parfum');
    const isDonutQuery = q.startsWith('don') || q.includes('donut');
    const isNazarQuery = q.includes('nazar') || q.includes('boncuk');
    const isGulQuery = q.includes('gul') || q.includes('rose');
    const isKahveQuery = q.includes('kahve') || q.includes('coffee');
    const isSapkaQuery = q.includes('sapka') || q.includes('biyik') || q.includes('hat');
    const isParaQuery = q.includes('para') || q.includes('tabanca') || q.includes('money');

    filtered = filtered.filter(g => {
      if (isParfQuery && (g.nName.includes('perfume') || g.nFile.includes('perfume') || g.nTr.includes('parfum'))) return true;
      if (isDonutQuery && (g.nName.includes('doughnut') || g.nFile.includes('doughnut') || g.nTr.includes('donut'))) return true;
      if (isNazarQuery && (g.nName.includes('eye') || g.nFile.includes('eye') || g.nName.includes('nazar') || g.nTr.includes('nazar') || g.nName.includes('bead'))) return true;
      if (isGulQuery && (g.nName.includes('rose') || g.nFile.includes('rose') || g.nTr.includes('gul'))) return true;
      if (isKahveQuery && (g.nName.includes('coffee') || g.nFile.includes('coffee') || g.nTr.includes('kahve'))) return true;
      if (isSapkaQuery && (g.nName.includes('hat') || g.nFile.includes('hat') || g.nTr.includes('sapka'))) return true;
      if (isParaQuery && (g.nName.includes('money') || g.nFile.includes('money') || g.nTr.includes('para'))) return true;

      return g.nTr.includes(q) || g.nName.includes(q) || g.nFile.includes(q);
    });
  }

  // Sorting
  filtered.sort((a, b) => {
    if (q) {
      const aStarts = a.nTr.startsWith(q) || a.nName.startsWith(q);
      const bStarts = b.nTr.startsWith(q) || b.nName.startsWith(q);
      if (aStarts && !bStarts) return -1;
      if (!aStarts && bStarts) return 1;
    }

    if (sortMode === 'coins_asc') {
      return a.coins - b.coins;
    } else if (sortMode === 'coins_desc') {
      return b.coins - a.coins;
    } else if (sortMode === 'name_asc') {
      return (a.trName || a.name).localeCompare(b.trName || b.name, 'tr');
    }
    return 0;
  });

  const itemsToRender = filtered.slice(0, 300);

  if (itemsToRender.length === 0) {
    giftPickerGrid.innerHTML = `<div style="grid-column: 1 / -1; text-align:center; color:#a0aec0; padding:30px;">"${filter}" kriterine uygun hediye bulunamadı.</div>`;
    return;
  }

  itemsToRender.forEach(g => {
    const item = document.createElement('div');
    item.className = 'gift-picker-item';
    item.innerHTML = `
      <img class="gift-picker-img" src="/catalog-assets/gift-images/${g.file}" onerror="this.src='/catalog-assets/gift-images/Rose.png'" />
      <span class="gift-picker-name-tr">${g.trName || g.name}</span>
      <span class="gift-picker-coin-badge">🪙 ${g.coins}</span>
    `;

    item.addEventListener('click', () => {
      if (CUSTOM_GIFT_SLOTS[activeSlotIndexForPicker]) {
        CUSTOM_GIFT_SLOTS[activeSlotIndexForPicker].name = g.name;
        CUSTOM_GIFT_SLOTS[activeSlotIndexForPicker].trName = g.trName || g.name;
        CUSTOM_GIFT_SLOTS[activeSlotIndexForPicker].file = g.file;
        CUSTOM_GIFT_SLOTS[activeSlotIndexForPicker].coins = g.coins;
        saveSettings();
        renderCatalogDrawer();
        renderTestPanelButtons();
        closeGiftPicker();
      }
    });

    giftPickerGrid.appendChild(item);
  });
}

// Dynamically Render Test Panel Buttons (Hediye Görseli + Adı + Tetiklediği Görev Rozeti)
function renderTestPanelButtons() {
  if (!testGiftsGrid) return;
  testGiftsGrid.innerHTML = '';

  CUSTOM_GIFT_SLOTS.forEach((g) => {
    const actionLabel = getActionLabel(g.action, g.jamDuration || 3, g.mudDuration || 10, g.rapidDuration || 10);
    const btn = document.createElement('button');
    btn.className = 'test-btn test-gift-btn';
    btn.innerHTML = `
      <div class="test-gift-btn-left">
        <img src="/catalog-assets/gift-images/${g.file}" class="test-btn-img" onerror="this.src='/catalog-assets/gift-images/Rose.png'" />
        <span class="test-btn-name">${g.trName || g.name}</span>
      </div>
      <span class="test-btn-badge">${actionLabel}</span>
    `;
    btn.addEventListener('click', () => {
      ensureGameStarted();
      handleViewerInteraction({ nickname: `Test_${g.name}` }, 'gift', { giftName: g.name });
    });
    testGiftsGrid.appendChild(btn);
  });
}

renderCatalogDrawer();
renderTestPanelButtons();

// Viewer Interaction Dispatcher
function handleViewerInteraction(player, type = 'chat', data = {}) {
  const nick = player.nickname || player.uniqueId || 'İzleyici';
  const avatar = player.avatar || `/api/avatar?user=${encodeURIComponent(nick)}`;

  const key = nick.toLowerCase();
  if (!ACTIVE_VIEWERS.has(key)) {
    ACTIVE_VIEWERS.set(key, { nickname: nick, avatar, deathCount: 0, escapeCount: 0 });
  }

  // Find if duck is already on track
  const existingDuck = DUCKS.find(d => !d.hit && d.nickname.toLowerCase() === key);

  // Admission Gate (Kimler Oyuna Dahil Olsun?)
  if (!existingDuck) {
    if (viewerAdmissionMode === 'likes_only') {
      // Sadece en az 1 beğeni atanlar, hediyeler veya takipçiler piste dahil edilir
      if (type !== 'like' && type !== 'gift' && type !== 'follow') {
        return;
      }
    } else if (viewerAdmissionMode === 'gifts_only') {
      // Sadece hediye gönderenler piste dahil edilir
      if (type !== 'gift') {
        return;
      }
    } else if (viewerAdmissionMode === 'chat_only') {
      // Sadece sohbet edenler (yorum yapanlar & hediyeler & takipçiler) piste dahil edilir
      if (type !== 'chat' && type !== 'gift' && type !== 'follow') {
        return;
      }
    }
  }

  let chosenAction = null;
  let matchedSlot = null;
  let customJamSec = jamDurationSetting;
  let customMudSec = 10;
  let customRapidSec = rapidDurationSetting;

  if (type === 'gift') {
    const normalizeGiftName = value => String(value || '')
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .toLocaleLowerCase('tr-TR').replace(/[^a-z0-9]+/g, ' ').trim();
    const giftNameClean = normalizeGiftName(data.giftName);
    matchedSlot = CUSTOM_GIFT_SLOTS.find(g =>
      [g.name,g.trName,String(g.file||'').replace(/\.png$/i,'')]
        .some(candidate => normalizeGiftName(candidate) === giftNameClean)
    );
    if (matchedSlot) {
      chosenAction = matchedSlot.action;
      if (matchedSlot.jamDuration) customJamSec = matchedSlot.jamDuration;
      if (matchedSlot.mudDuration) customMudSec = matchedSlot.mudDuration;
      if (matchedSlot.rapidDuration) customRapidSec = matchedSlot.rapidDuration;
    } else {
      chosenAction = 'speed_2x';
    }
  } else if (type === 'like') {
    chosenAction = likeActionSetting;
  } else if (type === 'follow') {
    chosenAction = followActionSetting;
  }

  // Execute Special Actions
  if (chosenAction === 'mud_splash') {
    triggerMudSplash(customMudSec, player, matchedSlot);
    showToast(player, `Ekrana Çamur Attı! ☕💦 (${customMudSec} sn)`);
    return;
  } else if (chosenAction === 'jam_gun') {
    triggerGunJam(customJamSec, nick);
    showToast(player, `Tüfeğinizi Kilitledi! 🔒 (${customJamSec} sn)`);
    return;
  } else if (chosenAction === 'rapid_fire') {
    triggerRapidFire(customRapidSec);
    showToast(player, `Taramalı Silah Kazandırdı! ⚡ (${customRapidSec} sn)`);
    return;
  }

  if (existingDuck) {
    let boostVal = 1.5;
    if (chosenAction === 'speed_1.2x') boostVal = 1.2;
    else if (chosenAction === 'speed_1.5x') boostVal = 1.5;
    else if (chosenAction === 'speed_2x') boostVal = 2.0;
    else if (chosenAction === 'speed_3x') boostVal = 3.0;
    else if (chosenAction === 'speed_5x') boostVal = 5.0;

    existingDuck.speedMultiplier = Math.min(6.5, existingDuck.speedMultiplier + boostVal);
    if (existingDuck.speedRingMat) existingDuck.speedRingMat.opacity = 0.9;
    showToast(player, `Kendini Hızlandırdı! ⚡ x${existingDuck.speedMultiplier.toFixed(1)}`);
  } else {
    // Spawn fresh duck
    const counts = [0, 1, 2].map(sIdx => DUCKS.filter(d => d.shelfIndex === sIdx && !d.hit).length);
    const minShelf = counts.indexOf(Math.min(...counts));

    let dType = 'normal';
    if (chosenAction === 'spawn_boss') dType = 'boss';
    else if (chosenAction === 'spawn_big') dType = 'big';
    else if (chosenAction === 'spawn_gold') dType = 'golden';

    const newDuck = spawnDuck(minShelf, { nickname: nick, avatar }, dType);
    if (chosenAction && chosenAction.startsWith('speed_')) {
      const mult = parseFloat(chosenAction.replace('speed_', '').replace('x', '')) || 2.0;
      newDuck.speedMultiplier = mult;
      if (newDuck.speedRingMat) newDuck.speedRingMat.opacity = 0.9;
    }
    showToast(player, `Piste Girdi! (${dType === 'boss' ? '👑 Dev Boss' : dType === 'big' ? '🐻 Büyük Ördek' : '🦆 Hızlı Ördek'})`);
  }
}

function showToast(player, message) {
  if (!toastContainer) return;
  // Sağ tarafta en fazla 4 bildirim gösterilir, taşma ve ekranı kaplama engellenir
  while (toastContainer.children.length >= 4) {
    toastContainer.removeChild(toastContainer.firstElementChild);
  }
  const toast = document.createElement('div');
  toast.className = 'gift-toast';
  toast.innerHTML = `
    <img class="toast-avatar" src="${player.avatar || '/api/avatar?user=' + encodeURIComponent(player.nickname)}" onerror="this.src='/api/avatar?user=${encodeURIComponent(player.nickname)}'" />
    <div class="toast-info">
      <div class="toast-user">@${player.nickname}</div>
      <div class="toast-msg">${message}</div>
    </div>
  `;
  toastContainer.appendChild(toast);
  setTimeout(() => toast.remove(), 3200);
}

// =====================================================================
// WEBSOCKET & TIKTOK INTEGRATION
// =====================================================================
let ws = null;

function connectWS() {
  const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
  ws = new WebSocket(`${protocol}//${window.location.host}`);

  ws.onopen = () => {
    statusDot.className = 'status-dot test';
  };

  ws.onmessage = (event) => {
    let msg;
    try { msg = JSON.parse(event.data); } catch { return; }

    if (msg.type === 'status') {
      if (msg.state === 'connected') {
        connectedStreamer = msg.activeUsername || '';
        statusDot.className = 'status-dot connected';
        btnQuickConnect.classList.add('connected');
        btnQuickConnect.textContent = '🟢 Yayında';
        btnTiktokConnect.classList.add('disconnect-btn');
        btnTiktokConnect.textContent = 'Bağlantıyı Kes';

        if (lobbyStatusText) {
          lobbyStatusText.className = 'lobby-status connected';
          lobbyStatusText.textContent = `🟢 @${connectedStreamer || 'Yayıncı'} Canlı Yayına Başarıyla Bağlandı!`;
        }
        if (btnLobbyConnect) {
          btnLobbyConnect.classList.add('connected');
          btnLobbyConnect.textContent = '🟢 Bağlandı';
        }

      } else if (msg.state === 'connecting') {
        statusDot.className = 'status-dot test';
        btnQuickConnect.textContent = 'Bağlanıyor...';
        if (lobbyStatusText) lobbyStatusText.textContent = 'Canlı yayına bağlanılıyor...';
      } else {
        connectedStreamer = '';
        statusDot.className = 'status-dot';
        btnQuickConnect.classList.remove('connected');
        btnQuickConnect.textContent = '🔴 Bağlan';
        btnTiktokConnect.classList.remove('disconnect-btn');
        btnTiktokConnect.textContent = 'Bağlan';
        if (lobbyStatusText) {
          lobbyStatusText.className = 'lobby-status';
          lobbyStatusText.textContent = 'Yayıncı kullanıcı adınızı girip bağlanın veya test modunda doğrudan başlayın.';
        }
        if (btnLobbyConnect) {
          btnLobbyConnect.classList.remove('connected');
          btnLobbyConnect.textContent = 'Yayına Bağlan';
        }
      }
    } else if (msg.type === 'duck-event') {
      handleViewerInteraction(msg.player, msg.event, msg);
    }
  };

  ws.onclose = () => {
    statusDot.className = 'status-dot';
    setTimeout(connectWS, 2000);
  };
}

connectWS();

function toggleConnect(username) {
  if (btnQuickConnect.classList.contains('connected')) {
    if (ws && ws.readyState === 1) ws.send(JSON.stringify({ type: 'disconnect' }));
  } else {
    const u = username.replace(/^@/, '').trim();
    if (u && ws && ws.readyState === 1) {
      ws.send(JSON.stringify({ type: 'connect', username: u }));
    }
  }
}

btnQuickConnect.addEventListener('click', () => {
  toggleConnect(quickTiktokInput.value || tiktokUserInput.value || lobbyUsernameInput.value);
});

btnTiktokConnect.addEventListener('click', () => {
  toggleConnect(tiktokUserInput.value || quickTiktokInput.value || lobbyUsernameInput.value);
});

if (btnLobbyConnect) {
  btnLobbyConnect.addEventListener('click', () => {
    toggleConnect(lobbyUsernameInput.value || quickTiktokInput.value);
  });
}

// =====================================================================
// LOBBY & OYUNA BAŞLA
// =====================================================================
if (btnLobbyStart) {
  btnLobbyStart.addEventListener('click', () => {
    initAudio();
    gameState = 'playing';
    roundActive = true;
    roundCompleted = false;
    isRoundPaused = false;
    if (btnRoundPause) {
      btnRoundPause.innerHTML = '⏸️';
      btnRoundPause.classList.remove('paused');
    }
    if (roundTimerEl) roundTimerEl.classList.remove('paused');
    lobbyModal.classList.remove('open');
    spawnInitialDucks();
    updateRoundTargetHUD();
  });
}

const btnDownloadGuide = document.getElementById('btn-download-guide');
if (btnDownloadGuide) {
  btnDownloadGuide.addEventListener('click', (e) => {
    e.stopPropagation();
  });
}

// =====================================================================
// CONTROLS & EVENT LISTENERS
// =====================================================================
window.addEventListener('mousemove', (e) => {
  crosshairEl.style.left = `${e.clientX}px`;
  crosshairEl.style.top = `${e.clientY}px`;

  mouseNDC.x = (e.clientX / window.innerWidth) * 2 - 1;
  mouseNDC.y = -(e.clientY / window.innerHeight) * 2 + 1;

  raycaster.setFromCamera(mouseNDC, camera);
  const planeZ = new THREE.Plane(new THREE.Vector3(0, 0, 1), -0.1);
  raycaster.ray.intersectPlane(planeZ, mouseWorldTarget);

  isAimingDuck = false;
  for (const d of DUCKS) {
    if (!d.hit && d.group.position.distanceTo(mouseWorldTarget) < 1.1) {
      isAimingDuck = true;
      break;
    }
  }

  if (isAimingDuck) crosshairEl.classList.add('aiming-duck');
  else crosshairEl.classList.remove('aiming-duck');
});

window.addEventListener('mousedown', (e) => {
  if (e.target.closest('.hud-interactive') || e.target.closest('.score-plaque') || e.target.closest('#settings-drawer') || e.target.closest('#leaderboard-modal') || e.target.closest('#round-complete-modal') || e.target.closest('#lobby-modal') || e.target.closest('#gift-picker-modal')) {
    return;
  }
  isMouseDown = true;
  shoot();

  if (isRapidFire && !rapidFireInterval) {
    rapidFireInterval = setInterval(() => {
      if (isMouseDown && isRapidFire) shoot();
    }, 85);
  }
});

window.addEventListener('mouseup', () => {
  isMouseDown = false;
  if (rapidFireInterval) {
    clearInterval(rapidFireInterval);
    rapidFireInterval = null;
  }
});

window.addEventListener('keydown', (e) => {
  if (e.key === 'r' || e.key === 'R') {
    startReload();
  } else if (e.key === 'p' || e.key === 'P') {
    togglePauseRound();
  } else if (e.key === 'Escape') {
    closeSettingsModal();
    leaderboardModal.classList.remove('open');
    roundCompleteModal.classList.remove('open');
    closeGiftPicker();
  }
});

btnReload.addEventListener('click', (e) => {
  e.stopPropagation();
  startReload();
});

// Drawer Tabs
document.querySelectorAll('.drawer-tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.drawer-tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.drawer-tab-content').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    const tabId = btn.getAttribute('data-tab');
    document.getElementById(tabId).classList.add('active');
  });
});

function openSettingsModal() {
  settingsDrawer.classList.add('open');
  if (settingsBackdrop) settingsBackdrop.classList.add('open');
}

function closeSettingsModal() {
  settingsDrawer.classList.remove('open');
  if (settingsBackdrop) settingsBackdrop.classList.remove('open');
}

btnSettings.addEventListener('click', () => {
  if (settingsDrawer.classList.contains('open')) closeSettingsModal();
  else openSettingsModal();
});
btnDrawerClose.addEventListener('click', closeSettingsModal);
if (settingsBackdrop) settingsBackdrop.addEventListener('click', closeSettingsModal);

// Pause / Resume Round Timer (Turu Duraklat / Devam Ettir)
function togglePauseRound() {
  if (gameState !== 'playing' || !roundActive) {
    ensureGameStarted();
  }
  isRoundPaused = !isRoundPaused;
  if (btnRoundPause) {
    btnRoundPause.innerHTML = isRoundPaused ? '▶️' : '⏸️';
    btnRoundPause.title = isRoundPaused ? 'Süreyi Devam Ettir (P)' : 'Süreyi Duraklat (P)';
    if (isRoundPaused) {
      btnRoundPause.classList.add('paused');
    } else {
      btnRoundPause.classList.remove('paused');
    }
  }
  if (roundTimerEl) {
    if (isRoundPaused) roundTimerEl.classList.add('paused');
    else roundTimerEl.classList.remove('paused');
  }
  showToast({ nickname: 'Oyun', avatar: '' }, isRoundPaused ? '⏸️ Süre duraklatıldı!' : '▶️ Süre devam ediyor!');
}

if (btnRoundPause) {
  btnRoundPause.addEventListener('click', (e) => {
    e.stopPropagation();
    e.preventDefault();
    togglePauseRound();
  });
  btnRoundPause.addEventListener('mousedown', (e) => {
    e.stopPropagation();
  });
}

btnLeaderboard.addEventListener('click', () => {
  renderLeaderboardModal();
  leaderboardModal.classList.toggle('open');
});
btnLeaderboardClose.addEventListener('click', () => leaderboardModal.classList.remove('open'));

btnTabSurvivors.addEventListener('click', () => {
  btnTabSurvivors.classList.add('active');
  btnTabVictims.classList.remove('active');
  currentLeadTab = 'survivors';
  renderLeaderboardModal();
});

btnTabVictims.addEventListener('click', () => {
  btnTabVictims.classList.add('active');
  btnTabSurvivors.classList.remove('active');
  currentLeadTab = 'victims';
  renderLeaderboardModal();
});

btnCompleteRestart.addEventListener('click', restartRound);
btnRestartRound.addEventListener('click', restartRound);

selectRoundTime.addEventListener('change', (e) => {
  roundDuration = Number(e.target.value);
  restartRound();
  saveSettings();
});

if (selectRoundTargetScore) {
  selectRoundTargetScore.addEventListener('change', (e) => {
    roundTargetScore = Number(e.target.value);
    updateRoundTargetHUD();
    saveSettings();
  });
}

if (selectJamDuration) {
  selectJamDuration.addEventListener('change', (e) => {
    jamDurationSetting = Number(e.target.value);
    CUSTOM_GIFT_SLOTS.forEach(s => {
      if (s.action === 'jam_gun') s.jamDuration = jamDurationSetting;
    });
    saveSettings();
    renderCatalogDrawer();
    renderTestPanelButtons();
  });
}

if (selectRapidDuration) {
  selectRapidDuration.addEventListener('change', (e) => {
    rapidDurationSetting = Number(e.target.value);
    CUSTOM_GIFT_SLOTS.forEach(s => {
      if (s.action === 'rapid_fire') s.rapidDuration = rapidDurationSetting;
    });
    saveSettings();
    renderCatalogDrawer();
    renderTestPanelButtons();
  });
}

if (selectLikeAction) {
  selectLikeAction.addEventListener('change', (e) => {
    likeActionSetting = e.target.value;
    saveSettings();
  });
}

if (selectFollowAction) {
  selectFollowAction.addEventListener('change', (e) => {
    followActionSetting = e.target.value;
    saveSettings();
  });
}

sliderSpeed.addEventListener('input', (e) => {
  gameSpeedMultiplier = parseFloat(e.target.value);
  saveSettings();
});

if (sliderMusic) {
  sliderMusic.addEventListener('input', (e) => {
    musicVolume = parseFloat(e.target.value);
    saveSettings();
    if (musicVolume > 0 && !musicInterval && soundEnabled) startCarnivalMusic();
  });
}

if (sliderSfx) {
  sliderSfx.addEventListener('input', (e) => {
    sfxVolume = parseFloat(e.target.value);
    saveSettings();
  });
}

btnSound.addEventListener('click', () => {
  soundEnabled = !soundEnabled;
  btnSound.textContent = soundEnabled ? '🔊' : '🔇';
  if (soundEnabled) startCarnivalMusic();
  else stopCarnivalMusic();
  saveSettings();
});

btnResetScore.addEventListener('click', () => {
  score = 0;
  totalHits = 0;
  totalShots = 0;
  currentStreak = 0;
  scoreDisplay.textContent = '0';
  accuracyDisplay.textContent = 'İsabet: %100';
  if (duckKillDisplay) duckKillDisplay.textContent = 'Vurulan: 0';
  ACTIVE_VIEWERS.clear();
  updateRoundTargetHUD();
});

// Special Test Panel Buttons (Her biri oyunu garantili başlatır ve testi anında uygular)
if (btnTestCoffee) btnTestCoffee.addEventListener('click', () => {
  ensureGameStarted();
  const coffeeSlot = CUSTOM_GIFT_SLOTS.find(s => s.action === 'mud_splash') || { name: 'Perfume', trName: 'Parfüm', file: 'Perfume.png' };
  const dur = (coffeeSlot && coffeeSlot.mudDuration) ? coffeeSlot.mudDuration : 10;
  triggerMudSplash(dur, { nickname: 'Sabotajci', avatar: '/api/avatar?user=Sabotajci' }, coffeeSlot);
});
if (btnTestRapid) btnTestRapid.addEventListener('click', () => {
  ensureGameStarted();
  const rapidSlot = CUSTOM_GIFT_SLOTS.find(s => s.action === 'rapid_fire');
  const dur = (rapidSlot && rapidSlot.rapidDuration) ? rapidSlot.rapidDuration : rapidDurationSetting;
  triggerRapidFire(dur);
});
if (btnTestSabotage) btnTestSabotage.addEventListener('click', () => {
  ensureGameStarted();
  const jamSlot = CUSTOM_GIFT_SLOTS.find(s => s.action === 'jam_gun');
  const dur = (jamSlot && jamSlot.jamDuration) ? jamSlot.jamDuration : jamDurationSetting;
  triggerGunJam(dur, 'Sabotajci');
});
if (btnTestBomb) btnTestBomb.addEventListener('click', () => { ensureGameStarted(); spawnDuck(Math.floor(Math.random() * 3), null, 'bomb'); });
if (btnTestBoss) btnTestBoss.addEventListener('click', () => { ensureGameStarted(); spawnDuck(0, { nickname: 'Mega_Boss' }, 'boss'); });
if (btnTestGold) btnTestGold.addEventListener('click', () => { ensureGameStarted(); spawnDuck(1, { nickname: 'Altin_Ordek' }, 'golden'); });
if (btnTestLike) btnTestLike.addEventListener('click', () => { ensureGameStarted(); handleViewerInteraction({ nickname: 'Begeni_Sever' }, 'like'); });
if (btnTestFollow) btnTestFollow.addEventListener('click', () => { ensureGameStarted(); handleViewerInteraction({ nickname: 'Yeni_Takipci' }, 'follow'); });
if (btnTestRandom) btnTestRandom.addEventListener('click', () => {
  ensureGameStarted();
  const names = ['Kral_Oyuncu', 'Ece_01', 'Can_Pro', 'Bahar_Deniz', 'Yildiz_Gamer', 'Selin_07', 'Can_Gamer'];
  const testNick = names[Math.floor(Math.random() * names.length)];
  const counts = [0, 1, 2].map(sIdx => DUCKS.filter(d => d.shelfIndex === sIdx && !d.hit).length);
  const minShelf = counts.indexOf(Math.min(...counts));
  spawnDuck(minShelf, { nickname: testNick }, 'normal');
  showToast({ nickname: testNick }, 'Piste Girdi! (🦆 Standart İzleyici)');
});

// Window Resize
window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

// =====================================================================
// MAIN ANIMATION LOOP
// =====================================================================
let lastTime = performance.now();
let autoSpawnTimer = 0;
let bombSpawnTimer = 0;
let secondTimer = 0;
let rainbowPuffTimer = 0;

function animate(time) {
  requestAnimationFrame(animate);

  const dt = Math.min((time - lastTime) / 1000, 0.1);
  lastTime = time;

  // Round Timer Countdown (Durdurulduğunda sayım durur)
  if (gameState === 'playing' && roundActive && !isRoundPaused && roundDuration > 0) {
    secondTimer += dt;
    if (secondTimer >= 1.0) {
      secondTimer -= 1.0;
      roundTimeLeft = Math.max(0, roundTimeLeft - 1);
      const mins = Math.floor(roundTimeLeft / 60);
      const secs = roundTimeLeft % 60;
      roundTimerEl.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
      if (roundTimeLeft <= 0) {
        completeRound(false);
      }
    }
  }

  // Mud Splash Countdown (Canlı Geri Sayım Rozeti Güncellemesi)
  if (isMudActive) {
    mudTimer -= dt;
    const mudCountEl = document.getElementById('mud-countdown-text');
    if (mudCountEl) {
      mudCountEl.textContent = `${Math.max(0, mudTimer).toFixed(1)} sn`;
    }
    if (mudTimer <= 0) {
      clearMudSplash();
    }
  }

  // Gun Jam Countdown (Centered Screen Banner Realtime Update)
  if (isGunJammed) {
    gunJamTimer -= dt;
    if (jamSub) {
      const remaining = Math.max(0, gunJamTimer).toFixed(1);
      jamSub.textContent = currentJamSource ? `@${currentJamSource} tüfeğinizi kilitledi! (${remaining} sn)` : `Tüfek kilitlendi! (${remaining} sn)`;
    }
    if (gunJamTimer <= 0) {
      isGunJammed = false;
      currentJamSource = '';
      jamBanner.classList.remove('visible');
      crosshairEl.classList.remove('jammed');
    }
  }

  // Rapid Fire Countdown
  if (isRapidFire) {
    rapidFireTimer -= dt;
    if (rapidSub) rapidSub.textContent = `Süre: ${Math.max(0, rapidFireTimer).toFixed(1)} sn`;
    if (rapidFireTimer <= 0) {
      stopRapidFire();
    }
  }

  // Animate chain conveyors (Süre dursa dahi konveyörler hareket etmeye devam eder)
  if (gameState === 'playing') {
    conveyorMeshes.forEach(c => {
      c.mesh.material.map.offset.x -= c.direction * dt * 0.4 * gameSpeedMultiplier;
    });
  }

  // Ambient Duck & Bomb Spawning (autoSpawnEnabled false iken devre dışıdır)
  if (gameState === 'playing' && autoSpawnEnabled && roundActive) {
    autoSpawnTimer += dt;
    if (autoSpawnTimer > 2.8 / gameSpeedMultiplier) {
      autoSpawnTimer = 0;
      const sIdx = Math.floor(Math.random() * 3);
      const onShelf = DUCKS.filter(d => d.shelfIndex === sIdx && !d.hit).length;
      if (onShelf < 5) {
        const rand = Math.random();
        const type = rand > 0.88 ? 'golden' : rand > 0.96 ? 'big' : 'normal';
        spawnDuck(sIdx, null, type);
      }
    }

    bombSpawnTimer += dt;
    if (bombSpawnTimer > 15.0 / gameSpeedMultiplier) {
      bombSpawnTimer = 0;
      const sIdx = Math.floor(Math.random() * 3);
      spawnDuck(sIdx, null, 'bomb');
    }
  }

  // Rainbow Puffs Spawning for Boosted Ducks
  rainbowPuffTimer += dt;
  const shouldEmitRainbow = rainbowPuffTimer > 0.08;
  if (shouldEmitRainbow) rainbowPuffTimer = 0;

  // Update Ducks & Bombs (Süre dursa dahi ördekler yüzmeye ve akmaya devam eder)
  const BOUND_X = (ARENA_WIDTH / 2) + 0.6;
  for (let i = DUCKS.length - 1; i >= 0; i--) {
    const d = DUCKS[i];

    if (gameState === 'playing') {
      d.group.position.x += d.direction * d.baseSpeed * d.speedMultiplier * dt * gameSpeedMultiplier;

      // EMIT RAINBOW PUFFS from bottom / rear if boosted!
      if (!d.hit && d.speedMultiplier > 1.05 && shouldEmitRainbow) {
        emitRainbowPuff(d.group.position, d.direction);
      }
    }

    // Bobbing & Waddle
    if (!d.hit) {
      d.hingePivot.rotation.z = Math.sin(time * 0.008 + d.wobblePhase) * 0.07;
      d.hingePivot.position.y = 0.06 + Math.abs(Math.sin(time * 0.008 + d.wobblePhase)) * 0.03;
    } else {
      d.tipVelocity -= 36.0 * dt;
      d.tipAngle += d.tipVelocity * dt;
      if (d.tipAngle < -Math.PI / 2) {
        d.tipAngle = -Math.PI / 2;
        d.tipVelocity = -d.tipVelocity * 0.25;
      }
      d.hingePivot.rotation.x = d.tipAngle;
      d.hingePivot.rotation.z = 0;
    }

    // Boundary Wrap / Despawn
    if ((d.direction === 1 && d.group.position.x > BOUND_X) || (d.direction === -1 && d.group.position.x < -BOUND_X)) {
      if (d.hit || d.duckType === 'bomb') {
        scene.remove(d.group);
        DUCKS.splice(i, 1);
      } else {
        if (!d.hasEscaped) {
          d.hasEscaped = true;
          recordViewerEscape(d.nickname, d.avatarUrl);
        }
        d.group.position.x = d.direction === 1 ? -BOUND_X : BOUND_X;
        d.hasEscaped = false;
      }
    }
  }

  // Update Rainbow Particles
  for (let i = rainbowParticles.length - 1; i >= 0; i--) {
    const rp = rainbowParticles[i];
    rp.life -= rp.decay * dt;
    if (rp.life <= 0) {
      scene.remove(rp.mesh);
      rainbowParticles.splice(i, 1);
      continue;
    }
    rp.mesh.position.x += rp.velX * dt;
    rp.mesh.position.y += rp.velY * dt;
    rp.scale += dt * 1.2;
    rp.mesh.scale.set(rp.scale, rp.scale, 1);
    rp.mesh.material.opacity = rp.life * 0.85;
  }

  // Update Hit Confetti Particles
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.life -= p.decay * dt;
    if (p.life <= 0) {
      scene.remove(p.mesh);
      particles.splice(i, 1);
      continue;
    }
    p.vel.y -= 9.8 * dt;
    p.mesh.position.addScaledVector(p.vel, dt);
    p.mesh.rotation.z += p.rotSpeed * dt;
    p.mesh.material.opacity = p.life;
  }

  // Update Corks
  for (let i = activeCorks.length - 1; i >= 0; i--) {
    const c = activeCorks[i];
    const step = c.vel.clone().multiplyScalar(dt);
    c.pos.add(step);
    c.traveled += step.length();
    if (c.traveled >= c.targetDist || c.pos.z < -2) {
      scene.remove(c.mesh);
      activeCorks.splice(i, 1);
    }
  }

  // Gun Aiming & Recoil
  gunRecoilZ = THREE.MathUtils.lerp(gunRecoilZ, 0, dt * 14.0);
  gunRecoilRotX = THREE.MathUtils.lerp(gunRecoilRotX, 0, dt * 14.0);
  gunGroup.position.set(gunBasePos.x, gunBasePos.y, gunBasePos.z + gunRecoilZ);
  gunGroup.lookAt(mouseWorldTarget);
  gunGroup.rotation.x -= gunRecoilRotX;

  renderer.render(scene, camera);
}

requestAnimationFrame(animate);
