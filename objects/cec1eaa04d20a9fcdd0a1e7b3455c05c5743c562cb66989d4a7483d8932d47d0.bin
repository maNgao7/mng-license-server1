          <option value="speed_1.5x" ${g.action === 'speed_1.5x' ? 'selected' : ''}>⚡ Hızlandır (1.5x) [300 Puan]</option>
          <option value="speed_2x" ${g.action === 'speed_2x' ? 'selected' : ''}>⚡ Hızlandır (2x) [350 Puan]</option>
