// GÖSTERİŞLİ TIKTOK & KARNAVALI MARQUEE TABELALARI (Solda TikTok, Sağda Karnavalı)
function createCarnivalMarquee(text, theme = 'tiktok') {
  const c = document.createElement('canvas');
  c.width = 1200;
  c.height = 200;
  const ctx = c.getContext('2d');
  const w = c.width;
  const h = c.height;
  const radius = 24;

  // Tabela Gövdesi ve Kesim Maskesi
  ctx.save();
  ctx.beginPath();
  if (typeof ctx.roundRect === 'function') {
    ctx.roundRect(10, 10, w - 20, h - 20, radius);
  } else {
    ctx.rect(10, 10, w - 20, h - 20);
  }
  ctx.closePath();
  ctx.clip();

  // Gösterişli Kadife Arka Plan
  const bgGrad = ctx.createLinearGradient(0, 0, 0, h);
  if (theme === 'tiktok') {
    bgGrad.addColorStop(0, '#160515');
    bgGrad.addColorStop(0.5, '#0b020c');
    bgGrad.addColorStop(1, '#1b0416');
  } else {
    bgGrad.addColorStop(0, '#1c0800');
    bgGrad.addColorStop(0.5, '#0a0200');
    bgGrad.addColorStop(1, '#240a00');
  }
  ctx.fillStyle = bgGrad;
  ctx.fillRect(0, 0, w, h);

  // İnce Karnaval Çizgi Dokusu
  ctx.fillStyle = 'rgba(255, 255, 255, 0.035)';
  for (let x = 0; x < w; x += 36) {
    ctx.fillRect(x, 0, 18, h);
  }
  ctx.restore();

  // 3D Altın Varaklı Dış Çerçeve
  ctx.beginPath();
  if (typeof ctx.roundRect === 'function') {
    ctx.roundRect(10, 10, w - 20, h - 20, radius);
  } else {
    ctx.rect(10, 10, w - 20, h - 20);
  }
  ctx.strokeStyle = '#ffd700';
  ctx.lineWidth = 8;
  ctx.shadowColor = '#ffb700';
  ctx.shadowBlur = 15;
  ctx.stroke();

  // İç Neon Hat Çerçevesi
  ctx.beginPath();
  if (typeof ctx.roundRect === 'function') {
    ctx.roundRect(22, 22, w - 44, h - 44, radius - 6);
  } else {
    ctx.rect(22, 22, w - 44, h - 44);
  }
  ctx.strokeStyle = theme === 'tiktok' ? '#00f2fe' : '#ff0055';
  ctx.lineWidth = 3.5;
  ctx.shadowColor = theme === 'tiktok' ? '#00f2fe' : '#ff0055';
  ctx.shadowBlur = 12;
  ctx.stroke();

  ctx.shadowBlur = 0;

  // Işıltılı Karnaval Ampulleri (Marquee Light Bulbs)
  const bulbSpacing = 44;
  const bulbs = [];
  for (let x = 36; x <= w - 36; x += bulbSpacing) bulbs.push({ x, y: 16 });
  for (let x = 36; x <= w - 36; x += bulbSpacing) bulbs.push({ x, y: h - 16 });
  for (let y = 36; y <= h - 36; y += bulbSpacing) bulbs.push({ x: 16, y });
  for (let y = 36; y <= h - 36; y += bulbSpacing) bulbs.push({ x: w - 16, y });

  const colorsTiktok = ['#ffea00', '#00f2fe', '#fe2c55', '#ffffff'];
  const colorsCarnival = ['#ffd700', '#ff6d00', '#ff0055', '#ffffff'];
  const palette = theme === 'tiktok' ? colorsTiktok : colorsCarnival;

  bulbs.forEach((b, idx) => {
    const col = palette[idx % palette.length];
    const radG = ctx.createRadialGradient(b.x, b.y, 1, b.x, b.y, 13);
    radG.addColorStop(0, col);
    radG.addColorStop(0.45, col);
    radG.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = radG;
    ctx.beginPath();
    ctx.arc(b.x, b.y, 13, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.arc(b.x, b.y, 4, 0, Math.PI * 2);
    ctx.fill();
  });

  // Tipografi (Gösterişli Kalın Karnaval Yazısı)
  ctx.font = '900 104px "Lilita One", "Fredoka", sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';

  const textX = w / 2;
  const textY = h / 2 + 5;

  // 3D Gölgelendirme Katmanları
  for (let s = 10; s >= 1; s--) {
    ctx.fillStyle = theme === 'tiktok' ? '#040b14' : '#140300';
    ctx.fillText(text, textX, textY + s);
  }

  // Neon Parıltı ve Gradyan Renklendirme
  if (theme === 'tiktok') {
    ctx.shadowColor = '#00f2fe';
    ctx.shadowBlur = 28;
    ctx.fillStyle = '#00f2fe';
    ctx.fillText(text, textX - 4, textY);

    ctx.shadowColor = '#fe2c55';
    ctx.shadowBlur = 24;
    ctx.fillStyle = '#fe2c55';
    ctx.fillText(text, textX + 4, textY);

    const textGrad = ctx.createLinearGradient(0, textY - 50, 0, textY + 50);
    textGrad.addColorStop(0, '#ffffff');
    textGrad.addColorStop(0.45, '#e0f7fa');
    textGrad.addColorStop(0.7, '#80deea');
    textGrad.addColorStop(1, '#00e5ff');
    ctx.shadowColor = '#ffffff';
    ctx.shadowBlur = 14;
    ctx.fillStyle = textGrad;
    ctx.fillText(text, textX, textY);
  } else {
    ctx.shadowColor = '#ffd700';
    ctx.shadowBlur = 32;
    ctx.fillStyle = '#ff6d00';
    ctx.fillText(text, textX, textY + 2);

    const textGrad = ctx.createLinearGradient(0, textY - 50, 0, textY + 50);
    textGrad.addColorStop(0, '#ffffff');
    textGrad.addColorStop(0.3, '#fff9c4');
    textGrad.addColorStop(0.7, '#ffd700');
    textGrad.addColorStop(1, '#ff9100');
    ctx.shadowColor = '#ffd700';
    ctx.shadowBlur = 18;
    ctx.fillStyle = textGrad;
    ctx.fillText(text, textX, textY);
  }

  // Parlak Beyaz Kenarlık
  ctx.shadowBlur = 0;
  ctx.strokeStyle = 'rgba(255, 255, 255, 0.8)';
  ctx.lineWidth = 3.5;
  ctx.strokeText(text, textX, textY);

  const tex = new THREE.CanvasTexture(c);
  if (THREE.sRGBEncoding) tex.encoding = THREE.sRGBEncoding;
  return tex;
}

