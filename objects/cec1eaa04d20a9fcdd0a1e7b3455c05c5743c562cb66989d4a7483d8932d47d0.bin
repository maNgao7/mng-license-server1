function normalizeTr(str) {
  if (!str) return '';
  return String(str)
    .replace(/İ/g, 'i')
    .replace(/I/g, 'ı')
    .toLowerCase()
    .replace(/i̇/g, 'i')
    .replace(/ı/g, 'i')
    .replace(/ğ/g, 'g')
    .replace(/ü/g, 'u')
    .replace(/ş/g, 's')
    .replace(/ö/g, 'o')
    .replace(/ç/g, 'c')
    .replace(/[^a-z0-9]/g, '');
}

function getGiftTurkishName(enName, fileName = '') {
  if (!enName) return '';
  const key = enName.toLowerCase().trim();
  if (GIFT_TURKISH_MAP[key]) return GIFT_TURKISH_MAP[key];

  const fileKey = (fileName || '').replace(/\.png$/i, '').replace(/_/g, ' ').toLowerCase().trim();
  if (GIFT_TURKISH_MAP[fileKey]) return GIFT_TURKISH_MAP[fileKey];

  for (const [k, v] of Object.entries(GIFT_TURKISH_MAP)) {
    if (key.includes(k) || fileKey.includes(k)) return v;
  }
  return enName;
}

function getActionLabel(action, jamDuration = 3, mudDuration = 10, rapidDuration = 10) {
  switch (action) {
    case 'speed_1.2x': return '⚡ 1.2x Hızlandır';
    case 'speed_1.5x': return '⚡ 1.5x Hızlandır';
    case 'speed_2x': return '⚡ 2.0x Hızlandır';
    case 'speed_3x': return '🚀 3.0x Hızlandır';
    case 'speed_5x': return '🏎️ 5.0x Roket Hız';
    case 'spawn_gold': return '⭐ Altın Ördek';
    case 'spawn_big': return '🐻 Büyük Ördek (2 Can)';
    case 'spawn_boss': return '👑 Dev Boss (3 Can)';
    case 'jam_gun': return `🔒 Kilit (${jamDuration} sn)`;
    case 'mud_splash': return `☕ Çamur (${mudDuration} sn)`;
    case 'rapid_fire': return `⚡ Taramalı (${rapidDuration} sn)`;
    default: return '⚡ Hızlandır';
  }
}

function ensureGameStarted() {
  if (gameState !== 'playing') {
    initAudio();
    gameState = 'playing';
    roundActive = true;
    roundCompleted = false;
    isRoundPaused = false;
    if (btnRoundPause) {
      btnRoundPause.innerHTML = '⏸️';
      btnRoundPause.classList.remove('paused');
    }
    if (roundTimerEl) roundTimerEl.classList.remove('paused');
    if (lobbyModal) lobbyModal.classList.remove('open');
    spawnInitialDucks();
    updateRoundTargetHUD();
  }
}

