});

// =====================================================================
// DUCK & BOMB MODEL GENERATOR
// İsimler ve Avatarlar Tamamen Önde (z = 0.38) & Yüksek Çözünürlüklü
// =====================================================================
const DUCKS = [];
const duckTextureCache = new Map();

function createAvatarTexture(nickname, avatarUrl, isGold = false) {
  const cacheKey = `${nickname}_${isGold}`;
  if (duckTextureCache.has(cacheKey)) return duckTextureCache.get(cacheKey);

  const c = document.createElement('canvas');
  c.width = 256;
  c.height = 256;
  const ctx = c.getContext('2d');
  ctx.imageSmoothingEnabled = true;
  ctx.imageSmoothingQuality = 'high';

  ctx.save();
  ctx.beginPath();
  ctx.arc(128, 128, 120, 0, Math.PI * 2);
  ctx.clip();

  const grad = ctx.createLinearGradient(0, 0, 256, 256);
  if (isGold) {
    grad.addColorStop(0, '#ffe066');
    grad.addColorStop(0.5, '#f59e0b');
    grad.addColorStop(1, '#b45309');
  } else {
    let hash = 0;
    for (let i = 0; i < nickname.length; i++) hash = nickname.charCodeAt(i) + ((hash << 5) - hash);
    const hues = [210, 260, 320, 160, 35, 185];
    const h = hues[Math.abs(hash) % hues.length];
    grad.addColorStop(0, `hsl(${h}, 90%, 60%)`);
    grad.addColorStop(1, `hsl(${h + 30}, 85%, 35%)`);
  }
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, 256, 256);

  const initial = (nickname.replace(/^@/, '').charAt(0) || 'U').toUpperCase();
  ctx.fillStyle = '#ffffff';
  ctx.font = 'bold 120px "Fredoka", "Arial Black", sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.shadowColor = 'rgba(0, 0, 0, 0.45)';
  ctx.shadowBlur = 12;
  ctx.fillText(initial, 128, 134);
  ctx.restore();

  // Crisp glowing border ring
  ctx.save();
  ctx.beginPath();
  ctx.arc(128, 128, 118, 0, Math.PI * 2);
  ctx.lineWidth = 10;
  ctx.strokeStyle = isGold ? '#ffd700' : 'rgba(255, 255, 255, 0.9)';
  ctx.stroke();
  ctx.restore();

  const tex = new THREE.CanvasTexture(c);
  tex.generateMipmaps = true;
  tex.minFilter = THREE.LinearMipmapLinearFilter;
  tex.magFilter = THREE.LinearFilter;
  duckTextureCache.set(cacheKey, tex);

  if (avatarUrl) {
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = () => {
      ctx.clearRect(0, 0, 256, 256);
      ctx.save();
      ctx.beginPath();
      ctx.arc(128, 128, 120, 0, Math.PI * 2);
      ctx.clip();
      ctx.drawImage(img, 0, 0, 256, 256);
      ctx.restore();

      ctx.save();
      ctx.beginPath();
      ctx.arc(128, 128, 118, 0, Math.PI * 2);
      ctx.lineWidth = 10;
      ctx.strokeStyle = isGold ? '#ffd700' : 'rgba(255, 255, 255, 0.92)';
      ctx.stroke();
      ctx.restore();

      tex.needsUpdate = true;
    };
    img.src = avatarUrl;
  }

  return tex;
}

function createTextTag(text) {
  const c = document.createElement('canvas');
  c.width = 512;
  c.height = 112;
  const ctx = c.getContext('2d');
  ctx.imageSmoothingEnabled = true;
  ctx.imageSmoothingQuality = 'high';

  ctx.fillStyle = 'rgba(14, 18, 28, 0.94)';
  if (typeof ctx.roundRect === 'function') {
    ctx.beginPath();
    ctx.roundRect(10, 10, 492, 92, 46);
    ctx.fill();
  } else {
    ctx.beginPath();
    ctx.rect(10, 10, 492, 92);
    ctx.fill();
  }
  ctx.strokeStyle = '#ffcc00';
  ctx.lineWidth = 6;
  ctx.stroke();

  ctx.fillStyle = '#ffffff';
  ctx.font = 'bold 44px "Fredoka", sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  const displayNick = text.length > 15 ? text.substring(0, 14) + '..' : text;
  ctx.fillText(displayNick, 256, 58);

  const tex = new THREE.CanvasTexture(c);
  tex.generateMipmaps = true;
  tex.minFilter = THREE.LinearMipmapLinearFilter;
  const spriteMat = new THREE.SpriteMaterial({ map: tex, transparent: true, depthTest: false });
  const sprite = new THREE.Sprite(spriteMat);
  sprite.renderOrder = 100;
  sprite.scale.set(1.7, 0.42, 1);
  return sprite;
}

function createHealthTag(currentHP, maxHP) {
  const c = document.createElement('canvas');
  c.width = 160;
  c.height = 48;
  const ctx = c.getContext('2d');

  ctx.font = '26px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';

  let heartStr = '';
  for (let i = 0; i < maxHP; i++) {
    heartStr += i < currentHP ? '❤️' : '🖤';
  }
  ctx.fillText(heartStr, 80, 24);

  const tex = new THREE.CanvasTexture(c);
  const spriteMat = new THREE.SpriteMaterial({ map: tex, transparent: true, depthTest: false });
  const sprite = new THREE.Sprite(spriteMat);
  sprite.renderOrder = 101;
  sprite.scale.set(0.9, 0.28, 1);
  return { sprite, tex, canvas: c, ctx };
}

// Spawner: Duck or Bomb
function spawnDuck(shelfIndex = 0, sender = null, duckType = 'normal') {
  const shelf = SHELVES_CONFIG[shelfIndex];
  const isGold = duckType === 'golden';
  const isBig = duckType === 'big';
  const isBoss = duckType === 'boss';
  const isBomb = duckType === 'bomb';

  const defaultNicknames = ['Ahmet_TR', 'Selin_07', 'Can_Gamer', 'Ece_Yildiz', 'Kral_Avci', 'Bahar_Can', 'Emre_Pro', 'Deniz_Mavi'];
  const nick = isBomb ? 'BOMBA!' : (sender?.nickname || defaultNicknames[Math.floor(Math.random() * defaultNicknames.length)]);
  const avatarUrl = sender?.avatar || `/api/avatar?user=${encodeURIComponent(nick)}`;

  const maxHP = isBoss ? 3 : isBig ? 2 : 1;
  let currentHP = maxHP;

  const duckGroup = new THREE.Group();

  // Root Stand
  const stand = new THREE.Mesh(
    new THREE.BoxGeometry(0.7, 0.12, 0.45),
    new THREE.MeshLambertMaterial({ color: isBomb ? 0x222222 : 0x4a3b32 })
  );
  duckGroup.add(stand);

  // Hinge Pivot
  const hingePivot = new THREE.Group();
  hingePivot.position.set(0, 0.06, 0);
  duckGroup.add(hingePivot);

  const hingePin = new THREE.Mesh(
    new THREE.CylinderGeometry(0.04, 0.04, 0.5, 8),
    new THREE.MeshStandardMaterial({ color: 0xcccccc, metalness: 0.9 })
  );
  hingePin.rotation.z = Math.PI / 2;
  hingePivot.add(hingePin);

  let avatarDisc = null;
  let healthDisplay = null;
  let duckMat = null;

  if (isBomb) {
    // BOMBA MODELİ (Kıvılcımlı fitil)
    const bombMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, metalness: 0.8, roughness: 0.25 });
    const bombBody = new THREE.Mesh(new THREE.SphereGeometry(0.42, 16, 16), bombMat);
    bombBody.position.set(0, 0.48, 0);
    hingePivot.add(bombBody);

    const collar = new THREE.Mesh(
      new THREE.CylinderGeometry(0.12, 0.14, 0.12, 12),
      new THREE.MeshStandardMaterial({ color: 0xd4af37, metalness: 0.9 })
    );
    collar.position.set(0, 0.92, 0);
    hingePivot.add(collar);

    const fuse = new THREE.Mesh(
      new THREE.CylinderGeometry(0.03, 0.03, 0.2, 8),
      new THREE.MeshLambertMaterial({ color: 0xffffff })
    );
    fuse.position.set(0, 1.05, 0);
    hingePivot.add(fuse);

    const spark = new THREE.Mesh(
      new THREE.SphereGeometry(0.08, 8, 8),
      new THREE.MeshBasicMaterial({ color: 0xff7b00 })
    );
    spark.position.set(0, 1.15, 0);
    hingePivot.add(spark);

    const bombTag = createTextTag('💣 DİKKAT! BOMBA!');
    bombTag.position.set(0, 1.45, 0.38);
    hingePivot.add(bombTag);

  } else {
    // DUCK MODELİ (Yana Bakan & Can Barı)
    const duckModelGroup = new THREE.Group();
    const faceAngle = shelf.direction === 1 ? Math.PI * 0.42 : -Math.PI * 0.42;
    duckModelGroup.rotation.y = faceAngle;
    hingePivot.add(duckModelGroup);

    const duckBodyColor = isBoss ? 0xff0055 : isBig ? 0xff6b35 : isGold ? 0xffd700 : 0xffde59;
    duckMat = new THREE.MeshStandardMaterial({
      color: duckBodyColor,
      roughness: isGold ? 0.2 : 0.4,
      metalness: isGold ? 0.7 : 0.05
    });
    const beakMat = new THREE.MeshLambertMaterial({ color: 0xf77f00 });
    const eyeMat = new THREE.MeshBasicMaterial({ color: 0x111111 });
    const whiteMat = new THREE.MeshBasicMaterial({ color: 0xffffff });

    // Body
    const body = new THREE.Mesh(new THREE.SphereGeometry(0.38, 16, 16), duckMat);
    body.scale.set(1.0, 0.9, 1.3);
    body.position.set(0, 0.42, 0);
    body.castShadow = true;
    duckModelGroup.add(body);

    // Head
    const head = new THREE.Mesh(new THREE.SphereGeometry(0.28, 16, 16), duckMat);
    head.position.set(0, 0.85, 0.28);
    head.castShadow = true;
    duckModelGroup.add(head);

    // Beak
    const beak = new THREE.Mesh(new THREE.ConeGeometry(0.12, 0.26, 12), beakMat);
    beak.rotation.x = Math.PI / 2;
    beak.position.set(0, 0.82, 0.56);
    duckModelGroup.add(beak);

    // Eyes
    const eyeL = new THREE.Mesh(new THREE.SphereGeometry(0.045, 8, 8), eyeMat);
    eyeL.position.set(-0.11, 0.92, 0.48);
    const eyeR = new THREE.Mesh(new THREE.SphereGeometry(0.045, 8, 8), eyeMat);
    eyeR.position.set(0.11, 0.92, 0.48);
    const twL = new THREE.Mesh(new THREE.SphereGeometry(0.015, 6, 6), whiteMat);
    twL.position.set(-0.1, 0.93, 0.52);
    const twR = new THREE.Mesh(new THREE.SphereGeometry(0.015, 6, 6), whiteMat);
    twR.position.set(0.12, 0.93, 0.52);
    duckModelGroup.add(eyeL, eyeR, twL, twR);

    // Wings
    const wingL = new THREE.Mesh(new THREE.SphereGeometry(0.2, 12, 12), duckMat);
    wingL.scale.set(0.2, 0.6, 1.0);
    wingL.position.set(-0.38, 0.45, 0);
    const wingR = new THREE.Mesh(new THREE.SphereGeometry(0.2, 12, 12), duckMat);
    wingR.scale.set(0.2, 0.6, 1.0);
    wingR.position.set(0.38, 0.45, 0);
    duckModelGroup.add(wingL, wingR);

    // Tail Feather
    const tail = new THREE.Mesh(new THREE.ConeGeometry(0.1, 0.25, 8), duckMat);
    tail.rotation.x = -Math.PI / 3;
    tail.position.set(0, 0.58, -0.48);
    duckModelGroup.add(tail);

    // Floating Avatar & Username (Önde z = 0.38)
    const avatarTex = createAvatarTexture(nick, avatarUrl, isGold || isBoss);
    avatarDisc = new THREE.Mesh(
      new THREE.CircleGeometry(0.28, 24),
      new THREE.MeshBasicMaterial({ map: avatarTex, side: THREE.DoubleSide, depthTest: false })
    );
    avatarDisc.renderOrder = 95;

    const ring = new THREE.Mesh(
      new THREE.RingGeometry(0.27, 0.31, 24),
      new THREE.MeshBasicMaterial({
        color: isGold ? 0xffea00 : isBoss ? 0xff0055 : isBig ? 0xff7b00 : 0x00e676,
        side: THREE.DoubleSide
      })
    );
    ring.position.z = 0.005;
    avatarDisc.add(ring);

    avatarDisc.position.set(0, 1.08, 0.38);
    hingePivot.add(avatarDisc);

    // Floating Username Tag
    const tagSprite = createTextTag(nick);
    tagSprite.position.set(0, 1.48, 0.38);
    hingePivot.add(tagSprite);

    // HP Hearts for Big / Boss Duck
    if (maxHP > 1) {
      healthDisplay = createHealthTag(currentHP, maxHP);
      healthDisplay.sprite.position.set(0, 1.88, 0.38);
      hingePivot.add(healthDisplay.sprite);
    }

    // Crown for Boss Duck
    if (isBoss) {
      const crown = new THREE.Mesh(
        new THREE.CylinderGeometry(0.24, 0.18, 0.22, 5, 1, true),
        new THREE.MeshStandardMaterial({ color: 0xffd700, metalness: 0.9, roughness: 0.1, side: THREE.DoubleSide })
      );
      crown.position.set(0, 1.42, 0.15);
      hingePivot.add(crown);
      duckGroup.scale.set(1.65, 1.65, 1.65);
    } else if (isBig) {
      duckGroup.scale.set(1.35, 1.35, 1.35);
    } else if (isGold) {
      duckGroup.scale.set(1.15, 1.15, 1.15);
    }
  }

  // Speed Boost Aura Ring
  const speedRingMat = new THREE.MeshBasicMaterial({
    color: 0xff7b00,
    transparent: true,
    opacity: 0,
    side: THREE.DoubleSide
  });
  const speedRing = new THREE.Mesh(new THREE.RingGeometry(0.4, 0.55, 16), speedRingMat);
  speedRing.position.set(0, 0.45, 0);
  speedRing.rotation.x = Math.PI / 2;
  hingePivot.add(speedRing);

  // Initial Placement along conveyor
  const startX = shelf.direction === 1 ? -9.2 : 9.2;
  duckGroup.position.set(startX, shelf.y, 0.1);
  scene.add(duckGroup);

  const duckBaseSpeed = isBoss ? shelf.speed * 0.60 : isBig ? shelf.speed * 0.75 : shelf.speed;

  const duckData = {
    group: duckGroup,
    hingePivot,
    avatarDisc,
    speedRingMat,
    duckMat,
    shelfIndex,
    direction: shelf.direction,
    baseSpeed: duckBaseSpeed,
    speedMultiplier: 1.0,
    nickname: nick,
    userId: sender?.id || nick.toLowerCase(),
    avatarUrl,
    duckType,
    maxHP,
    currentHP,
    healthDisplay,
    hit: false,
    tipAngle: 0,
    tipVelocity: 0,
    wobblePhase: Math.random() * Math.PI * 2,
    hasEscaped: false
  };

  DUCKS.push(duckData);
  return duckData;
}

function spawnInitialDucks() {
  DUCKS.forEach(d => scene.remove(d.group));
  DUCKS.length = 0;
  // Test Paneli butonları veya canlı yayın hediyeleri gelene kadar piste otomatik ördek basılmaz
}

// =====================================================================
// GÖKKUŞAĞI İZİ PARTİKÜLLERİ (Popodan Çıkan Renkli Gökkuşağı İzi)
// Hızlanan veya yeni takipçi ördeklerin arkasından dökülen rengarenk iz
// =====================================================================
const rainbowParticles = [];
const RAINBOW_COLORS = [0xff0055, 0xff7b00, 0xffea00, 0x00e676, 0x00b4d8, 0x9d4edd];
let rainbowColorIdx = 0;

function emitRainbowPuff(pos, direction) {
  const pMat = new THREE.MeshBasicMaterial({
    color: RAINBOW_COLORS[rainbowColorIdx % RAINBOW_COLORS.length],
    transparent: true,
    opacity: 0.9,
    depthTest: false
  });
  rainbowColorIdx++;

  const pGeo = new THREE.CircleGeometry(0.12 + Math.random() * 0.08, 12);
  const mesh = new THREE.Mesh(pGeo, pMat);
  mesh.renderOrder = 90;

  // Position at the tail of the duck
  mesh.position.set(
    pos.x - direction * 0.45 + (Math.random() - 0.5) * 0.1,
    pos.y + 0.4 + (Math.random() - 0.5) * 0.1,
    0.25
  );
  scene.add(mesh);

  rainbowParticles.push({
    mesh,
    velX: -direction * (1.2 + Math.random() * 1.5),
    velY: (Math.random() - 0.2) * 0.8,
    scale: 1.0,
    life: 1.0,
    decay: 1.6 + Math.random() * 0.8
  });
}

// =====================================================================
// DETAYLI OYUNCAK KARNAVAL TÜFEĞİ (Custom 3D Poligon Modeli)
// Ergonomik ahşap dipçik, pirinç kurma kolu, manometre, namlu & mantar
// =====================================================================
const gunGroup = new THREE.Group();
scene.add(gunGroup);

const woodMat = new THREE.MeshStandardMaterial({ color: 0x78350f, roughness: 0.45 });
const darkMetalMat = new THREE.MeshStandardMaterial({ color: 0x1f2937, metalness: 0.85, roughness: 0.25 });
const brassMat = new THREE.MeshStandardMaterial({ color: 0xd97706, metalness: 0.9, roughness: 0.2 });
const cyanTrimMat = new THREE.MeshStandardMaterial({ color: 0x00b4d8, roughness: 0.3, metalness: 0.3 });
const corkMat = new THREE.MeshLambertMaterial({ color: 0xc19a6b });

// 1. Curved Wooden Stock (Ergonomik Ahşap Dipçik)
const stockShape = new THREE.Shape();
stockShape.moveTo(0, 0);
stockShape.lineTo(0.3, -0.4);
stockShape.lineTo(1.8, -0.2);
stockShape.lineTo(1.8, 0.35);
stockShape.lineTo(0.6, 0.4);
stockShape.lineTo(0, 0.2);
stockShape.closePath();

const stockExtrude = new THREE.ExtrudeGeometry(stockShape, { depth: 0.24, bevelEnabled: true, bevelThickness: 0.04, bevelSize: 0.04 });
const gunStock = new THREE.Mesh(stockExtrude, woodMat);
gunStock.rotation.y = -Math.PI / 2;
gunStock.position.set(0.12, -0.2, 0.2);
gunGroup.add(gunStock);

// Rubber Butt Plate (Siyah Omuz Tabanı)
const buttPlate = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.65, 0.08), darkMetalMat);
buttPlate.position.set(0, 0.05, 2.0);
gunGroup.add(buttPlate);

// 2. Metallic Receiver Housing (Pirinç/Çelik Mekanizma Gövdesi)
const gunReceiver = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.42, 1.4), darkMetalMat);
gunReceiver.position.set(0, 0.12, -0.5);
gunGroup.add(gunReceiver);

// Brass Cocking Lever & Ball (Pirinç Kurma Kolu)
const cockingRod = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 0.3, 8), brassMat);
cockingRod.rotation.z = Math.PI / 3;
cockingRod.position.set(0.2, 0.22, -0.3);
const cockingBall = new THREE.Mesh(new THREE.SphereGeometry(0.07, 10, 10), brassMat);
cockingBall.position.set(0.32, 0.28, -0.3);
gunGroup.add(cockingRod, cockingBall);

// Pressure Gauge Dial (Hava Manometresi)
const gaugeBezel = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, 0.06, 16), brassMat);
gaugeBezel.rotation.z = Math.PI / 2;
gaugeBezel.position.set(-0.16, 0.22, -0.5);
const gaugeFace = new THREE.Mesh(new THREE.CircleGeometry(0.1, 16), new THREE.MeshBasicMaterial({ color: 0xffffff }));
gaugeFace.rotation.y = -Math.PI / 2;
gaugeFace.position.set(-0.195, 0.22, -0.5);
gunGroup.add(gaugeBezel, gaugeFace);

// Brass Trigger Guard & Trigger
const triggerGuard = new THREE.Mesh(new THREE.TorusGeometry(0.14, 0.025, 8, 16, Math.PI), brassMat);
triggerGuard.rotation.x = Math.PI;
triggerGuard.position.set(0, -0.16, 0.1);
const trigger = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.14, 0.04), darkMetalMat);
trigger.rotation.x = -0.3;
trigger.position.set(0, -0.1, 0.1);
gunGroup.add(triggerGuard, trigger);

// 3. Dual-Tone Ribbed Barrel (Uzun Karnaval Namlusu)
const gunBarrel = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.1, 3.4, 16), cyanTrimMat);
gunBarrel.rotation.x = Math.PI / 2;
gunBarrel.position.set(0, 0.18, -2.6);
gunGroup.add(gunBarrel);

// Brass Barrel Retaining Bands
[-1.6, -2.6, -3.6].forEach(bz => {
  const band = new THREE.Mesh(new THREE.CylinderGeometry(0.11, 0.11, 0.08, 16), brassMat);
  band.rotation.x = Math.PI / 2;
  band.position.set(0, 0.18, bz);
  gunGroup.add(band);
});

// Front Bead Sight
const frontSight = new THREE.Mesh(new THREE.SphereGeometry(0.035, 8, 8), brassMat);
frontSight.position.set(0, 0.3, -4.1);
gunGroup.add(frontSight);

// 4. Realistic Cork Loaded in Muzzle & String (Mantar Mermisi & İp)
const loadedCork = new THREE.Mesh(new THREE.CylinderGeometry(0.085, 0.1, 0.35, 12), corkMat);
loadedCork.rotation.x = Math.PI / 2;
loadedCork.position.set(0, 0.18, -4.35);
gunGroup.add(loadedCork);

// Gun Base Position
const gunBasePos = new THREE.Vector3(2.1, -1.35, 9.2);
gunGroup.position.copy(gunBasePos);

let gunRecoilZ = 0;
let gunRecoilRotX = 0;
const mouseWorldTarget = new THREE.Vector3(0, 0, 0);

// Hit Particle Sparks
const particles = [];
const starShape = new THREE.Shape();
for (let i = 0; i < 5; i++) {
  const outer = 0.14;
  const inner = 0.06;
  const a1 = (i * 72 - 90) * (Math.PI / 180);
  const a2 = ((i * 72 + 36) - 90) * (Math.PI / 180);
  if (i === 0) starShape.moveTo(Math.cos(a1) * outer, Math.sin(a1) * outer);
  else starShape.lineTo(Math.cos(a1) * outer, Math.sin(a1) * outer);
  starShape.lineTo(Math.cos(a2) * inner, Math.sin(a2) * inner);
}
starShape.closePath();
const starGeo = new THREE.ShapeGeometry(starShape);

function createHitParticles(pos, isGold = false, isBoss = false, isBomb = false) {
  const count = isBomb ? 40 : isBoss ? 35 : isGold ? 22 : 14;
  const colors = isBomb
    ? [0xff1100, 0xff7b00, 0x333333, 0xffea00]
    : isBoss
      ? [0xff0055, 0xffea00, 0xffffff, 0x9d4edd]
      : isGold
        ? [0xffea00, 0xffd000, 0xffffff, 0xff9100]
        : [0xffde59, 0xf77f00, 0xffffff, 0x06d6a0];

  for (let i = 0; i < count; i++) {
    const mat = new THREE.MeshBasicMaterial({
      color: colors[i % colors.length],
      side: THREE.DoubleSide,
      transparent: true,
      opacity: 1
    });
    const p = new THREE.Mesh(starGeo, mat);
    p.position.copy(pos);
    p.position.x += (Math.random() - 0.5) * 0.4;
    p.position.y += (Math.random() - 0.5) * 0.4;

    const vel = new THREE.Vector3(
      (Math.random() - 0.5) * 7.0,
      Math.random() * 5.5 + 1.5,
      (Math.random() - 0.5) * 5.0
    );

    scene.add(p);
    particles.push({
      mesh: p,
      vel,
      rotSpeed: (Math.random() - 0.5) * 12.0,
      life: 1.0,
      decay: 1.2 + Math.random() * 0.8
    });
  }
}

// Active Flying Corks
const activeCorks = [];
const corkGeo = new THREE.CylinderGeometry(0.06, 0.08, 0.22, 12);

function shootCork(startPos, targetPos) {
  const cork = new THREE.Mesh(corkGeo, corkMat);
  cork.position.copy(startPos);
  const dir = targetPos.clone().sub(startPos).normalize();
  cork.lookAt(targetPos);
  scene.add(cork);

  activeCorks.push({
    mesh: cork,
    pos: cork.position,
    vel: dir.multiplyScalar(44.0),
    targetDist: startPos.distanceTo(targetPos),
    traveled: 0
  });
}

// =====================================================================
// DEVASA EKRANI KAPLAYAN AKIŞKAN ÇAMUR SIÇRAMASI & GERİ SAYIM ROZETİ
// Ekranın ~%85-90'ını kaplar, akışkan süzülen dereler ve ortada canlı süre gösterir
// =====================================================================
let isMudActive = false;
let mudTimer = 0;
let mudSplashTimeout = null;
let isClearingMud = false;

function clearMudSplash() {
  if (!isMudActive && !isClearingMud) return;
  isMudActive = false;
  isClearingMud = true;
  if (mudSplashTimeout) {
    clearTimeout(mudSplashTimeout);
    mudSplashTimeout = null;
  }
  const container = document.getElementById('mud-splat-container');
  if (container) {
    container.classList.add('slide-out');
  }
  setTimeout(() => {
    if (mudLayer) {
      mudLayer.classList.remove('active');
      mudLayer.innerHTML = '';
    }
    isClearingMud = false;
  }, 750);
}

function triggerMudSplash(durationSec = 10, sender = null, giftSlot = null) {
  playMudSplat();
  if (!mudLayer) return;

  const dur = Number(durationSec) || 10;
  isMudActive = true;
  isClearingMud = false;
  mudTimer = dur;

  if (mudSplashTimeout) clearTimeout(mudSplashTimeout);

  mudLayer.classList.add('active');

  const slot = giftSlot || CUSTOM_GIFT_SLOTS.find(s => s.action === 'mud_splash') || { name: 'Perfume', trName: 'Parfüm', file: 'Perfume.png' };
  const giftFile = slot.file || 'Perfume.png';
  const giftNameTr = slot.trName || slot.name || 'Parfüm';

  const senderNick = sender?.nickname || sender?.uniqueId || 'İzleyici';
  const senderAvatar = sender?.avatar || `/api/avatar?user=${encodeURIComponent(senderNick)}`;

  const giantMudHTML = `
    <div id="mud-splat-container" class="giant-mud-splat">
      <svg viewBox="0 0 1000 600" preserveAspectRatio="none" width="100%" height="100%" style="overflow:visible;">
        <defs>
          <radialGradient id="mudGradCenter" cx="50%" cy="35%" r="55%">
            <stop offset="0%" stop-color="#080301" stop-opacity="0.99"/>
            <stop offset="50%" stop-color="#140702" stop-opacity="0.99"/>
            <stop offset="85%" stop-color="#240c03" stop-opacity="0.98"/>
            <stop offset="100%" stop-color="#0b0401" stop-opacity="0.97"/>
          </radialGradient>
          <linearGradient id="mudDrip" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#180802" stop-opacity="0.99"/>
            <stop offset="60%" stop-color="#0e0401" stop-opacity="0.99"/>
            <stop offset="100%" stop-color="#050100" stop-opacity="0.98"/>
          </linearGradient>
          <filter id="mudGloss">
            <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="#000" flood-opacity="0.88"/>
          </filter>
        </defs>

        <!-- Ördek Parkurunun Üzerini Kaplayan Akışkan Çamur Kütlesi -->
        <path d="M -20,10 Q 250,-10 500,20 T 1020,10 L 1020,430 
                 Q 920,480 840,410 Q 750,530 660,430 Q 550,560 460,440 
                 Q 360,540 280,420 Q 180,510 80,410 Q 20,490 -20,430 Z" 
              fill="url(#mudGradCenter)" filter="url(#mudGloss)" />

        <!-- Aşağı Doğru Süzülen Akışkan Çamur Şeritleri -->
        <g class="mud-drip-flow">
          <path d="M 60,390 Q 75,540 68,610 Q 60,620 52,610 Q 46,540 54,390 Z" fill="url(#mudDrip)" />
          <path d="M 160,400 Q 180,550 172,640 Q 164,650 156,640 Q 148,550 152,400 Z" fill="url(#mudDrip)" />
          <path d="M 280,410 Q 305,570 296,660 Q 288,670 280,660 Q 270,570 274,410 Z" fill="url(#mudDrip)" />
          <path d="M 400,420 Q 425,580 416,680 Q 408,690 398,680 Q 390,580 394,420 Z" fill="url(#mudDrip)" />
          <path d="M 520,430 Q 545,590 536,690 Q 528,700 518,690 Q 510,590 514,430 Z" fill="url(#mudDrip)" />
          <path d="M 640,410 Q 665,570 656,660 Q 648,670 638,660 Q 630,570 634,410 Z" fill="url(#mudDrip)" />
          <path d="M 760,400 Q 785,550 776,640 Q 768,650 758,640 Q 750,550 754,400 Z" fill="url(#mudDrip)" />
          <path d="M 880,390 Q 900,530 892,600 Q 884,610 876,600 Q 870,530 874,390 Z" fill="url(#mudDrip)" />
          <path d="M 960,380 Q 975,500 968,570 Q 960,580 952,570 Q 946,500 952,380 Z" fill="url(#mudDrip)" />
        </g>

        <!-- Aşağı Süzülen Sıvı Damlalar -->
        <g class="mud-drops-falling">
          <circle cx="60" cy="635" r="14" fill="#080301" />
          <circle cx="164" cy="665" r="16" fill="#060200" />
          <circle cx="288" cy="685" r="18" fill="#050100" />
          <circle cx="408" cy="705" r="20" fill="#040100" />
          <circle cx="528" cy="715" r="20" fill="#040100" />
          <circle cx="648" cy="685" r="18" fill="#050100" />
          <circle cx="768" cy="665" r="16" fill="#060200" />
          <circle cx="884" cy="625" r="14" fill="#080301" />
        </g>
      </svg>

      <!-- Ortada Geri Sayan Canlı Çamur Rozeti (Kullanıcı & Hediye Bilgisi) -->
      <div class="mud-center-badge">
        <div class="mud-badge-icon">
          <div class="mud-badge-visual-pair">
            <img class="mud-badge-gift-img" src="/catalog-assets/gift-images/${giftFile}" onerror="this.src='/catalog-assets/gift-images/Perfume.png'" alt="${giftNameTr}" title="${giftNameTr}" />
            <img class="mud-badge-sender-avatar" src="${senderAvatar}" onerror="this.src='/api/avatar?user=${encodeURIComponent(senderNick)}'" alt="${senderNick}" title="@${senderNick}" />
          </div>
        </div>
        <div class="mud-badge-content">
          <div class="mud-badge-user-row">
            <span class="mud-badge-user">@${senderNick}</span>
            <span class="mud-badge-user-action">ekrana çamur attı!</span>
          </div>
          <div class="mud-badge-title">
            <span class="mud-badge-gift-name">${giftNameTr}</span> ile Görüş Kapatıldı!
          </div>
          <div class="mud-badge-sub">Kalan Süre: <span id="mud-countdown-text">${dur.toFixed(1)} sn</span></div>
        </div>
      </div>
    </div>
  `;

  mudLayer.innerHTML = giantMudHTML;

  mudSplashTimeout = setTimeout(() => {
    clearMudSplash();
  }, dur * 1000);
}

// Bomb Explosion Effect
function triggerBombExplosion(bombPos) {
  playBombExplosion();

  if (bombFlash) {
    bombFlash.classList.add('active');
    setTimeout(() => bombFlash.classList.remove('active'), 250);
  }

  canvas.classList.add('screen-shake');
  setTimeout(() => canvas.classList.remove('screen-shake'), 400);

  createHitParticles(bombPos, false, false, true);

  // -1000 Puan Cezası & Kombo Sıfırlama
  score = Math.max(0, score - 1000);
  currentStreak = 0;
  scoreDisplay.textContent = score.toLocaleString('tr-TR');
  scoreDisplay.classList.add('score-bump');
  setTimeout(() => scoreDisplay.classList.remove('score-bump'), 250);

  showFloatingScore(bombPos, '-1.000 PUAN! 💥', true);
  updateRoundTargetHUD();
}

// Rapid Fire Mechanic (Taramalı Silah)
function triggerRapidFire(durationSec = 10) {
  isRapidFire = true;
  rapidFireTimer = durationSec;
  crosshairEl.classList.add('rapid');
  rapidFireBanner.classList.add('visible');
  rapidSub.textContent = `Süre: ${durationSec} sn`;

  if (ammoStatusTag) {
    ammoStatusTag.textContent = '⚡ SINIRSIZ MERMİ';
    ammoStatusTag.style.color = '#ffea00';
  }
}

function stopRapidFire() {
  isRapidFire = false;
  crosshairEl.classList.remove('rapid');
  rapidFireBanner.classList.remove('visible');
  if (ammoStatusTag) {
    ammoStatusTag.textContent = 'OTOMATİK YENİLEME';
    ammoStatusTag.style.color = '#00e676';
  }
}

// =====================================================================
// SHOOTING, AUTO-RELOAD & DUCK HIT MECHANICS
// =====================================================================
const raycaster = new THREE.Raycaster();
const mouseNDC = new THREE.Vector2();

function updateAmmoHUD() {
  corkSlots.forEach((slot, index) => {
    if (index < currentAmmo) slot.classList.remove('spent');
    else slot.classList.add('spent');
  });

  if (currentAmmo <= 0) {
    ammoWarning.classList.add('active');
    btnReload.classList.add('flashing');
    crosshairEl.classList.add('empty-ammo');
  } else {
    ammoWarning.classList.remove('active');
    btnReload.classList.remove('flashing');
    crosshairEl.classList.remove('empty-ammo');
  }
}

function startReload() {
  if (isReloading || currentAmmo === maxAmmo) return;
  isReloading = true;
  btnReload.classList.add('flashing');

  setTimeout(() => {
    currentAmmo = maxAmmo;
    isReloading = false;
    updateAmmoHUD();
    btnReload.classList.remove('flashing');
  }, 750);
}

function triggerGunJam(durationSec = 3.0, sourceUser = '') {
  isGunJammed = true;
  gunJamTimer = Number(durationSec) || 3.0;
  currentJamSource = sourceUser;
  playJamSound();
  jamBanner.classList.add('visible');
  crosshairEl.classList.add('jammed');
  if (jamSub) {
    const durFormatted = gunJamTimer.toFixed(1);
    jamSub.textContent = sourceUser ? `@${sourceUser} tüfeğinizi kilitledi! (${durFormatted} sn)` : `Tüfek kilitlendi! (${durFormatted} sn)`;
  }
}

function shoot() {
  initAudio();

  if (gameState !== 'playing' || !roundActive) return;

  if (isGunJammed) {
    playJamSound();
    return;
  }

  if (isReloading && !isRapidFire) return;

  if (!isRapidFire) {
    if (currentAmmo <= 0) {
      startReload();
      return;
    }
    currentAmmo--;
    totalShots++;
    updateAmmoHUD();
  } else {
    totalShots++;
  }

  playCorkPop();

  gunRecoilZ = 0.42;
  gunRecoilRotX = 0.22;

  const muzzlePos = new THREE.Vector3(gunGroup.position.x - 0.35, gunGroup.position.y + 0.25, gunGroup.position.z - 4.1);
  shootCork(muzzlePos, mouseWorldTarget);

  let hitAny = false;
  for (let i = 0; i < DUCKS.length; i++) {
    const d = DUCKS[i];
    if (d.hit) continue;

    const duckPos = new THREE.Vector3();
    d.hingePivot.getWorldPosition(duckPos);
    const dist = duckPos.distanceTo(mouseWorldTarget);
    const hitRadius = d.duckType === 'boss' ? 1.4 : d.duckType === 'big' ? 1.05 : 0.85;

    if (dist < hitRadius) {
      hitAny = true;

      // Bomb Check
      if (d.duckType === 'bomb') {
        d.hit = true;
        scene.remove(d.group);
        DUCKS.splice(i, 1);
        triggerBombExplosion(duckPos);
        break;
      }

      d.currentHP--;

      if (d.currentHP > 0) {
        // NON-LETHAL HIT (Has HP remaining)
        playDuckBonk();
        playDuckQuack();

        if (d.duckMat) {
          const origColor = d.duckMat.color.getHex();
          d.duckMat.color.setHex(0xff0000);
          setTimeout(() => d.duckMat.color.setHex(origColor), 180);
        }

        d.hingePivot.rotation.z = (Math.random() - 0.5) * 0.4;

        if (d.healthDisplay) {
          const { ctx, tex, canvas: hCanvas } = d.healthDisplay;
          ctx.clearRect(0, 0, hCanvas.width, hCanvas.height);
          let heartStr = '';
          for (let h = 0; h < d.maxHP; h++) {
            heartStr += h < d.currentHP ? '❤️' : '🖤';
          }
          ctx.fillText(heartStr, 80, 24);
          tex.needsUpdate = true;
        }

        createHitParticles(duckPos, d.duckType === 'golden', d.duckType === 'boss');
        showFloatingScore(mouseWorldTarget, `CAN: ${d.currentHP}/${d.maxHP} 💥`, true);

      } else {
        // LETHAL HIT
        d.hit = true;
        d.tipVelocity = 0;

        totalHits++;
        currentStreak++;
        if (duckKillDisplay) duckKillDisplay.textContent = `Vurulan: ${totalHits}`;

        // Points using EXACT user table
        const pts = calculateDuckPoints(d);
        score += pts;

        scoreDisplay.textContent = score.toLocaleString('tr-TR');
        scoreDisplay.classList.add('score-bump');
        setTimeout(() => scoreDisplay.classList.remove('score-bump'), 250);

        recordViewerVictim(d.nickname, d.avatarUrl);

        playDuckHit();
        playDuckQuack();
        createHitParticles(duckPos, d.duckType === 'golden', d.duckType === 'boss');

        showFloatingScore(mouseWorldTarget, `+${pts}`, d.duckType === 'boss' || d.duckType === 'big');

        updateRoundTargetHUD();
        if (score >= roundTargetScore && roundActive) {
          completeRound(true);
        }
      }
      break;
    }
  }

  if (!hitAny) {
    currentStreak = 0;
  }

  const acc = totalShots > 0 ? Math.round((totalHits / totalShots) * 100) : 100;
  accuracyDisplay.textContent = `İsabet: %${acc}`;

  if (currentStreak >= 3) {
    streakBanner.classList.add('visible');
    streakTitle.textContent = `Streak x${currentStreak}!`;
    streakSub.textContent = currentStreak >= 5 ? 'EFSANEVİ SERİ! 🔥🚀' : 'MÜKEMMEL ATIŞ! 🔥';
  } else {
    streakBanner.classList.remove('visible');
  }

  if (!isRapidFire && currentAmmo <= 0) {
    startReload();
  }
}

function showFloatingScore(worldPos, text, isBoss = false) {
  const pos = worldPos.clone();
  pos.project(camera);
  const x = (pos.x * 0.5 + 0.5) * window.innerWidth;
  const y = (-(pos.y * 0.5) + 0.5) * window.innerHeight;

  const toast = document.createElement('div');
  toast.className = `floating-hit-toast ${isBoss ? 'boss-hit' : ''}`;
  toast.textContent = text;
  toast.style.left = `${x}px`;
  toast.style.top = `${y}px`;
  document.getElementById('game-container').appendChild(toast);
  setTimeout(() => toast.remove(), 1100);
}

function showEscapeToast(nickname) {
  // Yeşil bildirimler kullanıcı isteği üzerine tamamen kaldırıldı
}

// Viewer Tracking
function recordViewerVictim(nickname, avatarUrl) {
  const key = nickname.toLowerCase();
  const v = ACTIVE_VIEWERS.get(key) || { nickname, avatar: avatarUrl, deathCount: 0, escapeCount: 0 };
  v.deathCount++;
  ACTIVE_VIEWERS.set(key, v);
  syncLeaderboardToServer();
}

function recordViewerEscape(nickname, avatarUrl) {
  const key = nickname.toLowerCase();
  const v = ACTIVE_VIEWERS.get(key) || { nickname, avatar: avatarUrl, deathCount: 0, escapeCount: 0 };
  v.escapeCount++;
  ACTIVE_VIEWERS.set(key, v);
  syncLeaderboardToServer();
}

function syncLeaderboardToServer() {
  const all = Array.from(ACTIVE_VIEWERS.values());
  const survivors = all
    .filter(u => u.escapeCount > 0)
    .sort((a, b) => b.escapeCount - a.escapeCount)
    .slice(0, 10);
  const victims = all
    .filter(u => u.deathCount > 0)
    .sort((a, b) => b.deathCount - a.deathCount)
    .slice(0, 10);

  if (ws && ws.readyState === 1) {
    ws.send(JSON.stringify({
      type: "update-leaderboard",
      survivors,
      victims
    }));
  }
}

function renderLeaderboardModal() {
  const all = Array.from(ACTIVE_VIEWERS.entries());
  let list = [];

  if (currentLeadTab === 'survivors') {
    list = all.filter(([k, u]) => u.escapeCount > 0).sort((a, b) => b[1].escapeCount - a[1].escapeCount);
  } else {
    list = all.filter(([k, u]) => u.deathCount > 0).sort((a, b) => b[1].deathCount - a[1].deathCount);
  }

  leaderboardList.innerHTML = '';
  if (list.length === 0) {
    leaderboardList.innerHTML = `<div style="text-align:center; color:#888; padding:20px;">Henüz kayıtlı veri yok. Oynamaya devam edin!</div>`;
    return;
  }

  list.slice(0, 15).forEach(([key, u], i) => {
    const row = document.createElement('div');
    row.className = `leaderboard-row rank-${i + 1}`;
    const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : `${i + 1}.`;
    const countVal = currentLeadTab === 'survivors' ? `${u.escapeCount} Kaçış 🏃` : `${u.deathCount} Vurulma 🎯`;

    row.innerHTML = `
      <div class="user-badge">
        <span style="font-size:16px; width:22px;">${medal}</span>
        <img class="user-avatar-sm" src="${u.avatar}" onerror="this.src='/api/avatar?user=${encodeURIComponent(u.nickname)}'" />
        <span class="user-name-text">@${u.nickname}</span>
      </div>
      <div class="user-score-wrap">
        <div class="user-score-text">${countVal}</div>
        <div class="lead-controls">
          <button class="lead-btn btn-lead-plus" data-key="${key}" title="1 Artır">➕</button>
          <button class="lead-btn btn-lead-minus" data-key="${key}" title="1 Azalt">➖</button>
          <button class="lead-btn btn-lead-remove" data-key="${key}" title="Listeden Çıkar">🗑️</button>
        </div>
      </div>
    `;

    // Button event listeners
    const plusBtn = row.querySelector('.btn-lead-plus');
    const minusBtn = row.querySelector('.btn-lead-minus');
    const removeBtn = row.querySelector('.btn-lead-remove');

    plusBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const v = ACTIVE_VIEWERS.get(key);
      if (v) {
        if (currentLeadTab === 'survivors') v.escapeCount = (v.escapeCount || 0) + 1;
        else v.deathCount = (v.deathCount || 0) + 1;
        syncLeaderboardToServer();
        renderLeaderboardModal();
      }
    });

    minusBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const v = ACTIVE_VIEWERS.get(key);
      if (v) {
        if (currentLeadTab === 'survivors') v.escapeCount = Math.max(0, (v.escapeCount || 0) - 1);
        else v.deathCount = Math.max(0, (v.deathCount || 0) - 1);
        syncLeaderboardToServer();
        renderLeaderboardModal();
      }
    });

    removeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const v = ACTIVE_VIEWERS.get(key);
      if (v) {
        if (currentLeadTab === 'survivors') v.escapeCount = 0;
        else v.deathCount = 0;
        if (v.escapeCount === 0 && v.deathCount === 0) {
          ACTIVE_VIEWERS.delete(key);
        }
        syncLeaderboardToServer();
        renderLeaderboardModal();
      }
    });

    leaderboardList.appendChild(row);
  });
}

// Copy OBS Widget URL Function
if (btnCopyWidget) {
  btnCopyWidget.addEventListener('click', async () => {
    const mode = currentLeadTab === 'survivors' ? 'survivors' : 'victims';
    try {
      const response = await fetch('/api/launcher-widget-links', { cache: 'no-store' });
      const data = await response.json();
      const widgetUrl = data.links?.[mode];
      if (!response.ok || !data.ready || typeof widgetUrl !== 'string' || new URL(widgetUrl).protocol !== 'https:') throw new Error(data.message || 'HTTPS yayın bağlantısı hazır değil. Launcher içinden yayın bağlantısını hazırlayın.');
      try { await navigator.clipboard.writeText(widgetUrl); }
      catch {
        obsCopyFeedback.textContent = `Kopyalanamadı, lütfen adresi elle girin: ${widgetUrl}`;
        obsCopyFeedback.style.color = '#ffb703';
        return;
      }
      const modeName = currentLeadTab === 'survivors' ? 'En Çok Kaçanlar' : 'En Çok Vurulanlar';
      obsCopyFeedback.textContent = `✅ ${modeName} OBS Widget Bağlantısı Kopyalandı!`;
      obsCopyFeedback.style.color = '#00e676';
      setTimeout(() => { obsCopyFeedback.textContent = ''; }, 3500);
    } catch (error) {
      obsCopyFeedback.textContent = error.message || 'HTTPS yayın bağlantısı kullanılamıyor.';
      obsCopyFeedback.style.color = '#ffb703';
    }
  });
}

// =====================================================================
// ROUND / TARGET SCORE SYSTEM & PODIUM
// =====================================================================
function updateRoundTargetHUD() {
  if (targetCounterEl) {
    targetCounterEl.textContent = `${score.toLocaleString('tr-TR')} / ${roundTargetScore.toLocaleString('tr-TR')}`;
  }
  if (targetProgressBar) {
    const pct = Math.min(100, Math.round((score / roundTargetScore) * 100));
    targetProgressBar.style.width = `${pct}%`;
  }
}

function completeRound(isVictory) {
  roundActive = false;
  roundCompleted = true;

  if (isVictory) {
    playFanfare();
    completeBadge.textContent = '🏆 YAYINCI KAZANDI!';
    completeTitle.textContent = `HEDEF PUANA ULAŞILDI! (${score.toLocaleString('tr-TR')} Puan) 🎉`;
  } else {
    playJamSound();
    completeBadge.textContent = '🏃 İZLEYİCİLER KAZANDI!';
    completeTitle.textContent = `Süre Bitti! Ördekler Başarıyla Kaçtı!`;
  }

  cstatScore.textContent = score.toLocaleString('tr-TR');
  cstatHits.textContent = totalHits;
  const acc = totalShots > 0 ? Math.round((totalHits / totalShots) * 100) : 100;
  cstatAcc.textContent = `%${acc}`;

  let totalEscaped = 0;
  ACTIVE_VIEWERS.forEach(v => { totalEscaped += v.escapeCount; });
  cstatEscapes.textContent = totalEscaped;

  renderPodium();
  roundCompleteModal.classList.add('open');
}

function renderPodium() {
  if (!podiumGrid) return;
  podiumGrid.innerHTML = '';

  const survivors = Array.from(ACTIVE_VIEWERS.values())
    .filter(u => u.escapeCount > 0)
    .sort((a, b) => b.escapeCount - a.escapeCount)
    .slice(0, 3);

  const defaults = [
    { nickname: 'Kral_Kacan', avatar: '/api/avatar?user=Kral_Kacan', escapeCount: 0 },
    { nickname: 'Hizli_Ordek', avatar: '/api/avatar?user=Hizli_Ordek', escapeCount: 0 },
    { nickname: 'Kurnaz_Av', avatar: '/api/avatar?user=Kurnaz_Av', escapeCount: 0 }
  ];

  const top3 = [
    survivors[0] || defaults[0],
    survivors[1] || defaults[1],
    survivors[2] || defaults[2]
  ];

  const podiumOrders = [
    { rank: 2, u: top3[1], crown: '🥈', stand: '2' },
    { rank: 1, u: top3[0], crown: '👑 1.', stand: '1' },
    { rank: 3, u: top3[2], crown: '🥉', stand: '3' }
  ];

  podiumOrders.forEach(p => {
    const el = document.createElement('div');
    el.className = `podium-item podium-${p.rank}`;
    el.innerHTML = `
      <div class="podium-crown">${p.crown}</div>
      <img class="podium-avatar" src="${p.u.avatar}" onerror="this.src='/api/avatar?user=${encodeURIComponent(p.u.nickname)}'" />
      <div class="podium-name">@${p.u.nickname}</div>
      <div class="podium-escapes">${p.u.escapeCount} Kaçış</div>
      <div class="podium-stand">${p.stand}</div>
    `;
    podiumGrid.appendChild(el);
  });
}

function restartRound() {
  roundActive = true;
  roundCompleted = false;
  isRoundPaused = false;
  if (btnRoundPause) {
    btnRoundPause.innerHTML = '⏸️';
    btnRoundPause.classList.remove('paused');
  }
  if (roundTimerEl) roundTimerEl.classList.remove('paused');
  roundTimeLeft = roundDuration;
  score = 0;
  totalHits = 0;
  totalShots = 0;
  currentStreak = 0;
  scoreDisplay.textContent = '0';
  accuracyDisplay.textContent = 'İsabet: %100';
  if (duckKillDisplay) duckKillDisplay.textContent = 'Vurulan: 0';
  roundCompleteModal.classList.remove('open');
  spawnInitialDucks();
  updateRoundTargetHUD();
}

