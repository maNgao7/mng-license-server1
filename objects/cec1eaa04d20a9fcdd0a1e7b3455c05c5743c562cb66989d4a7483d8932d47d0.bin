// Load Saved Settings from localStorage
function loadSavedSettings() {
  try {
    const raw = localStorage.getItem('mng_duck_hunt_v5_cfg');
    if (raw) {
      const cfg = JSON.parse(raw);
      if (cfg.roundDuration !== undefined) roundDuration = Number(cfg.roundDuration);
      if (cfg.roundTargetScore !== undefined) roundTargetScore = Number(cfg.roundTargetScore);
      if (cfg.jamDurationSetting !== undefined) jamDurationSetting = Number(cfg.jamDurationSetting);
      if (cfg.rapidDurationSetting !== undefined) rapidDurationSetting = Number(cfg.rapidDurationSetting);
      if (cfg.viewerAdmissionMode) viewerAdmissionMode = cfg.viewerAdmissionMode;
      if (cfg.likeActionSetting) likeActionSetting = cfg.likeActionSetting;
      if (cfg.followActionSetting) followActionSetting = cfg.followActionSetting;
      if (cfg.gameSpeedMultiplier !== undefined) gameSpeedMultiplier = Number(cfg.gameSpeedMultiplier);
      if (cfg.musicVolume !== undefined) musicVolume = Number(cfg.musicVolume);
      if (cfg.sfxVolume !== undefined) sfxVolume = Number(cfg.sfxVolume);
      if (cfg.soundEnabled !== undefined) soundEnabled = Boolean(cfg.soundEnabled);
    }

    const savedSlots = localStorage.getItem('mng_duck_hunt_v5_slots');
    if (savedSlots) {
      const parsedSlots = JSON.parse(savedSlots);
      if (Array.isArray(parsedSlots) && parsedSlots.length) {
        CUSTOM_GIFT_SLOTS = parsedSlots.map(s => ({
          ...s,
          coins: s.coins || 1,
          jamDuration: s.jamDuration || 3,
          mudDuration: s.mudDuration || 10,
          rapidDuration: s.rapidDuration || 10
        }));
      }
    }
  } catch {}

  roundTimeLeft = roundDuration;
  if (selectRoundTime) selectRoundTime.value = String(roundDuration);
  if (selectRoundTargetScore) selectRoundTargetScore.value = String(roundTargetScore);
  if (selectJamDuration) selectJamDuration.value = String(jamDurationSetting);
  if (selectRapidDuration) selectRapidDuration.value = String(rapidDurationSetting);
  if (selectAdmissionMode) selectAdmissionMode.value = viewerAdmissionMode;
  if (selectLikeAction) selectLikeAction.value = likeActionSetting;
  if (selectFollowAction) selectFollowAction.value = followActionSetting;
  if (sliderSpeed) sliderSpeed.value = String(gameSpeedMultiplier);
  if (sliderMusic) sliderMusic.value = String(musicVolume);
  if (sliderSfx) sliderSfx.value = String(sfxVolume);
  if (btnSound) btnSound.textContent = soundEnabled ? '🔊' : '🔇';
  updateRoundTargetHUD();
}

function saveSettings() {
  try {
    const cfg = {
      roundDuration,
      roundTargetScore,
      jamDurationSetting,
      rapidDurationSetting,
      viewerAdmissionMode,
      likeActionSetting,
      followActionSetting,
      gameSpeedMultiplier,
      musicVolume,
      sfxVolume,
      soundEnabled
    };
    localStorage.setItem('mng_duck_hunt_v5_cfg', JSON.stringify(cfg));
    localStorage.setItem('mng_duck_hunt_v5_slots', JSON.stringify(CUSTOM_GIFT_SLOTS));
  } catch {}
}

if (selectAdmissionMode) {
  selectAdmissionMode.addEventListener('change', (e) => {
    viewerAdmissionMode = e.target.value;
    saveSettings();
  });
}

loadSavedSettings();

// =====================================================================
// EXACT POINT SCORING SYSTEM (Kullanıcının Verdiği Kesin Değerler)
// Normal: 200, 1.2x: 250, 1.5x: 300, 2x: 350, 3x: 400, 5x: 500,
// Altın: 300, Büyük Ördek (2 Can): 500, Dev Boss (3 Can): 1000
// =====================================================================
function calculateDuckPoints(duck) {
  if (duck.duckType === 'boss') return 1000;
  if (duck.duckType === 'big') return 500;
  if (duck.duckType === 'golden') return 300;

  // Speed-based points for boosted ducks
  const spd = duck.speedMultiplier;
  if (spd >= 4.5) return 500; // 5x Roket
  if (spd >= 2.8) return 400; // 3x
  if (spd >= 1.8) return 350; // 2x
  if (spd >= 1.4) return 300; // 1.5x
  if (spd >= 1.15) return 250; // 1.2x
  return 200; // Normal izleyici ördeği
}

// =====================================================================
// PROCEDURAL AUDIO SYNTHESIZER & CARNIVAL MUSIC
// =====================================================================
let audioCtx = null;
let musicInterval = null;
let musicStep = 0;

function initAudio() {
  if (!audioCtx) {
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    if (AudioContextClass) audioCtx = new AudioContextClass();
  }
  if (audioCtx && audioCtx.state === 'suspended') {
    audioCtx.resume();
  }
  startCarnivalMusic();
}

// Background Carnival Organ Melody (Eğlenceli Lunapark Karusel Melodisi)
function startCarnivalMusic() {
  if (musicInterval || !soundEnabled) return;
  // Cheerful, catchy fairground waltz tune
  const melodyNotes = [
    523.25, 659.25, 783.99, 659.25, 523.25, 659.25, 783.99, 880.00,
    783.99, 659.25, 587.33, 659.25, 587.33, 523.25, 493.88, 523.25
  ];

  musicInterval = setInterval(() => {
    if (!soundEnabled || musicVolume <= 0.01 || !audioCtx) return;
    try {
      const freq = melodyNotes[musicStep % melodyNotes.length];
      musicStep++;
      const t = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      const filter = audioCtx.createBiquadFilter();

      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, t);

      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(1200, t);

      gain.gain.setValueAtTime(0.001, t);
      gain.gain.linearRampToValueAtTime(0.08 * musicVolume, t + 0.05);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.38);

      osc.connect(filter);
      filter.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start(t);
      osc.stop(t + 0.4);
    } catch {}
  }, 380);
}

function stopCarnivalMusic() {
  if (musicInterval) {
    clearInterval(musicInterval);
    musicInterval = null;
  }
}

// Cork Pop Sound
function playCorkPop() {
  if (!soundEnabled || sfxVolume <= 0.01 || !audioCtx) return;
  try {
    const t = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(260, t);
    osc.frequency.exponentialRampToValueAtTime(45, t + 0.1);
    gain.gain.setValueAtTime(0.55 * sfxVolume, t);
    gain.gain.exponentialRampToValueAtTime(0.01, t + 0.11);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(t);
    osc.stop(t + 0.11);
  } catch {}
}

// Duck Hit Sound (Yumuşatılmış & Kısılabilir Vuruş Sesi)
function playDuckHit() {
  if (!soundEnabled || sfxVolume <= 0.01 || !audioCtx) return;
  try {
    const t = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(1150, t);
    osc.frequency.exponentialRampToValueAtTime(800, t + 0.16);
    gain.gain.setValueAtTime(0.35 * sfxVolume, t); // Softened pleasant chime
    gain.gain.exponentialRampToValueAtTime(0.001, t + 0.18);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(t);
    osc.stop(t + 0.18);
  } catch {}
}

// Duck Damage Bonk Sound
function playDuckBonk() {
  if (!soundEnabled || sfxVolume <= 0.01 || !audioCtx) return;
  try {
    const t = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(440, t);
    osc.frequency.exponentialRampToValueAtTime(160, t + 0.14);
    gain.gain.setValueAtTime(0.45 * sfxVolume, t);
    gain.gain.exponentialRampToValueAtTime(0.01, t + 0.15);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(t);
    osc.stop(t + 0.15);
  } catch {}
}

// Playful Quack
function playDuckQuack() {
  if (!soundEnabled || sfxVolume <= 0.01 || !audioCtx) return;
  try {
    const t = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    const filter = audioCtx.createBiquadFilter();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(360, t);
    osc.frequency.linearRampToValueAtTime(440, t + 0.06);
    osc.frequency.exponentialRampToValueAtTime(240, t + 0.2);
    filter.type = 'bandpass';
    filter.frequency.setValueAtTime(820, t);
    filter.Q.value = 3.5;
    gain.gain.setValueAtTime(0.28 * sfxVolume, t);
    gain.gain.exponentialRampToValueAtTime(0.01, t + 0.22);
    osc.connect(filter);
    filter.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(t);
    osc.stop(t + 0.22);
  } catch {}
}

// Bomb Explosion
function playBombExplosion() {
  if (!soundEnabled || sfxVolume <= 0.01 || !audioCtx) return;
  try {
    const t = audioCtx.currentTime;
    const subOsc = audioCtx.createOscillator();
    const subGain = audioCtx.createGain();
    subOsc.type = 'sine';
    subOsc.frequency.setValueAtTime(140, t);
    subOsc.frequency.exponentialRampToValueAtTime(25, t + 0.45);
    subGain.gain.setValueAtTime(0.9 * sfxVolume, t);
    subGain.gain.exponentialRampToValueAtTime(0.001, t + 0.5);
    subOsc.connect(subGain);
    subGain.connect(audioCtx.destination);
    subOsc.start(t);
    subOsc.stop(t + 0.5);
  } catch {}
}

// Wet Mud Splat Sound
function playMudSplat() {
  if (!soundEnabled || sfxVolume <= 0.01 || !audioCtx) return;
  try {
    const t = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
