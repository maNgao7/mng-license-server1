f}.settings-scroll input[type=range]{width:130px;accent-color:#ffd24a}.settings-scroll output{min-width:24px;text-align:right;color:#ffd24a;font-weight:900}.number-field{display:flex;align-items:center;gap:5px}.number-field span{font-size:8px;color:#829589}.toggle-row span{display:grid}.toggle-row small{font-size:8px;color:#829589}.toggle-row input{width:38px;height:20px;accent-color:#25d8d1}.section-note{margin:-8px 0 10px;color:#829589;font-size:9px}.test-user{display:grid;grid-template-columns:1fr 90px;gap:6px}.test-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:7px}.test-grid button,.save-settings{display:flex;align-items:center;justify-content:center;gap:5px;padding:10px;border:1px solid #ffffff25;border-radius:4px;background:#24362d;color:#fff;font-size:9px;font-weight:900}.test-grid svg,.save-settings svg{width:14px}.save-settings{margin:14px 20px;border:0;background:#f0c94e;color:#29200b;font-size:11px}.result-screen{text-align:center}.winner-crown{color:#ffd24a}.winner-crown svg{width:72px;height:72px;fill:#ffd24a}.result-screen p{font-size:10px;font-weight:900;letter-spacing:2px}.winner-avatar{width:130px;height:130px;display:grid;place-items:center;margin:5px auto;border:7px solid #ffd24a;border-radius:50%;background:#25d8d1;font-family:"Baloo 2";font-size:64px;box-shadow:0 0 45px #ffd24a88}.result-screen h2{margin:10px 0 0;font-family:"Baloo 2";font-size:42px}.result-screen>b{color:#ffd24a}.result-screen button{display:flex;align-items:center;gap:7px;margin:22px auto 0;padding:12px 20px;border:0;border-radius:5px;background:#e7473c;color:#fff;font-weight:900}.result-screen button svg{width:17px}@media(max-width:900px){.leaderboard{width:210px}.event-feed{width:220px}.throw-console{width:60vw;grid-template-columns:1fr 120px auto}.brand div{display:none}}@media(max-width:650px){.hud-top{left:8px;right:8px}.race-pill{min-width:160px}.leaderboard{top:auto;bottom:88px;left:8px;width:190px;max-height:220px;overflow:hidden}.event-feed{