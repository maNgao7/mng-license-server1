:root{font-family:Inter,Arial,sans-serif;color:#fff;background:#09130f;font-synthesis:none;--red:#e7473c;--yellow:#ffd24a;--green:#7acb67;--ink:#17231d;--cyan:#25f4ee;--pink:#fe2c55}*{box-sizing:border-box}html,body,#app{width:100%;height:100%;margin:0;overflow:hidden}button,input,select{font:inherit}button{cursor:pointer}#gameCanvas{position:fixed;top:0;right:0;bottom:0;left:0;width:100%;height:100%;display:block;background:#8fd578}.hud-top{position:fixed;z-index:10;left:18px;right:18px;top:16px;height:58px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;pointer-events:none}.brand,.race-pill,.hud-actions>*{pointer-events:auto}.brand{display:flex;align-items:center;gap:10px;text-shadow:0 2px 8px #000}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:3px solid #fff;border-radius:50%;background:linear-gradient(135deg,var(--cyan),var(--pink));font-family:"Baloo 2";font-size:25px;font-weight:800;box-shadow:0 5px 18px #0005}.brand div{display:grid}.brand b{font-family:"Baloo 2";font-size:20px;line-height:1}.brand small{font-size:9px;font-weight:800;letter-spacing:1.5px;color:#fff9c8}.race-pill{min-width:220px;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:9px 12px 9px 16px;border:2px solid #fff8;border-radius:6px;background:#1a281ed9;box-shadow:0 6px 20px #0005}.race-pill span{font-size:11px;font-weight:900;letter-spacing:.7px;color:#ffe477}.race-pill b{font-family:"Baloo 2";font-size:22px;line-height:1}.hud-actions{justify-self:end;display:flex;gap:7px}.icon-button{width:42px;height:42px;display:grid;place-items:center;border:1px solid #fff6;border-radius:5px;background:#17251ee6;color:#fff}.icon-button svg{width:19px}.leaderboard{position:fixed;z-index:8;top:88px;left:18px;width:248px;padding:12px;border:2px solid #fff7;border-radius:6px;background:#14231ce8;box-shadow:0 12px 35px #0005;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}.panel-title{display:flex;justify-content:space-