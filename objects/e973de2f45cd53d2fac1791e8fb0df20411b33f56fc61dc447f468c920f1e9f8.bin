<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>OBS VS Kazananlar</title><style>*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:transparent;font-family:Arial,sans-serif;color:#fff}.panel{width:360px;margin:18px;padding:16px;border:1px solid rgba(37,244,238,.58);border-radius:16px;background:rgba(8,12,27,.86);box-shadow:0 10px 35px rgba(0,0,0,.65)}h1{margin:0 0 11px;color:#25f4ee;font-size:15px;letter-spacing:1.2px}.list{display:flex;flex-direction:column;gap:7px}.row{display:flex;align-items:center;justify-content:space-between;min-height:38px;padding:8px 10px;border-radius:9px;background:rgba(255,255,255,.08);animation:in .35s ease}.name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:800;font-size:14px}.wins{margin-left:10px;color:#ffd53d;font-size:18px;font-weight:900;white-space:nowrap}.empty{opacity:.68;font-size:13px;padding:7px 0}@keyframes in{from{transform:translateY(-7px);opacity:0}to{transform:none;opacity:1}}</style></head><body><section class="panel"><h1>🏆 KAZANANLAR</h1><div id="list" class="list"><div class="empty">Henüz tamamlanan tur yok.</div></div></section><script>let s,t,d=1000;const u=()=>location.protocol==='file:'||!location.host?'ws://localhost:3000':(location.protocol==='https:'?'wss://':'ws://')+location.host;function r(){if(t)return;t=setTimeout(()=>{t=null;c()},d);d=Math.min(d*1.7,10000)}function c(){if(s&&(s.readyState===WebSocket.OPEN||s.readyState===WebSocket.CONNECTING))return;try{s=new WebSocket(u());s.onopen=()=>d=1000;s.onmessage=e=>{try{const m=JSON.parse(e.data);if(m.type==='battleState')draw(m.state)}catch(_){}};s.onerror=()=>{try{s.close()}catch(_){}};s.onclose=()=>{s=null;r()}}catch(_){r()}}function draw(state){const counts=new Map();['leftTally','rightTally'].forEach(k=>(state[k]||[]).forEach(x=>{const n=String(x.name||'OYUNCU').replace(/^@+/,'');counts.set(n,(counts.get(n)||0)+1)}));const box=document.getElementById('list');box.innerHTML='';const rows=[...counts.entries()].sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0],'tr'));if(!rows.length){box.innerHTML='<div class="empty">Henüz tamamlanan tur yok.</div>';return}rows.forEach(([n,count])=>{const row=document.createElement('div'),name=document.createElement('div'),wins=document.createElement('div');row.className='row';name.className='name';wins.className='wins';name.textContent=n;wins.textContent=count+'X';row.append(name,wins);box.appendChild(row)})}c()</script></body></html>
