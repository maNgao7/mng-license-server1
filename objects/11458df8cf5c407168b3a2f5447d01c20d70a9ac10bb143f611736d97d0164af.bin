<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>OBS En Çok Coin Atanlar Şeffaf Widget</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%;
  height: 100%;
  background: transparent !important;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: #fff;
  user-select: none;
}
:root {
  --primary-accent: #ffd700;
  --secondary-accent: #25f4ee;
  --tertiary-accent: #fe2c55;
  --bronze-accent: #cd7f32;
  --card-bg: rgba(14, 18, 32, 0.88);
}
.widget {
  width: 100%;
  max-width: 440px;
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 14px;
  gap: 10px;
  box-sizing: border-box;
}
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  background: var(--card-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 2px solid rgba(255, 215, 0, 0.5);
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.65), 0 0 16px rgba(255, 215, 0, 0.22);
}
.title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 16px;
  font-weight: 900;
  letter-spacing: 0.6px;
  background: linear-gradient(135deg, var(--primary-accent), #ffa500);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 2px 10px rgba(255, 215, 0, 0.3);
}
.live-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  font-weight: 800;
  color: var(--secondary-accent);
  background: rgba(37, 244, 238, 0.15);
  padding: 3px 9px;
  border-radius: 12px;
  border: 1px solid rgba(37, 244, 238, 0.45);
}
.live-dot {
  width: 7px;
  height: 7px;
  background: var(--secondary-accent);
  border-radius: 50%;
  animation: pulseDot 1.4s infinite;
}
@keyframes pulseDot {
  0% { transform: scale(0.8); opacity: 0.5; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(0.8); opacity: 0.5; }
}
.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 7px;
  flex: 1;
  overflow-y: auto;
  scrollbar-width: none;
}
.ranking-list::-webkit-scrollbar { display: none; }

.rank-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 14px;
  border-radius: 14px;
  background: var(--card-bg);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.45);
  transition: all 0.3s ease;
  animation: cardSlide 0.35s ease-out;
}
@keyframes cardSlide {
  from { opacity: 0; transform: translateY(-8px); }
  to { opacity: 1; transform: translateY(0); }
}

.rank-card.rank-1 {
  border: 2px solid var(--primary-accent);
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.18), rgba(18, 22, 38, 0.94));
  box-shadow: 0 6px 22px rgba(255, 215, 0, 0.32), 0 0 14px rgba(255, 215, 0, 0.2);
}
.rank-card.rank-2 {
  border: 1.5px solid var(--secondary-accent);
  background: linear-gradient(135deg, rgba(37, 244, 238, 0.14), rgba(18, 22, 38, 0.94));
  box-shadow: 0 4px 16px rgba(37, 244, 238, 0.22);
}
.rank-card.rank-3 {
  border: 1.5px solid var(--bronze-accent);
  background: linear-gradient(135deg, rgba(205, 127, 50, 0.14), rgba(18, 22, 38, 0.94));
  box-shadow: 0 4px 14px rgba(205, 127, 50, 0.2);
}

.rank-badge {
  font-size: 16px;
  font-weight: 900;
  min-width: 28px;
  text-align: center;
  color: #aaa;
}
.rank-1 .rank-badge { font-size: 20px; }
.rank-2 .rank-badge { font-size: 18px; }
.rank-3 .rank-badge { font-size: 17px; }

.avatar-wrap {
  position: relative;
  width: 42px;
  height: 42px;
  flex-shrink: 0;
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid #fff;
  background: #1a2236;
}
.rank-1 .avatar-img { border-color: var(--primary-accent); }
.rank-2 .avatar-img { border-color: var(--secondary-accent); }
.rank-3 .avatar-img { border-color: var(--bronze-accent); }

.avatar-fallback {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 16px;
  font-weight: 900;
  background: linear-gradient(135deg, var(--secondary-accent), var(--tertiary-accent));
  color: #fff;
}

.user-info {
  flex: 1;
  min-width: 0;
}
.user-name {
  font-size: 14px;
  font-weight: 800;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 1px 4px rgba(0,0,0,0.8);
}
.user-sub {
  font-size: 11px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.55);
}

.score-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 1px;
  flex-shrink: 0;
}
.coins-val {
  font-size: 16px;
  font-weight: 900;
  color: var(--primary-accent);
  text-shadow: 0 0 10px rgba(255, 215, 0, 0.4);
  letter-spacing: 0.4px;
}
.rank-2 .coins-val { color: var(--secondary-accent); text-shadow: 0 0 10px rgba(37, 244, 238, 0.35); }
.rank-3 .coins-val { color: #f59e0b; }
.coins-label {
  font-size: 10px;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.5);
  text-transform: uppercase;
}

.empty-state {
  padding: 24px 16px;
  text-align: center;
  background: rgba(14, 18, 32, 0.7);
  border-radius: 14px;
  border: 1px dashed rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.6);
  font-size: 13px;
  font-weight: 600;
  line-height: 1.5;
}
</style>
</head>
<body>

<main class="widget">
  <header class="header">
    <div class="title">
      <span>🏆</span>
      <span id="titleText">EN ÇOK COİN ATANLAR</span>
    </div>
    <div class="live-badge">
      <span class="live-dot"></span>
      <span>CANLI</span>
    </div>
  </header>

  <section class="ranking-list" id="rankingList">
    <div class="empty-state">Henüz hediye gönderilmedi.<br>Canlı yayındaki hediyeler burada listelenir.</div>
  </section>
</main>

<script>
const params = new URLSearchParams(window.location.search);
if (params.get("accent")) {
  document.documentElement.style.setProperty("--primary-accent", params.get("accent"));
}
if (params.get("title")) {
  document.getElementById("titleText").textContent = params.get("title");
}

const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" }[c]));
const fmt = n => Number(n || 0).toLocaleString("tr-TR");

function render(entries) {
  const listEl = document.getElementById("rankingList");
  if (!entries || entries.length === 0) {
    listEl.innerHTML = '<div class="empty-state">Henüz hediye gönderilmedi.<br>Canlı yayındaki hediyeler burada listelenir.</div>';
    return;
  }

  listEl.innerHTML = entries.map((item, index) => {
    const rank = index + 1;
    let rankClass = "rank-other";
    let rankBadge = rank;
    if (rank === 1) { rankClass = "rank-1"; rankBadge = "🥇"; }
    else if (rank === 2) { rankClass = "rank-2"; rankBadge = "🥈"; }
    else if (rank === 3) { rankClass = "rank-3"; rankBadge = "🥉"; }

    const avatarUrl = item.avatar ? esc(item.avatar) : "";
    const name = esc(item.nickname || item.username || "izleyici");
    const uName = esc(item.username || item.nickname || "izleyici");
    const coins = fmt(item.totalCoins || item.coins || 0);
    const initial = esc((item.nickname || item.username || "?").slice(0, 1).toLocaleUpperCase("tr-TR"));

    return `
      <article class="rank-card ${rankClass}">
        <div class="rank-badge">${rankBadge}</div>
        <div class="avatar-wrap">
          ${avatarUrl ? `<img class="avatar-img" src="${avatarUrl}" alt="${name}" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';">` : ''}
          <div class="avatar-fallback" style="display:${avatarUrl ? 'none' : 'grid'}">${initial}</div>
        </div>
        <div class="user-info">
          <div class="user-name">@${uName}</div>
          <div class="user-sub">${name}</div>
        </div>
        <div class="score-box">
          <div class="coins-val">${coins}</div>
          <div class="coins-label">COİN</div>
        </div>
      </article>
    `;
  }).join("");
}

async function refresh() {
  try {
    const res = await fetch("/widget/leaderboard/state?" + Date.now(), { cache: "no-store" });
    if (!res.ok) return;
    const data = await res.json();
    if (!data || !Array.isArray(data.entries)) return;
    render(data.entries);
  } catch (err) {}
}

refresh();
setInterval(refresh, 800);
</script>
</body>
</html>
