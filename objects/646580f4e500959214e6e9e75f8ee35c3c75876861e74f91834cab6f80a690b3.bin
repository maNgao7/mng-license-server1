// --------------------------------------------------------------------------
// SEVİMLİ PELUŞ AYICIK (Videodaki gibi kalenin sağında sevinir)
// --------------------------------------------------------------------------
export function createTeddyBear() {
  const root = new THREE.Group();
  const furMat = stdMat('#9b6138', 0.82);
  const bellyMat = stdMat('#f0dec5', 0.8);
  const darkMat = stdMat('#1f140d', 0.9);
  const bowMat = stdMat('#e30a17', 0.55);

  const body = new THREE.Group();
  root.add(body);

  // Gövde (Tombul sevimli ayı)
  const torso = new THREE.Mesh(new THREE.SphereGeometry(0.55, 20, 16), furMat);
  torso.scale.set(1.0, 1.25, 0.9);
  torso.position.y = 1.05;
  torso.castShadow = true;
  body.add(torso);

  // Göbek
  const belly = new THREE.Mesh(new THREE.SphereGeometry(0.36, 16, 14), bellyMat);
  belly.scale.set(0.9, 1.1, 0.4);
  belly.position.set(0, 1.0, 0.38);
  body.add(belly);

  // Kafa
  const head = new THREE.Mesh(new THREE.SphereGeometry(0.42, 20, 16), furMat);
  head.position.set(0, 1.82, 0.05);
  head.castShadow = true;
  body.add(head);

  // Kulaklar
  [-0.32, 0.32].forEach(x => {
    const ear = new THREE.Mesh(new THREE.SphereGeometry(0.14, 14, 12), furMat);
    ear.position.set(x, 2.15, 0);
    body.add(ear);
    const inEar = new THREE.Mesh(new THREE.SphereGeometry(0.08, 12, 10), bellyMat);
    inEar.position.set(x, 2.15, 0.06);
    body.add(inEar);
  });

  // Burun / Ağız bölgesi
  const snout = new THREE.Mesh(new THREE.SphereGeometry(0.18, 14, 12), bellyMat);
  snout.scale.set(1.1, 0.8, 1.0);
  snout.position.set(0, 1.76, 0.34);
  body.add(snout);

  const nose = new THREE.Mesh(new THREE.SphereGeometry(0.06, 10, 8), darkMat);
  nose.position.set(0, 1.82, 0.48);
  body.add(nose);

  // Gözler
  [-0.14, 0.14].forEach(x => {
    const eye = new THREE.Mesh(new THREE.SphereGeometry(0.038, 10, 8), darkMat);
    eye.position.set(x, 1.9, 0.4);
    body.add(eye);
  });

  // Kırmızı Papyon
  const bow = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.1, 0.08), bowMat);
  bow.position.set(0, 1.48, 0.42);
  body.add(bow);

  // Bacaklar
  [-0.26, 0.26].forEach(x => {
    const leg = new THREE.Mesh(new THREE.CapsuleGeometry(0.18, 0.35, 8, 14), furMat);
    leg.position.set(x, 0.32, 0);
    leg.castShadow = true;
    body.add(leg);
  });

  // Hareketli Kollar (Golde havaya kalkan kollar)
  const lArm = new THREE.Group();
  lArm.position.set(-0.54, 1.35, 0);
  const lArmMesh = new THREE.Mesh(new THREE.CapsuleGeometry(0.14, 0.45, 8, 14), furMat);
  lArmMesh.position.set(0, -0.22, 0);
  lArmMesh.castShadow = true;
  lArm.add(lArmMesh);
  body.add(lArm);

  const rArm = new THREE.Group();
  rArm.position.set(0.54, 1.35, 0);
  const rArmMesh = new THREE.Mesh(new THREE.CapsuleGeometry(0.14, 0.45, 8, 14), furMat);
  rArmMesh.position.set(0, -0.22, 0);
  rArmMesh.castShadow = true;
  rArm.add(rArmMesh);
  body.add(rArm);

  return {
    root,
    body,
    lArm,
    rArm,
    update(isGoal, timeSec) {
      if (isGoal) {
        lArm.rotation.z = Math.PI * 0.78 + Math.sin(timeSec * 8) * 0.2;
        rArm.rotation.z = -Math.PI * 0.78 - Math.sin(timeSec * 8) * 0.2;
        body.position.y = Math.abs(Math.sin(timeSec * 6)) * 0.25;
      } else {
        lArm.rotation.z = 0.25 + Math.sin(timeSec * 1.5) * 0.05;
        rArm.rotation.z = -0.25 - Math.sin(timeSec * 1.5) * 0.05;
        body.position.y = 0;
      }
    }
  };
}

// --------------------------------------------------------------------------
// AVATAR (PROFİL FOTOĞRAFI) & İSİM ETİKETLERİ
// --------------------------------------------------------------------------
const imageCache = new Map();
export function loadImage(url) {
  if (!url) return Promise.reject(new Error('no url'));
  if (imageCache.has(url)) return imageCache.get(url);
  const p = new Promise((resolve, reject) => {
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.decoding = 'async';
    img.onload = () => resolve(img);
    img.onerror = reject;
    img.src = url;
  });
  imageCache.set(url, p);
  p.catch(() => imageCache.delete(url));
  return p;
}

export function avatarUrlFor(player) {
  if (!player) return '/api/tiktok-avatar?user=MNG';
  if (player.avatarUrl) return player.avatarUrl;
  const nick = String(player.nickname || player.username || player.uniqueId || 'İzleyici').replace(/^@/, '').trim();
  const raw = String(player.avatar || '').trim();

  // Zaten yerel bir API ise doğrudan kullan
  if (raw.startsWith('/api/')) return raw;

  // Harici TikTok / CDN resmi ise, yerel proxy üzerinden güvenle çek (CORS ve Hotlink korumasını aşar)
  if (raw.startsWith('http://') || raw.startsWith('https://')) {
    return `/api/avatar?user=${encodeURIComponent(nick)}&url=${encodeURIComponent(raw)}`;
  }

  // URL verilmemişse doğrudan TikTok profil servisinden HD avatar çek
  return `/api/tiktok-avatar?user=${encodeURIComponent(nick)}`;
}

export function drawAvatarCircle(ctx, img, size, ring = '#ffd34d', ringW = null, letter = 'U') {
  const r = size / 2;
  const rw = ringW ?? Math.max(5, size * 0.075);
  ctx.clearRect(0, 0, size, size);

  // 1. Dış parlama ve neon aura
  ctx.save();
  ctx.shadowColor = ring;
  ctx.shadowBlur = size * 0.08;
  ctx.beginPath();
  ctx.arc(r, r, r - rw * 0.5 - size * 0.02, 0, Math.PI * 2);
  ctx.fillStyle = ring;
  ctx.fill();
  ctx.restore();

  // 2. İç Fotoğraf veya Baş Harf Alanı
  ctx.save();
  ctx.beginPath();
  ctx.arc(r, r, r - rw - size * 0.02, 0, Math.PI * 2);
  ctx.clip();
  if (img && img.width > 0 && img.height > 0) {
    const s = Math.min(img.width, img.height);
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(img, (img.width - s) / 2, (img.height - s) / 2, s, s, 0, 0, size, size);
  } else {
    // Yüklenene kadar şık renkli gradyan ve baş harf
    const bgGrad = ctx.createLinearGradient(0, 0, size, size);
    bgGrad.addColorStop(0, '#1e293b');
    bgGrad.addColorStop(1, '#0f172a');
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0, 0, size, size);

    ctx.fillStyle = '#ffffff';
    ctx.font = `bold ${Math.round(size * 0.42)}px "Montserrat", sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText((letter || 'U').toUpperCase(), r, r + size * 0.02);
  }
  ctx.restore();

  // 3. Parlak Metalik / Neon Kenarlık Çerçevesi
  ctx.save();
  ctx.beginPath();
  ctx.arc(r, r, r - rw * 0.5 - size * 0.02, 0, Math.PI * 2);
  ctx.lineWidth = rw;
  const g = ctx.createLinearGradient(0, 0, size, size);
  g.addColorStop(0, '#ffffff');
  g.addColorStop(0.35, ring);
  g.addColorStop(1, ring);
  ctx.strokeStyle = g;
  ctx.stroke();
  ctx.restore();
}

export function createAvatarTexture(url, ring = '#ffd34d', size = 512, fallbackUrl = null, letter = 'U') {
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const ctx = c.getContext('2d');
  drawAvatarCircle(ctx, null, size, ring, null, letter);
  const tex = new THREE.CanvasTexture(c);
  tex.colorSpace = THREE.SRGBColorSpace;
  tex.anisotropy = 8;
  tex.generateMipmaps = true;
  tex.minFilter = THREE.LinearMipmapLinearFilter;
  const apply = img => {
    drawAvatarCircle(ctx, img, size, ring, null, letter);
    tex.needsUpdate = true;
  };
  loadImage(url)
    .then(apply)
    .catch(() => {
      if (fallbackUrl) {
        loadImage(fallbackUrl).then(apply).catch(() => {});
      }
    });
  return tex;
}

export function createLabelTexture(text, opts = {}) {
  const c = document.createElement('canvas');
  const W = opts.width || 640, H = opts.height || 140;
  c.width = W; c.height = H;
  const ctx = c.getContext('2d');
  
  // Keskin ve okunaklı font
  const font = fitFont(ctx, text, W * 0.88, opts.size || 64, 900, 'Montserrat, sans-serif');
  ctx.font = font;
  const tw = Math.min(W - 12, ctx.measureText(text).width + H * 0.75);
  const x = (W - tw) / 2;
  const rr = H * 0.44;
  
  // Derin siyah-lacivert arka plan (Yüksek kontrast)
  ctx.fillStyle = opts.bg || 'rgba(6, 10, 20, 0.95)';
  ctx.shadowColor = 'rgba(0,0,0,0.85)';
  ctx.shadowBlur = 12;
  ctx.beginPath();
  if (ctx.roundRect) ctx.roundRect(x, H * 0.08, tw, H * 0.84, rr);
  else ctx.rect(x, H * 0.08, tw, H * 0.84);
  ctx.fill();
  
  // Parlak neon çerçeve
  ctx.shadowBlur = 0;
  ctx.lineWidth = 6;
  ctx.strokeStyle = opts.border || 'rgba(255, 211, 77, 0.98)';
  ctx.stroke();
  
  // Net, parıldayan beyaz metin
  ctx.fillStyle = opts.color || '#ffffff';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.shadowColor = '#000000';
  ctx.shadowBlur = 6;
  ctx.fillText(text, W / 2, H * 0.52);
  
  const tex = new THREE.CanvasTexture(c);
  tex.colorSpace = THREE.SRGBColorSpace;
  tex.anisotropy = 8;
  return tex;
}

export function createAvatarBadge(player, opts = {}) {
  const group = new THREE.Group();
  const ring = opts.ring || '#ffd34d';
  const nick = String(player?.nickname || player?.username || player?.uniqueId || opts.fallbackName || 'İzleyici').replace(/^@/, '');
  const url = avatarUrlFor(player);
  const fb = player?.avatarFallback
    ? avatarUrlFor({ ...player, avatar: player.avatarFallback })
    : `/api/tiktok-avatar?user=${encodeURIComponent(nick)}`;
  const avatarTex = createAvatarTexture(url, ring, 512, fb, nick.charAt(0));
  const avatar = new THREE.Sprite(new THREE.SpriteMaterial({
    map: avatarTex,
    depthTest: true,
    depthWrite: false,
    transparent: true
  }));
  const size = opts.size || 0.85;
  avatar.scale.set(size, size, 1);
  avatar.renderOrder = 10;
  group.add(avatar);

  // Kullanıcı İsteği: "topa vuran kişi, onu da kullanıcı adı yazmasına gerek yok, sadece profil fotoğrafı olsa yeter ama diğer herkesin kullanıcı adı da yazsın."
  const showLabel = opts.showLabel !== false && opts.label !== false && opts.label !== null;
  const name = showLabel ? (opts.label ?? `@${nick}`) : null;

  if (name) {
    const labelTex = createLabelTexture(name, { border: ring, size: 62 });
    const label = new THREE.Sprite(new THREE.SpriteMaterial({
      map: labelTex,
      depthTest: true,
      depthWrite: false,
      transparent: true
    }));
    label.scale.set(size * 2.0, size * 2.0 * (140 / 640), 1);
    label.position.y = -size * 0.65;
    label.renderOrder = 11;
    group.add(label);
  }

  group.userData.dispose = () => {
    group.traverse(o => { if (o.isSprite) { o.material.map?.dispose(); o.material.dispose(); } });
  };
  return group;
}
