// ==========================================================================
// KARAKTERLER - Yuvarlatılmış hatlı, iskeletli (rig) futbolcu modelleri
// Yön: karakterin önü +Z. Sağ eli -X tarafındadır.
// ==========================================================================
import * as THREE from 'three';
import { RoundedBoxGeometry } from 'three/addons/geometries/RoundedBoxGeometry.js';

const geoCache = new Map();
export function rbox(w, h, d, r = 0.04, seg = 3) {
  const key = `${w}|${h}|${d}|${r}|${seg}`;
  if (!geoCache.has(key)) geoCache.set(key, new RoundedBoxGeometry(w, h, d, seg, r));
  return geoCache.get(key);
}
const sphereGeo = new THREE.SphereGeometry(1, 16, 12);

const matCache = new Map();
export function stdMat(color, rough = 0.75, metal = 0, extra = {}) {
  const key = `${color}|${rough}|${metal}|${JSON.stringify(extra)}`;
  if (!matCache.has(key)) {
    matCache.set(key, new THREE.MeshStandardMaterial({ color: new THREE.Color(color), roughness: rough, metalness: metal, ...extra }));
  }
  return matCache.get(key);
}

export const SKIN_TONES = ['#f1c7a3', '#e0ac85', '#c98e64', '#a86f48', '#7d4f32', '#f6d4b8', '#d39a72'];
export const HAIR_COLORS = ['#1f140d', '#2b1a10', '#3d2616', '#0d0d0d', '#5a3a1e', '#7a5530', '#141414'];

// --------------------------------------------------------------------------
// FORMA DOKULARI
// --------------------------------------------------------------------------
function drawPattern(ctx, w, h, team, mirror = false) {
  const p = team.primary, s = team.secondary;
  ctx.fillStyle = p;
  ctx.fillRect(0, 0, w, h);
  if (team.pattern === 'halves') {
    ctx.fillStyle = s;
    if (mirror) ctx.fillRect(0, 0, w / 2, h); else ctx.fillRect(w / 2, 0, w / 2, h);
  } else if (team.pattern === 'stripes') {
    const n = 7;
    const sw = w / n;
    ctx.fillStyle = s;
    for (let i = 1; i < n; i += 2) ctx.fillRect(i * sw, 0, sw, h);
  } else if (team.pattern === 'national') {
    ctx.fillStyle = 'rgba(255,255,255,0.10)';
    for (let i = 0; i < 6; i++) ctx.fillRect(0, h * 0.18 + i * h * 0.13, w, h * 0.035);
    ctx.fillStyle = s;
    ctx.fillRect(0, h - h * 0.05, w, h * 0.05);
  } else if (team.pattern === 'keeper') {
    const g = ctx.createLinearGradient(0, 0, w, h);
    g.addColorStop(0, p);
    g.addColorStop(1, s);
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, w, h);
    ctx.strokeStyle = 'rgba(0,0,0,0.18)';
    ctx.lineWidth = 6;
    for (let i = -h; i < w; i += 28) {
      ctx.beginPath(); ctx.moveTo(i, h); ctx.lineTo(i + h, 0); ctx.stroke();
    }
  }
  // Kumaş gölgelendirme
  const shade = ctx.createLinearGradient(0, 0, w, 0);
  shade.addColorStop(0, 'rgba(0,0,0,0.18)');
  shade.addColorStop(0.2, 'rgba(0,0,0,0)');
  shade.addColorStop(0.8, 'rgba(0,0,0,0)');
  shade.addColorStop(1, 'rgba(0,0,0,0.18)');
  ctx.fillStyle = shade;
  ctx.fillRect(0, 0, w, h);
}

function strokeText(ctx, text, x, y, font, fill, stroke, lw) {
  ctx.font = font;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.lineJoin = 'round';
  ctx.lineWidth = lw;
  ctx.strokeStyle = stroke;
  ctx.strokeText(text, x, y);
  ctx.fillStyle = fill;
  ctx.fillText(text, x, y);
}

function fitFont(ctx, text, maxW, size, weight = 900, family = 'Teko, Montserrat, sans-serif') {
  let s = size;
  ctx.font = `${weight} ${s}px ${family}`;
  while (ctx.measureText(text).width > maxW && s > 12) {
    s -= 2;
    ctx.font = `${weight} ${s}px ${family}`;
  }
  return `${weight} ${s}px ${family}`;
}

function contrastOf(hex) {
  const c = new THREE.Color(hex);
  const l = 0.299 * c.r + 0.587 * c.g + 0.114 * c.b;
  return l > 0.55 ? '#111111' : '#ffffff';
}

export function makeJerseyTextures(team, backName, number, opts = {}) {
  const W = 256, H = 320;
  const mk = () => {
    const c = document.createElement('canvas');
    c.width = W; c.height = H;
    return c;
  };
  const textFill = team.text || '#ffffff';
  const textStroke = contrastOf(textFill);

  // ÖN
  const front = mk();
  let ctx = front.getContext('2d');
  drawPattern(ctx, W, H, team, true);
  // yaka
  ctx.fillStyle = team.secondary;
  ctx.beginPath();
  ctx.moveTo(W * 0.36, 0); ctx.quadraticCurveTo(W * 0.5, H * 0.12, W * 0.64, 0); ctx.closePath();
  ctx.fill();
  if (team.pattern === 'national') {
    // Ay yıldız arması
    ctx.fillStyle = '#ffffff';
    ctx.beginPath(); ctx.arc(W * 0.7, H * 0.25, 22, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = team.primary;
    ctx.beginPath(); ctx.arc(W * 0.725, H * 0.25, 18, 0, Math.PI * 2); ctx.fill();
    drawStar(ctx, W * 0.765, H * 0.25, 8, '#ffffff');
  } else {
    ctx.fillStyle = '#ffffff';
    ctx.beginPath(); ctx.arc(W * 0.7, H * 0.24, 20, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = team.secondary; ctx.lineWidth = 5; ctx.stroke();
    strokeText(ctx, team.short || '', W * 0.7, H * 0.245, '900 15px Montserrat, sans-serif', team.secondary === '#ffffff' ? team.primary : team.secondary, '#ffffff', 1);
  }
  // sponsor
  strokeText(ctx, opts.sponsor || 'MNG', W * 0.5, H * 0.5, '900 44px Teko, Montserrat, sans-serif', textFill, textStroke, 5);
  strokeText(ctx, number, W * 0.3, H * 0.25, '900 40px Teko, Montserrat, sans-serif', textFill, textStroke, 5);

  // ARKA
  const back = mk();
  ctx = back.getContext('2d');
  drawPattern(ctx, W, H, team, false);
  ctx.fillStyle = team.secondary;
  ctx.fillRect(W * 0.3, 0, W * 0.4, H * 0.035);
  const name = String(backName || '@MANGAO7TV').toUpperCase().slice(0, 16);
  strokeText(ctx, name, W * 0.5, H * 0.19, fitFont(ctx, name, W * 0.88, 52), textFill, textStroke, 7);
  strokeText(ctx, String(number || '16'), W * 0.5, H * 0.56, '900 170px Teko, Montserrat, sans-serif', textFill, textStroke, 10);

  // YAN
  const side = mk();
  ctx = side.getContext('2d');
  drawPattern(ctx, W, H, team, false);
  ctx.fillStyle = team.secondary;
  ctx.fillRect(W * 0.42, 0, W * 0.16, H);

  const toTex = c => {
    const t = new THREE.CanvasTexture(c);
    t.colorSpace = THREE.SRGBColorSpace;
    t.anisotropy = 8;
    return t;
  };
  return { front: toTex(front), back: toTex(back), side: toTex(side), top: null };
}

function drawStar(ctx, cx, cy, r, color) {
  ctx.fillStyle = color;
  ctx.beginPath();
  for (let i = 0; i < 10; i++) {
    const a = -Math.PI / 2 + i * Math.PI / 5;
    const rr = i % 2 === 0 ? r : r * 0.45;
    ctx.lineTo(cx + Math.cos(a) * rr, cy + Math.sin(a) * rr);
  }
  ctx.closePath();
  ctx.fill();
}

function jerseyMaterials(tex, team) {
  const mk = map => new THREE.MeshStandardMaterial({ map, roughness: 0.62, metalness: 0.0 });
  const plain = new THREE.MeshStandardMaterial({ color: team.primary, roughness: 0.62 });
  // BoxGeometry grupları: +x, -x, +y, -y, +z(ön), -z(arka)
  return [mk(tex.side), mk(tex.side), plain, plain, mk(tex.front), mk(tex.back)];
}

// --------------------------------------------------------------------------
// İNSAN MODELİ (Gelişmiş Atletik Futbolcu ve Kaleci)
// --------------------------------------------------------------------------
export function createHumanoid(opt = {}) {
  const team = opt.team || { primary: '#cccccc', secondary: '#888888', shorts: '#333333', socks: '#ffffff', pattern: 'plain', text: '#fff' };
  const skin = opt.skin || SKIN_TONES[Math.floor(Math.random() * SKIN_TONES.length)];
  const hairColor = opt.hair || HAIR_COLORS[Math.floor(Math.random() * HAIR_COLORS.length)];
  const cast = opt.castShadow !== false;

  const skinMat = stdMat(skin, 0.55);
  const hairMat = stdMat(hairColor, 0.85);
  const shortsMat = stdMat(team.shorts, 0.65);
  const sockMat = stdMat(team.socks, 0.65);
  const bootMat = stdMat(opt.boots || '#111111', 0.3, 0.1);
  const bootSoleMat = stdMat('#f8fafc', 0.25, 0.1);
  const bootSwooshMat = stdMat(team.secondary === '#ffffff' ? team.primary : '#ffffff', 0.4);
  const sleeveMat = new THREE.MeshStandardMaterial({ color: team.primary, roughness: 0.62 });
  const trimMat = stdMat(team.secondary || '#ffffff', 0.6);

  const root = new THREE.Group();
  const body = new THREE.Group();
  root.add(body);

  const hips = new THREE.Group();
  hips.position.y = 0.93;
  body.add(hips);

  const add = (parent, geo, mat, x, y, z) => {
    const m = new THREE.Mesh(geo, mat);
    m.position.set(x, y, z);
    m.castShadow = cast;
    m.receiveShadow = false;
    parent.add(m);
    return m;
  };

  // 1. Şort (Kenar şeritli profesyonel futbol şortu)
  add(hips, rbox(0.48, 0.26, 0.28, 0.07), shortsMat, 0, -0.02, 0);
  // Şort yan şeritleri
  [-0.242, 0.242].forEach(sx => {
    add(hips, rbox(0.015, 0.22, 0.24, 0.01), trimMat, sx, -0.02, 0);
  });

  // 2. Atletik Gövde & Forma
  const torso = new THREE.Group();
  torso.position.y = 0.06;
  hips.add(torso);
  const tex = opt.jerseyTex || makeJerseyTextures(team, opt.backName || '', opt.number || '10', opt);
  const torsoMesh = add(torso, rbox(0.50, 0.64, 0.29, 0.09, 4), jerseyMaterials(tex, team), 0, 0.3, 0);

  // Yaka (V-Neck / Ribbed Collar)
  add(torso, rbox(0.26, 0.05, 0.24, 0.02), trimMat, 0, 0.61, 0.02);

  // 3. Boyun + Kafa
  add(torso, new THREE.CylinderGeometry(0.065, 0.075, 0.11, 10), skinMat, 0, 0.65, 0);
  const head = new THREE.Group();
  head.position.y = 0.70;
  torso.add(head);
  add(head, rbox(0.32, 0.34, 0.31, 0.12, 5), skinMat, 0, 0.17, 0);

  // Saç (Katmanlı modern fade saç stili)
  const hairStyle = opt.hairStyle ?? 1;
  if (hairStyle === 0) {
    add(head, rbox(0.34, 0.15, 0.33, 0.08, 4), hairMat, 0, 0.30, -0.01);
  } else if (hairStyle === 1) {
    add(head, rbox(0.34, 0.14, 0.33, 0.07, 4), hairMat, 0, 0.31, -0.01);
    add(head, rbox(0.33, 0.24, 0.12, 0.05, 3), hairMat, 0, 0.20, -0.12);
  } else {
    add(head, rbox(0.34, 0.10, 0.33, 0.05, 3), hairMat, 0, 0.32, 0);
  }

  // Yüz Detayları
  const eyeMat = stdMat('#151515', 0.25);
  const eyeWhiteMat = stdMat('#ffffff', 0.3);
  // Göz akı + göz bebeği
  [-0.07, 0.07].forEach(ex => {
    const ew = add(head, sphereGeo, eyeWhiteMat, ex, 0.19, 0.156);
    ew.scale.set(0.034, 0.034, 0.015);
    const ep = add(head, sphereGeo, eyeMat, ex, 0.19, 0.165);
    ep.scale.setScalar(0.020);
  });
  const browMat = stdMat(hairColor, 0.85);
  add(head, rbox(0.075, 0.02, 0.02, 0.008, 1), browMat, 0.07, 0.238, 0.16);
  add(head, rbox(0.075, 0.02, 0.02, 0.008, 1), browMat, -0.07, 0.238, 0.16);
  add(head, rbox(0.05, 0.065, 0.05, 0.02, 2), skinMat, 0, 0.15, 0.17);
  add(head, rbox(0.09, 0.018, 0.02, 0.008, 1), stdMat('#7a3b2e', 0.6), 0, 0.085, 0.16);
  // Kulaklar
  add(head, rbox(0.04, 0.08, 0.06, 0.02, 2), skinMat, 0.168, 0.17, 0);
  add(head, rbox(0.04, 0.08, 0.06, 0.02, 2), skinMat, -0.168, 0.17, 0);

  // 4. Kollar (Forma kol manşetleri ve profesyonel kaleci eldiveni)
  const makeArm = side => {
    const sh = new THREE.Group();
    sh.position.set(side * 0.30, 0.54, 0);
    torso.add(sh);

    // Omuz / Üst kol
    add(sh, rbox(0.16, 0.32, 0.16, 0.06), sleeveMat, 0, -0.13, 0);
    // Kol ucu manşet şeridi
    add(sh, rbox(0.165, 0.04, 0.165, 0.02), trimMat, 0, -0.27, 0);

    const el = new THREE.Group();
    el.position.y = -0.29;
    sh.add(el);

    // Ön kol (ten rengi veya uzun kollu)
    add(el, rbox(0.13, 0.27, 0.13, 0.05), opt.longSleeves ? sleeveMat : skinMat, 0, -0.13, 0);

    if (opt.gloves) {
      // PROFESYONEL KALECİ ELDİVENİ
      const gloveColor = opt.gloves || '#f97316';
      const gloveMat = stdMat(gloveColor, 0.45);
      const palmMat = stdMat('#f8fafc', 0.35); // Beyaz latex avuç içi
      const strapMat = stdMat('#0f172a', 0.6); // Bileklik cırt cırtı

      const gloveGroup = new THREE.Group();
      gloveGroup.position.set(0, -0.34, 0);
      el.add(gloveGroup);

      // Ana eldiven gövdesi
      add(gloveGroup, rbox(0.16, 0.18, 0.11, 0.04), gloveMat, 0, 0, 0);
      // Lateks avuç içi pedi (+Z yönünde)
      add(gloveGroup, rbox(0.14, 0.16, 0.03, 0.015), palmMat, 0, 0, 0.05);
      // Parmak dolguları
      [-0.05, -0.018, 0.018, 0.05].forEach(fx => {
        add(gloveGroup, rbox(0.028, 0.06, 0.05, 0.012), gloveMat, fx, -0.09, 0);
      });
      // Başparmak
      add(gloveGroup, rbox(0.04, 0.07, 0.05, 0.015), gloveMat, side * 0.09, -0.04, 0.02);
      // Bilek cırt cırt bandı
      add(gloveGroup, rbox(0.168, 0.05, 0.125, 0.02), strapMat, 0, 0.08, 0);
    } else {
      // Futbolcu eli
      const handGroup = new THREE.Group();
      handGroup.position.set(0, -0.31, 0);
      el.add(handGroup);
      add(handGroup, rbox(0.11, 0.13, 0.07, 0.03), skinMat, 0, 0, 0);
      // Başparmak
      add(handGroup, rbox(0.035, 0.055, 0.04, 0.015), skinMat, side * 0.06, 0.01, 0.02);
    }
    return { sh, el };
  };
  const L = makeArm(1), R = makeArm(-1);

  // 5. Bacaklar, Çoraplar & Kramponlar (Soccer Cleats with Studs)
  const makeLeg = side => {
    const hp = new THREE.Group();
    hp.position.set(side * 0.12, -0.04, 0);
    hips.add(hp);

    // Üst bacak (şort altı)
    add(hp, rbox(0.17, 0.24, 0.18, 0.06), shortsMat, 0, -0.08, 0);
    // Çıplak uyluk
    add(hp, rbox(0.155, 0.30, 0.155, 0.06), skinMat, 0, -0.27, 0);

    const kn = new THREE.Group();
    kn.position.y = -0.42;
    hp.add(kn);

    // Profesyonel futbol çorabı
    add(kn, rbox(0.15, 0.40, 0.15, 0.06), sockMat, 0, -0.20, 0);
    // Diz altı kıvrık çorap manşeti (Turnover Cuff)
    add(kn, rbox(0.158, 0.07, 0.158, 0.025), trimMat, 0, -0.04, 0);

    // AYAK & KRAMPON (Molded Football Boot)
    const ft = new THREE.Group();
    ft.position.y = -0.42;
    kn.add(ft);

    const bootGroup = new THREE.Group();
    ft.add(bootGroup);

    // Krampon ana gövdesi
    add(bootGroup, rbox(0.145, 0.10, 0.30, 0.04), bootMat, 0, -0.035, 0.05);
    // Yan spor çizgisi / Swoosh
    [-0.075, 0.075].forEach(bx => {
      add(bootGroup, rbox(0.01, 0.03, 0.16, 0.01), bootSwooshMat, bx, -0.03, 0.05);
    });
    // Krampon beyaz/neon taban plakası (Soleplate)
    add(bootGroup, rbox(0.146, 0.02, 0.31, 0.015), bootSoleMat, 0, -0.09, 0.05);
    // Krampon çivileri (Studs)
    const studGeo = new THREE.CylinderGeometry(0.014, 0.010, 0.022, 8);
    const studMat = stdMat('#cbd5e1', 0.2, 0.3);
    [[-0.04, 0.14], [0.04, 0.14], [-0.04, 0.0], [0.04, 0.0], [-0.04, -0.06], [0.04, -0.06]].forEach(([sx, sz]) => {
      add(bootGroup, studGeo, studMat, sx, -0.105, sz);
    });

    return { hp, kn, ft };
  };
  const LL = makeLeg(1), RL = makeLeg(-1);

  const rig = {
    root, body, hips, torso, head,
    lShoulder: L.sh, lElbow: L.el, rShoulder: R.sh, rElbow: R.el,
    lHip: LL.hp, lKnee: LL.kn, lFoot: LL.ft, rHip: RL.hp, rKnee: RL.kn, rFoot: RL.ft,
    torsoMesh, sleeveMat, shortsMat, sockMat, team
  };

  rig.setKit = (newTeam, backName, number, o = {}) => {
    const t = makeJerseyTextures(newTeam, backName, number, o);
    const old = torsoMesh.material;
    torsoMesh.material = jerseyMaterials(t, newTeam);
    if (Array.isArray(old)) old.forEach(m => { m.map?.dispose(); m.dispose(); });
    sleeveMat.color.set(newTeam.primary);
    rig.shortsMatInstance = rig.shortsMatInstance || null;
    hips.traverse(o2 => {
      if (o2.isMesh && o2.material === shortsMat) o2.material = stdMat(newTeam.shorts, 0.65);
    });
    root.traverse(o2 => {
      if (o2.isMesh && o2.material === sockMat) o2.material = stdMat(newTeam.socks, 0.65);
    });
    rig.team = newTeam;
  };

  return rig;
}

// --------------------------------------------------------------------------
// RESMİ HAKEM MODELİ (Siyah Formalı, Düdüklü, Kartlı Saha Hakemi)
// --------------------------------------------------------------------------
export function createReferee() {
  const ref = createHumanoid({
    team: {
      primary: '#111827',
      secondary: '#f9fafb',
      shorts: '#0f172a',
      socks: '#111827',
      pattern: 'stripes'
    },
    backName: 'HAKEM',
    number: 'FIFA',
    boots: '#09090b',
    skin: '#e0ac85',
    hair: '#1c1917'
  });

  // Göğüste gümüş düdük
  const whistleGeo = new THREE.CylinderGeometry(0.016, 0.02, 0.04, 10);
  const whistleMat = stdMat('#e2e8f0', 0.2, 0.9);
  const whistle = new THREE.Mesh(whistleGeo, whistleMat);
  whistle.rotation.x = Math.PI / 3;
  whistle.position.set(0, 0.44, 0.16);
  ref.torso.add(whistle);

  // Göğüs cebinden çıkan sarı ve kırmızı kart
  const yellowCard = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.05, 0.005), stdMat('#facc15', 0.3));
  yellowCard.position.set(0.12, 0.46, 0.16);
  yellowCard.rotation.z = -0.15;
  ref.torso.add(yellowCard);

  const redCard = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.05, 0.005), stdMat('#ef4444', 0.3));
  redCard.position.set(0.14, 0.45, 0.158);
  redCard.rotation.z = 0.1;
  ref.torso.add(redCard);

  return ref;
}

// --------------------------------------------------------------------------
// POZ SİSTEMİ
// --------------------------------------------------------------------------
const JOINTS = ['hips', 'torso', 'head', 'lShoulder', 'lElbow', 'rShoulder', 'rElbow', 'lHip', 'lKnee', 'lFoot', 'rHip', 'rKnee', 'rFoot'];

export function blendPose(rig, pose, k) {
  if (!rig || !pose) return;
  for (const j of JOINTS) {
    const target = pose[j];
    const obj = rig[j];
    if (!obj || !target) continue;
    const tx = target?.[0] ?? 0, ty = target?.[1] ?? 0, tz = target?.[2] ?? 0;
    obj.rotation.x += (tx - obj.rotation.x) * k;
    obj.rotation.y += (ty - obj.rotation.y) * k;
    obj.rotation.z += (tz - obj.rotation.z) * k;
  }
  if (pose.hipsY !== undefined && rig.hips) rig.hips.position.y += (pose.hipsY - rig.hips.position.y) * k;
}

export const POSES = {
  stand: { lShoulder: [0, 0, 0.12], rShoulder: [0, 0, -0.12], lElbow: [-0.15, 0, 0], rElbow: [-0.15, 0, 0], hipsY: 0.93 },
  run: {
    torso: [0.18, -0.12, 0], head: [-0.1, 0.08, 0],
    lShoulder: [-0.65, 0, 0.3], rShoulder: [0.65, 0, -0.3],
    lHip: [0.7, 0, 0.05], lKnee: [0.6, 0, 0],
    rHip: [-0.65, 0, -0.05], rKnee: [0.15, 0, 0],
    hipsY: 0.93
  },
  arms_up: { lShoulder: [-0.2, 0, 2.7], rShoulder: [-0.2, 0, -2.7], lElbow: [-0.2, 0, 0], rElbow: [-0.2, 0, 0], hipsY: 0.93 },
  goal_cheer: {
    torso: [-0.12, 0, 0], head: [-0.3, 0, 0],
    lShoulder: [-0.1, 0, 2.85], rShoulder: [-0.1, 0, -2.85],
    lElbow: [0, 0, 0], rElbow: [0, 0, 0],
    lHip: [0, 0, 0.1], rHip: [0, 0, -0.1],
    hipsY: 0.98
  },
  run_stride_1: {
    torso: [0.18, -0.12, 0], head: [-0.1, 0.08, 0],
    lShoulder: [-0.65, 0, 0.3], rShoulder: [0.65, 0, -0.3],
    lHip: [0.7, 0, 0.05], lKnee: [0.6, 0, 0],
    rHip: [-0.65, 0, -0.05], rKnee: [0.15, 0, 0],
    hipsY: 0.93
  },
  run_stride_2: {
    torso: [0.18, 0.12, 0], head: [-0.1, -0.08, 0],
    lShoulder: [0.65, 0, 0.3], rShoulder: [-0.65, 0, -0.3],
    lHip: [-0.65, 0, -0.05], lKnee: [0.15, 0, 0],
    rHip: [0.7, 0, 0.05], rKnee: [0.6, 0, 0],
    hipsY: 0.93
  },
