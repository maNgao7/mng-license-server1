import express from "express";
import http from "http";
import path from "path";
import { fileURLToPath } from "url";
import fs from "fs";
import os from "os";
import { WebSocketServer } from "ws";
import { TikTokLiveConnection, WebcastEvent } from "tiktok-live-connector";
import puppeteer from "puppeteer";
import launcherWidgetLinks from "./launcher-widget-links.cjs";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

function widgetEventPost(route, payload) {
  const port = Number(process.env.MNG_WIDGET_PORT);
  const key = String(process.env.MNG_WIDGET_ACCESS_KEY || "");
  if (!Number.isInteger(port) || port < 1 || port > 65535 || !/^[a-f0-9]{32}$/.test(key)) return;
  try {
    const body = JSON.stringify(payload);
    const req = http.request({
      hostname: "127.0.0.1", port, path: route + "?key=" + encodeURIComponent(key),
      method: "POST",
      headers: { "Content-Type": "application/json", "Content-Length": Buffer.byteLength(body) },
      timeout: 800
    }, response => response.resume());
    req.on("timeout", () => req.destroy());
    req.on("error", () => {});
    req.end(body);
  } catch {}
}

function widgetGiftPost(payload) {
  widgetEventPost("/api/widget/gift", payload);
}

function widgetLikePost(payload) {
  widgetEventPost("/api/widget/like", payload);
}

// =====================================================================
// EULERSTREAM İMZA API ANAHTARI
// ---------------------------------------------------------------------
// tiktok-live-connector, TikTok'a bağlanırken hem isteği "imzalamak"
// hem de yayının Room ID'sini bulmak için üçüncü parti bir servis
// (EulerStream) kullanıyor. API anahtarı OLMADAN kullanılan ücretsiz/
// anonim yol artık TikTok tarafından çoğu zaman engelleniyor — az önce
