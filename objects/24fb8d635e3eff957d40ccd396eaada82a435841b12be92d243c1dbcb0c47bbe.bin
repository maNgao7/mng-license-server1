@import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Lilita+One&display=swap');

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  user-select: none;
}

html, body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #1a1a24;
  font-family: 'Fredoka', 'Segoe UI', system-ui, sans-serif;
  color: #fff;
}

#game-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  cursor: none; /* Custom carnival reticle */
}

#three-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* =====================================================================
   MUD SPLASH & BOMB OVERLAYS (Ördek Parkurunu Kaplayan & Aşağıya Akan Çamur)
   ===================================================================== */
.mud-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 9999;
  overflow: hidden;
}

.giant-mud-splat {
  position: absolute;
  top: 80px; /* Üst skor panosunu kapatmaz, ördeklerin yüzdüğü parkurun üstünü tamamen örter */
  left: 0;
  width: 100%;
  height: calc(100vh - 120px);
  pointer-events: none;
  filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.85));
  animation: mudSplatterIn 0.35s cubic-bezier(0.12, 0.95, 0.2, 1) forwards;
}

@keyframes mudSplatterIn {
  0% { opacity: 0; transform: translateY(-40px) scale(0.96); }
  100% { opacity: 1; transform: translateY(0) scale(1.0); }
}

/* Çamur Süresi Bittiğinde Süzülüp Gitme Animasyonu (Aksın Gitsin!) */
.giant-mud-splat.slide-out {
  animation: mudSlideOffScreen 0.75s cubic-bezier(0.55, 0.055, 0.675, 0.19) forwards !important;
}

@keyframes mudSlideOffScreen {
  0% { transform: translateY(0); opacity: 1; }
  100% { transform: translateY(115vh); opacity: 0; }
}

/* Aşağıya Doğru Sürekli Süzülen Akışkan Çamur Şeritleri */
.mud-drip-flow {
  animation: mudFlowingDown 1.8s ease-in-out infinite alternate;
}
@keyframes mudFlowingDown {
  0% { transform: translateY(0); }
  50% { transform: translateY(18px) scaleY(1.08); }
  100% { transform: translateY(38px) scaleY(1.18); }
}

.mud-drops-falling {
  animation: mudDropsFalling 2.2s ease-in infinite;
}
@keyframes mudDropsFalling {
  0% { transform: translateY(0); opacity: 1; }
  80% { transform: translateY(140px); opacity: 0.95; }
  100% { transform: translateY(240px); opacity: 0; }
}

@keyframes giantMudAnim {
  0% { opacity: 0; transform: scale(0.25) rotate(-6deg); }
  60% { opacity: 0.98; transform: scale(1.05) rotate(1deg); }
  100% { opacity: 0.98; transform: scale(1.0) rotate(0deg); }
}

/* Fluid Mud Dripping Stream Animations */
.mud-drip-path {
  animation: mudDripFlow 3.2s ease-in-out infinite alternate;
}
@keyframes mudDripFlow {
  0% { transform: translateY(0); }
  50% { transform: translateY(22px) scaleY(1.06); }
  100% { transform: translateY(48px) scaleY(1.15); }
}

.mud-drop-slide {
  animation: mudDropSlide 4.5s ease-in-out infinite;
}
@keyframes mudDropSlide {
  0% { transform: translateY(0); opacity: 0.9; }
  60% { transform: translateY(60px); opacity: 0.95; }
  100% { transform: translateY(140px); opacity: 0; }
}

/* Mud Splash Center Realtime Countdown Badge */
.mud-center-badge {
  position: absolute;
  top: 48%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: linear-gradient(135deg, rgba(46, 22, 8, 0.98), rgba(20, 8, 2, 0.98));
  border: 3.5px solid #ffcc00;
  border-radius: 28px;
  padding: 16px 28px;
  display: flex;
  align-items: center;
  gap: 18px;
  box-shadow: 0 14px 50px rgba(0, 0, 0, 0.95), 0 0 35px rgba(255, 204, 0, 0.55), inset 0 0 15px rgba(255, 204, 0, 0.2);
  z-index: 10001;
  pointer-events: none;
  animation: mudBadgePop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes mudBadgePop {
  0% { transform: translate(-50%, -50%) scale(0.6); opacity: 0; }
  100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
}

.mud-badge-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.mud-badge-visual-pair {
  position: relative;
  width: 62px;
  height: 62px;
  background: radial-gradient(circle, rgba(255, 235, 59, 0.25) 0%, rgba(20, 10, 5, 0.9) 75%);
  border: 2.5px solid #ffcc00;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.7), 0 0 15px rgba(255, 204, 0, 0.4);
}

.mud-badge-gift-img {
  width: 46px;
  height: 46px;
  object-fit: contain;
  filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.8));
  animation: giftWiggle 1.2s infinite alternate ease-in-out;
}

@keyframes giftWiggle {
  0% { transform: scale(0.95) rotate(-6deg); }
  100% { transform: scale(1.08) rotate(6deg); }
}

.mud-badge-sender-avatar {
  position: absolute;
  bottom: -4px;
  right: -4px;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 2px solid #ffeb3b;
  object-fit: cover;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.85);
  background: #111;
}

.mud-badge-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
}

.mud-badge-user-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 2px;
}

.mud-badge-user {
  font-size: 14.5px;
  font-weight: 800;
  color: #ffea00;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.mud-badge-user-action {
  font-size: 12.5px;
  font-weight: 700;
  color: #f1f5f9;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
}

.mud-badge-title {
  font-family: 'Lilita One', cursive;
  font-size: 23px;
  color: #ffffff;
  letter-spacing: 0.8px;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
  line-height: 1.15;
}

.mud-badge-gift-name {
  color: #ff9f1c;
  text-shadow: 0 0 12px rgba(255, 159, 28, 0.7);
}

.mud-badge-sub {
  font-size: 13.5px;
  font-weight: 700;
  color: #cbd5e1;
  margin-top: 4px;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
}

#mud-countdown-text {
  color: #00e676;
  font-family: 'Lilita One', cursive;
  font-size: 16px;
  letter-spacing: 0.5px;
}

.bomb-flash {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 0, 0, 0.55);
  pointer-events: none;
  z-index: 90;
  opacity: 0;
  transition: opacity 0.1s;
}

.bomb-flash.active {
  opacity: 1;
}

.screen-shake {
  animation: screenShakeAnim 0.4s ease-out;
}

@keyframes screenShakeAnim {
  0% { transform: translate(0, 0); }
  20% { transform: translate(-14px, 10px); }
  40% { transform: translate(12px, -8px); }
  60% { transform: translate(-8px, 6px); }
  80% { transform: translate(6px, -4px); }
  100% { transform: translate(0, 0); }
}

/* =====================================================================
   HUD & CARNIVAL OVERLAYS
   ===================================================================== */
.hud-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 10;
}

.hud-interactive {
  pointer-events: auto;
}

/* Custom Reticle */
#crosshair {
  position: absolute;
  width: 48px;
  height: 48px;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 9999;
  transition: transform 0.05s ease-out, filter 0.15s ease;
}

#crosshair.aiming-duck {
  filter: drop-shadow(0 0 10px #ff3366);
  transform: translate(-50%, -50%) scale(1.15);
}

#crosshair.empty-ammo {
  filter: drop-shadow(0 0 8px #ff4444);
}

#crosshair.jammed {
  filter: drop-shadow(0 0 14px #ff1744);
}

#crosshair.rapid {
  filter: drop-shadow(0 0 16px #00e5ff) drop-shadow(0 0 8px #ffea00);
}

.crosshair-jam-icon, .crosshair-rapid-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 24px;
  display: none;
}

#crosshair.jammed .crosshair-jam-icon {
  display: block;
  animation: jamShake 0.4s infinite alternate;
}

#crosshair.rapid .crosshair-rapid-icon {
  display: block;
  animation: rapidPulse 0.3s infinite alternate;
}

@keyframes jamShake {
  0% { transform: translate(-50%, -50%) rotate(-8deg); }
  100% { transform: translate(-50%, -50%) rotate(8deg); }
}

@keyframes rapidPulse {
  0% { transform: translate(-50%, -50%) scale(0.9); }
  100% { transform: translate(-50%, -50%) scale(1.2); }
}

/* Top Banner (Score & Level) */
.top-bar {
  position: absolute;
  top: 14px;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 0 24px;
}

.brand-badge {
  display: flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, rgba(20, 20, 35, 0.88), rgba(40, 20, 30, 0.88));
  border: 2px solid #ffcc00;
  border-radius: 30px;
  padding: 8px 18px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4), 0 0 12px rgba(255, 204, 0, 0.3);
  backdrop-filter: blur(8px);
}

.brand-icon {
  font-size: 26px;
  animation: duckWaddle 2s infinite ease-in-out;
}

@keyframes duckWaddle {
  0%, 100% { transform: rotate(-6deg); }
  50% { transform: rotate(6deg); }
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-family: 'Lilita One', cursive;
  font-size: 20px;
  letter-spacing: 1px;
  color: #ffde59;
  text-shadow: 0 2px 4px rgba(0,0,0,0.6);
}

.brand-sub {
  font-size: 11px;
  color: #ffd180;
  font-weight: 600;
  letter-spacing: 0.5px;
}

/* Center Score & Target Plaque (Enlarged for Streams & Lowered) */
.score-plaque {
  position: absolute;
  left: 50%;
  top: 72px;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 50;
  pointer-events: auto;
}

.plaque-body {
  background: linear-gradient(180deg, #d32f2f 0%, #9a0007 100%);
  border: 3.5px solid #ffeb3b;
  border-radius: 26px;
  padding: 10px 38px 12px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.75), inset 0 2px 6px rgba(255, 255, 255, 0.5), 0 0 25px rgba(255, 235, 59, 0.45);
  text-align: center;
  min-width: 490px;
  pointer-events: auto;
}

.plaque-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22px;
}

.score-column {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.plaque-label {
  font-size: 11px;
  font-weight: 700;
  color: #ffeb3b;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.plaque-value {
  font-family: 'Lilita One', cursive;
  font-size: 38px;
  line-height: 1;
  color: #ffffff;
  text-shadow: 0 3px 6px rgba(0,0,0,0.7), 0 0 12px rgba(255, 255, 255, 0.5);
}

.round-divider {
  width: 2.5px;
  height: 44px;
  background: rgba(255, 235, 59, 0.5);
}

.round-column {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 3px;
}

.round-timer-box {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: 'Lilita One', cursive;
  font-size: 22px;
  color: #ffea00;
  text-shadow: 0 2px 4px rgba(0,0,0,0.6);
}

.timer-pause-btn {
  background: rgba(255, 204, 0, 0.25);
  border: 1.5px solid rgba(255, 204, 0, 0.7);
  border-radius: 10px;
  color: #ffde59;
  font-size: 15px;
  padding: 4px 10px;
  cursor: pointer;
  transition: transform 0.12s, background 0.15s, border-color 0.15s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  user-select: none;
  pointer-events: auto;
  z-index: 60;
}

.timer-pause-btn:hover {
  background: rgba(255, 204, 0, 0.45);
  border-color: #ffde59;
  transform: scale(1.08);
}

.timer-pause-btn.paused {
  background: #e63946;
  border-color: #ff4d6d;
  color: #fff;
  animation: pausePulse 1s infinite alternate;
}

@keyframes pausePulse {
  0% { box-shadow: 0 0 4px #e63946; transform: scale(1); }
  100% { box-shadow: 0 0 14px #ff4d6d; transform: scale(1.08); }
}

#round-timer.paused {
  color: #ff9f1c;
  animation: timerBlink 1s infinite alternate;
}

@keyframes timerBlink {
  0% { opacity: 0.45; }
  100% { opacity: 1; }
}

.target-box {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  font-weight: 700;
  color: #fff;
}

.target-counter {
  color: #80d8ff;
  font-family: 'Lilita One', cursive;
  font-size: 16px;
}

.target-progress-track {
  width: 100%;
  height: 8px;
  background: rgba(0,0,0,0.45);
  border-radius: 5px;
  margin-top: 6px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.25);
}

.target-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffeb3b, #00e676);
  border-radius: 5px;
  transition: width 0.3s ease;
}

.plaque-footer-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-top: 4px;
}

.hit-ratio-pill {
  font-size: 11px;
  background: rgba(0,0,0,0.4);
  padding: 2px 10px;
  border-radius: 10px;
  color: #ffe082;
  font-weight: 600;
}

/* Quick Connect Pill (Top Right) */
.top-right-group {
  display: flex;
  align-items: center;
  gap: 10px;
}

.quick-connect-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(18, 18, 28, 0.92);
  border: 1.5px solid #ffcc00;
  border-radius: 24px;
  padding: 4px 10px;
  backdrop-filter: blur(8px);
  box-shadow: 0 4px 14px rgba(0,0,0,0.4);
}

.quick-tiktok-input {
  background: transparent;
  border: none;
  outline: none;
  color: #fff;
  font-family: inherit;
  font-size: 12px;
  font-weight: 600;
  width: 110px;
}
.quick-tiktok-input::placeholder { color: #888; }

.quick-connect-btn {
  background: #e63946;
  border: none;
  border-radius: 14px;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 700;
  color: #fff;
  cursor: pointer;
  transition: background 0.15s, transform 0.1s;
}
.quick-connect-btn:hover { background: #ff4d6d; }
.quick-connect-btn.connected {
  background: #2ec4b6;
}

.status-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #ff5252;
}

.status-dot.connected {
  background: #00e676;
  box-shadow: 0 0 8px #00e676;
}

.icon-btn {
  background: linear-gradient(135deg, rgba(40, 40, 60, 0.9), rgba(25, 25, 40, 0.9));
  border: 1.5px solid #ffcc00;
  border-radius: 12px;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17px;
  color: #fff;
  cursor: pointer;
  box-shadow: 0 4px 10px rgba(0,0,0,0.3);
  transition: transform 0.15s, background 0.15s, border-color 0.15s;
}

.icon-btn:hover {
  transform: scale(1.08);
  border-color: #ffe082;
  background: rgba(60, 60, 90, 0.9);
}

.icon-btn:active {
  transform: scale(0.95);
}

/* Gun Jam Alert Banner (Centered on Screen with Dramatic Alarm Effect) */
#jam-banner {
  position: absolute;
  top: 48%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  background: linear-gradient(135deg, rgba(220, 20, 60, 0.96) 0%, rgba(138, 3, 3, 0.98) 100%);
  border: 4px solid #ffeb3b;
  border-radius: 28px;
  padding: 18px 42px;
  display: flex;
  align-items: center;
  gap: 20px;
  box-shadow: 0 0 50px rgba(220, 20, 60, 0.9), 0 0 25px #ffeb3b, inset 0 0 20px rgba(255, 235, 59, 0.3);
  opacity: 0;
  pointer-events: none;
  transition: transform 0.28s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.2s;
  z-index: 999;
}

#jam-banner.visible {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1.08);
  animation: jamPulse 0.8s infinite alternate ease-in-out;
}

@keyframes jamPulse {
  0% { box-shadow: 0 0 40px rgba(220, 20, 60, 0.8), 0 0 20px #ffeb3b; }
  100% { box-shadow: 0 0 70px rgba(255, 50, 50, 1), 0 0 35px #ffea00; }
}

.jam-icon {
  font-size: 44px;
  animation: jamWiggle 0.4s infinite alternate;
}

@keyframes jamWiggle {
  0% { transform: rotate(-12deg) scale(0.95); }
  100% { transform: rotate(12deg) scale(1.1); }
}

.jam-text-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.jam-title {
  font-family: 'Lilita One', cursive;
  font-size: 28px;
  color: #ffeb3b;
  letter-spacing: 1.5px;
  text-shadow: 0 3px 10px rgba(0, 0, 0, 0.7);
}

.jam-sub {
  font-size: 15px;
  font-weight: 700;
  color: #ffffff;
  margin-top: 4px;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
}

/* Rapid Fire Banner (Upper Center - Beneath Plaque) */
#rapid-fire-banner {
  position: absolute;
  top: 148px;
  left: 50%;
  transform: translateX(-50%) scale(0.7);
  background: linear-gradient(135deg, #00b4d8 0%, #ffb703 100%);
  border: 3.5px solid #fff;
  border-radius: 26px;
  padding: 10px 32px;
  display: flex;
  align-items: center;
  gap: 14px;
  box-shadow: 0 10px 30px rgba(0, 180, 216, 0.8), 0 0 25px #ffb703;
  opacity: 0;
  pointer-events: none;
  transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.2s;
  z-index: 85;
}

#rapid-fire-banner.visible {
  opacity: 1;
  transform: translateX(-50%) scale(1);
}

.rapid-text-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.rapid-title {
  font-family: 'Lilita One', cursive;
  font-size: 22px;
  color: #ffffff;
  letter-spacing: 1px;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
}

.rapid-sub {
  font-size: 13.5px;
  font-weight: 700;
  color: #111;
  background: rgba(255, 255, 255, 0.9);
  padding: 2px 12px;
  border-radius: 12px;
  margin-top: 3px;
}

.rapid-icon {
  font-size: 32px;
  animation: rapidWiggle 0.4s infinite alternate;
}

@keyframes rapidWiggle {
  0% { transform: scale(0.9); }
  100% { transform: scale(1.2); }
}

.rapid-text-wrap {
  display: flex;
  flex-direction: column;
}

.rapid-title {
  font-family: 'Lilita One', cursive;
  font-size: 22px;
  color: #fff;
  letter-spacing: 1px;
  text-shadow: 0 2px 4px rgba(0,0,0,0.6);
}

.rapid-sub {
  font-size: 13px;
  font-weight: 700;
  color: #1a1a24;
}

/* Streak / Combo Banner (Center) */
#streak-banner {
  position: absolute;
  top: 110px;
  left: 50%;
  transform: translateX(-50%) scale(0.5);
  opacity: 0;
  pointer-events: none;
  text-align: center;
  transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.2s ease;
  z-index: 20;
}

#streak-banner.visible {
  opacity: 1;
  transform: translateX(-50%) scale(1);
}

.streak-text {
  font-family: 'Lilita One', cursive;
  font-size: 36px;
  background: linear-gradient(180deg, #ffea00 0%, #ff6d00 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 4px 8px rgba(0,0,0,0.8)) drop-shadow(0 0 15px rgba(255, 179, 0, 0.6));
  letter-spacing: 2px;
}

.streak-sub {
  font-size: 13px;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  margin-top: -4px;
}

/* Escape Banner (Permanently Hidden as Requested by User) */
#escape-banner {
  display: none !important;
  visibility: hidden !important;
  pointer-events: none !important;
}

.escape-pill {
  display: none !important;
  visibility: hidden !important;
}

@keyframes escapeFade {
  0% { opacity: 0; transform: translateX(20px); }
  15% { opacity: 1; transform: translateX(0); }
  85% { opacity: 1; transform: translateX(0); }
  100% { opacity: 0; transform: translateY(-10px); }
}

/* Bottom Ammo Clip (10 Corks with Auto-Reload) */
.bottom-left-group {
  position: absolute;
  bottom: 24px;
  left: 28px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ammo-clip-box {
  background: linear-gradient(135deg, rgba(30, 20, 20, 0.92), rgba(50, 30, 20, 0.92));
  border: 2px solid #d4a373;
  border-radius: 18px;
  padding: 8px 14px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6), inset 0 2px 4px rgba(255, 255, 255, 0.2);
  display: flex;
  flex-direction: column;
  gap: 6px;
  backdrop-filter: blur(6px);
}

.ammo-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.ammo-label {
  font-family: 'Lilita One', cursive;
  font-size: 12px;
  color: #faedcd;
  letter-spacing: 1px;
}

.ammo-auto-tag {
  font-size: 9px;
  font-weight: 700;
  color: #00e676;
  letter-spacing: 0.5px;
}

.cork-slots {
  display: flex;
  align-items: center;
  gap: 5px;
}

.cork-slot {
  width: 12px;
  height: 32px;
  background: rgba(0, 0, 0, 0.45);
  border: 1.5px solid rgba(212, 163, 115, 0.5);
  border-radius: 5px;
  position: relative;
  overflow: hidden;
  transition: transform 0.15s, opacity 0.15s;
}

.cork-bullet {
  position: absolute;
  top: 2px;
  left: 2px;
  right: 2px;
  bottom: 2px;
  background: linear-gradient(180deg, #d4a373 0%, #bc6c25 60%, #8b4513 100%);
  border-radius: 3px;
  box-shadow: inset 0 2px 3px rgba(255, 255, 255, 0.4);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.cork-slot.spent .cork-bullet {
  transform: translateY(120%);
  opacity: 0;
}

.ammo-warning {
  font-family: 'Lilita One', cursive;
  font-size: 11px;
  color: #ff5252;
  text-shadow: 0 1px 3px rgba(0,0,0,0.8);
  animation: pulseBlink 0.6s infinite alternate;
  display: none;
}

.ammo-warning.active {
  display: block;
}

@keyframes pulseBlink {
  0% { opacity: 0.4; transform: scale(0.95); }
  100% { opacity: 1; transform: scale(1.05); }
}

/* Bottom Right Reload Button */
.bottom-right-group {
  position: absolute;
  bottom: 24px;
  right: 28px;
  display: flex;
  align-items: center;
  gap: 14px;
}

.reload-btn {
  background: linear-gradient(180deg, #ffb703 0%, #fb8500 100%);
  border: 2.5px solid #fff;
  border-radius: 20px;
  padding: 10px 22px;
  font-family: 'Lilita One', cursive;
  font-size: 16px;
  color: #1a1a24;
  letter-spacing: 1px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5), inset 0 2px 4px rgba(255, 255, 255, 0.5);
  transition: transform 0.15s, box-shadow 0.15s;
}

.reload-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 8px 22px rgba(251, 133, 0, 0.6);
}

.reload-btn:active {
  transform: scale(0.96);
}

.reload-key-tag {
  background: rgba(0, 0, 0, 0.25);
  border-radius: 6px;
  padding: 2px 7px;
  font-size: 12px;
  font-family: 'Fredoka', sans-serif;
  font-weight: 700;
}

/* Floating Duck Hit Popup */
.floating-hit-toast {
  position: absolute;
  pointer-events: none;
  font-family: 'Lilita One', cursive;
  font-size: 26px;
  color: #fff;
  text-shadow: 0 3px 6px rgba(0,0,0,0.8), 0 0 12px rgba(255, 215, 0, 0.8);
  transform: translate(-50%, -50%);
  animation: floatUpAndFade 1.1s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
  z-index: 50;
  white-space: nowrap;
}

.floating-hit-toast.boss-hit {
  font-size: 38px;
  color: #ff007f;
  text-shadow: 0 4px 10px rgba(0,0,0,0.9), 0 0 20px #ff00ff;
}

.floating-hit-toast.bomb-hit {
  font-size: 40px;
  color: #ff1744;
  text-shadow: 0 4px 12px rgba(0,0,0,0.9), 0 0 25px #ff1744;
}

@keyframes floatUpAndFade {
  0% {
    opacity: 0;
    transform: translate(-50%, -20%) scale(0.5);
  }
  20% {
    opacity: 1;
    transform: translate(-50%, -60%) scale(1.25);
  }
  60% {
    opacity: 1;
    transform: translate(-50%, -100%) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -140%) scale(0.8);
  }
}

/* Live Gift / Interaction Toast Notifications (Sağ Tarafta, Ekran Ortasını Kapatmaz) */
#toast-container {
  position: absolute;
  top: 132px;
  right: 28px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: flex-end;
  pointer-events: none;
  z-index: 40;
}

.gift-toast {
  background: linear-gradient(135deg, rgba(20, 20, 35, 0.94), rgba(35, 25, 45, 0.94));
  border: 1.5px solid #ffcc00;
  border-radius: 20px;
  padding: 8px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.65), 0 0 15px rgba(255, 204, 0, 0.35);
  animation: toastSlideRight 3.2s cubic-bezier(0.1, 0.9, 0.2, 1) forwards;
  max-width: 340px;
  user-select: none;
}

.toast-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1.5px solid #ffeb3b;
  object-fit: cover;
}

.toast-info {
  display: flex;
  flex-direction: column;
}

.toast-user {
  font-size: 12px;
  font-weight: 700;
  color: #ffeb3b;
}

.toast-msg {
  font-size: 11px;
  color: #fff;
}

@keyframes toastSlideRight {
  0% { opacity: 0; transform: translateX(60px) scale(0.92); }
  8% { opacity: 1; transform: translateX(0) scale(1); }
  88% { opacity: 1; transform: translateX(0) scale(1); }
  100% { opacity: 0; transform: translateX(60px) scale(0.92); }
}

/* =====================================================================
   LOBBY / START MODAL (SCREEN CENTER BEFORE START)
   ===================================================================== */
.lobby-modal {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(12, 12, 22, 0.88);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 150;
  backdrop-filter: blur(10px);
}

.lobby-modal.open {
  display: flex;
}

.lobby-card {
  background: linear-gradient(135deg, #1c182c 0%, #2a1b32 100%);
  border: 3.5px solid #ffea00;
  border-radius: 32px;
  padding: 30px 40px;
  text-align: center;
  box-shadow: 0 16px 60px rgba(0,0,0,0.9), 0 0 35px rgba(255, 234, 0, 0.4);
  max-width: 580px;
  width: 95%;
  animation: cardPop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.lobby-download-wrap {
  margin-top: 20px;
  width: 100%;
}

.lobby-download-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  background: linear-gradient(135deg, rgba(38, 25, 48, 0.95), rgba(52, 22, 38, 0.95));
  border: 2px dashed #ffcc00;
  border-radius: 20px;
  padding: 12px 18px;
  text-decoration: none;
  cursor: pointer;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45), inset 0 1px 2px rgba(255, 235, 59, 0.2);
  transition: transform 0.15s, border-color 0.15s, background 0.15s, box-shadow 0.15s;
}

.lobby-download-btn:hover {
  transform: translateY(-2px) scale(1.02);
  border-color: #ffe082;
  border-style: solid;
  background: linear-gradient(135deg, rgba(55, 35, 75, 0.98), rgba(75, 30, 55, 0.98));
  box-shadow: 0 10px 28px rgba(255, 204, 0, 0.35);
}

.lobby-download-btn:active {
  transform: scale(0.98);
}

.lobby-download-icon {
  font-size: 28px;
  animation: dlBounce 1.5s infinite ease-in-out;
}

@keyframes dlBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}

.lobby-download-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  flex: 1;
}

.lobby-download-title {
  font-family: 'Lilita One', cursive;
  font-size: 18px;
  color: #ffde59;
  letter-spacing: 0.5px;
}

.lobby-download-sub {
  font-size: 11.5px;
  font-weight: 600;
  color: #cbd5e1;
  margin-top: 2px;
}

.lobby-download-pill {
  background: linear-gradient(180deg, #ffb703 0%, #fb8500 100%);
  border: 1.5px solid #fff;
  border-radius: 12px;
  padding: 6px 14px;
  font-family: 'Lilita One', cursive;
  font-size: 13px;
  color: #111;
  letter-spacing: 0.5px;
  box-shadow: 0 3px 10px rgba(251, 133, 0, 0.5);
  white-space: nowrap;
}

.lobby-icon {
  font-size: 48px;
  margin-bottom: 6px;
}

.lobby-title {
  font-family: 'Lilita One', cursive;
  font-size: 34px;
  color: #ffde59;
  letter-spacing: 1.5px;
  text-shadow: 0 3px 6px rgba(0,0,0,0.6);
}

.lobby-sub {
  font-size: 13px;
  color: #cbd5e1;
  font-weight: 600;
  margin-bottom: 20px;
}

.lobby-connect-box {
  background: rgba(0, 0, 0, 0.35);
  border: 1.5px solid rgba(255, 255, 255, 0.12);
  border-radius: 18px;
  padding: 16px;
  margin-bottom: 24px;
  text-align: left;
}

.lobby-label {
  display: block;
  font-size: 11px;
  font-weight: 700;
  color: #ffa726;
  text-transform: uppercase;
  margin-bottom: 8px;
  letter-spacing: 0.5px;
}

.lobby-input-row {
  display: flex;
  gap: 8px;
}

.lobby-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.08);
  border: 1.5px solid rgba(255, 255, 255, 0.25);
  border-radius: 12px;
  padding: 10px 14px;
  color: #fff;
  font-family: inherit;
  font-size: 14px;
  font-weight: 600;
  outline: none;
}
.lobby-input:focus { border-color: #ffcc00; }

.lobby-btn-connect {
  background: #e63946;
  border: none;
  border-radius: 12px;
  padding: 10px 18px;
  font-weight: 700;
  font-size: 13px;
  color: #fff;
  cursor: pointer;
  transition: background 0.15s, transform 0.1s;
}
.lobby-btn-connect:hover { background: #ff4d6d; }
.lobby-btn-connect.connected {
  background: #2ec4b6;
}

.lobby-status {
  margin-top: 10px;
  font-size: 12px;
  color: #ffd180;
  line-height: 1.4;
}

.lobby-status.connected {
  color: #00e676;
  font-weight: 700;
}

.lobby-btn-start {
  width: 100%;
  background: linear-gradient(180deg, #ffb703 0%, #fb8500 100%);
  border: 3px solid #fff;
  border-radius: 24px;
  padding: 14px 28px;
  font-family: 'Lilita One', cursive;
  font-size: 24px;
  color: #111;
  letter-spacing: 1px;
  cursor: pointer;
  box-shadow: 0 8px 25px rgba(251, 133, 0, 0.7), inset 0 2px 4px rgba(255,255,255,0.6);
  transition: transform 0.15s, box-shadow 0.15s;
}
.lobby-btn-start:hover {
  transform: scale(1.04);
  box-shadow: 0 10px 30px rgba(251, 133, 0, 0.85);
}
.lobby-btn-start:active { transform: scale(0.97); }

.lobby-tip {
  margin-top: 14px;
  font-size: 11px;
  color: #94a3b8;
}

/* =====================================================================
   FULLSCREEN / WIDE SETTINGS & GIFT CATALOG MODAL
   ===================================================================== */
.settings-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.76);
  backdrop-filter: blur(8px);
  z-index: 140;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.settings-backdrop.open {
  opacity: 1;
  pointer-events: auto;
}

#settings-drawer {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.95);
  width: 980px;
  max-width: 95vw;
  height: 88vh;
  max-height: 850px;
  background: linear-gradient(135deg, rgba(18, 16, 28, 0.98), rgba(28, 20, 36, 0.98));
  border: 2.5px solid #ffcc00;
  border-radius: 24px;
  box-shadow: 0 15px 50px rgba(0, 0, 0, 0.9), 0 0 40px rgba(255, 204, 0, 0.35);
  backdrop-filter: blur(20px);
  z-index: 150;
  display: flex;
  flex-direction: column;
  padding: 24px 28px;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  user-select: none;
  -webkit-user-select: none;
  cursor: default;
  overflow: hidden;
}

#settings-drawer.open {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
  pointer-events: auto;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  user-select: none;
}

.drawer-title {
  font-family: 'Lilita One', cursive;
  font-size: 22px;
  color: #ffde59;
  letter-spacing: 0.5px;
  text-shadow: 0 2px 8px rgba(255, 204, 0, 0.3);
}

.drawer-close {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 10px;
  width: 36px;
  height: 36px;
  font-size: 18px;
  color: #cbd5e1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}
.drawer-close:hover {
  background: #e63946;
  border-color: #ff4d6d;
  color: #fff;
}

.drawer-tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
  background: rgba(0, 0, 0, 0.35);
  padding: 6px;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  user-select: none;
}

.drawer-tab-btn {
  flex: 1;
  background: transparent;
  border: none;
  padding: 10px 8px;
  border-radius: 10px;
  color: #cbd5e1;
  font-family: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.15s ease;
  user-select: none;
}

.drawer-tab-btn.active {
  background: #ffb703;
  color: #111;
  box-shadow: 0 3px 12px rgba(255, 183, 3, 0.45);
}

.drawer-tab-content {
  display: none;
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 6px;
  user-select: none;
}

.drawer-tab-content.active {
  display: flex;
  flex-direction: column;
}

.drawer-section {
  margin-bottom: 16px;
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 16px;
  padding: 14px 18px;
  user-select: none;
}

.section-label {
  font-size: 13px;
  font-weight: 700;
  color: #ffa726;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-bottom: 12px;
}

.input-row {
  display: flex;
  gap: 10px;
  margin-bottom: 6px;
}

.text-input, .select-input {
  background: rgba(255, 255, 255, 0.08);
  border: 1.5px solid rgba(255, 255, 255, 0.2);
  border-radius: 10px;
  padding: 8px 12px;
  color: #fff;
  font-family: inherit;
  font-size: 13px;
  outline: none;
  user-select: text;
}
.text-input:focus, .select-input:focus {
  border-color: #ffcc00;
}
.select-input option {
  background: #1a1a28;
  color: #fff;
}

.action-btn {
  background: #ffb703;
  color: #111;
  border: none;
  border-radius: 10px;
  padding: 9px 16px;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  transition: transform 0.1s, background 0.15s;
  user-select: none;
}
.action-btn:hover { background: #ffc300; }
.action-btn:active { transform: scale(0.96); }

.test-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 10px;
}

.test-grid.catalog-test-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 10px;
}

.test-btn {
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 12px;
  padding: 10px 12px;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.15s;
  user-select: none;
}
.test-btn:hover {
  background: rgba(255, 204, 0, 0.16);
  border-color: #ffcc00;
  transform: translateY(-1px);
}

.test-btn.test-gift-btn {
  justify-content: space-between;
  padding: 9px 14px;
}

.test-gift-btn-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.test-btn-img {
  width: 24px;
  height: 24px;
  object-fit: contain;
}

.test-btn-name {
  font-size: 13px;
  font-weight: 700;
  color: #fff;
}

.test-btn-badge {
  background: rgba(255, 204, 0, 0.2);
  border: 1px solid rgba(255, 204, 0, 0.55);
  border-radius: 6px;
  color: #ffd700;
  font-size: 11px;
  font-weight: 700;
  padding: 2px 7px;
  white-space: nowrap;
}

.slider-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
  font-size: 13px;
}
.slider-row input[type="range"] {
  width: 160px;
  accent-color: #ffb703;
}

/* WIDE CATALOG CARD STYLING */
.catalog-header-text {
  font-size: 13px;
  color: #cbd5e1;
  margin-bottom: 14px;
  line-height: 1.5;
  user-select: none;
}

.catalog-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 6px;
}

.catalog-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.045);
  border: 1.5px solid rgba(255, 255, 255, 0.12);
  border-radius: 14px;
  padding: 10px 18px;
  gap: 16px;
  transition: all 0.15s;
  user-select: none;
}
.catalog-card:hover {
  background: rgba(255, 255, 255, 0.075);
  border-color: rgba(255, 204, 0, 0.45);
}

.catalog-card-left {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 220px;
}

.catalog-thumb {
  width: 44px;
  height: 44px;
  object-fit: contain;
  background: rgba(0, 0, 0, 0.45);
  border: 1.5px solid rgba(255, 204, 0, 0.35);
  border-radius: 10px;
  padding: 3px;
}

.catalog-name {
  font-size: 15px;
  font-weight: 700;
  color: #fff;
  margin-bottom: 3px;
}

.btn-change-gift {
  background: rgba(255, 204, 0, 0.16);
  border: 1px solid rgba(255, 204, 0, 0.45);
  border-radius: 8px;
  color: #ffde59;
  font-size: 11px;
  font-weight: 600;
  padding: 3px 8px;
  cursor: pointer;
  transition: all 0.15s;
}
.btn-change-gift:hover {
  background: #ffcc00;
  color: #111;
}

.catalog-card-right {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  justify-content: flex-end;
}

.catalog-action-select {
  background: rgba(12, 12, 20, 0.95);
  border: 1.5px solid rgba(255, 204, 0, 0.4);
  border-radius: 10px;
  color: #ffde59;
  font-size: 13px;
  font-weight: 700;
  padding: 8px 12px;
  min-width: 270px;
  outline: none;
  cursor: pointer;
}
.catalog-action-select:focus {
  border-color: #ffcc00;
  box-shadow: 0 0 10px rgba(255, 204, 0, 0.3);
}
.catalog-action-select option {
  background: #141424;
  color: #fff;
  padding: 6px;
}

.gift-duration-select {
  background: rgba(12, 12, 20, 0.95);
  border: 1.5px solid rgba(255, 90, 90, 0.5);
  border-radius: 10px;
  color: #ff7b7b;
  font-size: 13px;
  font-weight: 700;
  padding: 8px 10px;
  outline: none;
  cursor: pointer;
}
.gift-duration-select option {
  background: #141424;
  color: #fff;
}

/* Leaderboard Modal */
#leaderboard-modal {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  width: 440px;
  background: linear-gradient(135deg, rgba(24, 20, 34, 0.98), rgba(36, 25, 42, 0.98));
  border: 2px solid #ffcc00;
  border-radius: 24px;
  padding: 20px 24px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.8), 0 0 25px rgba(255, 204, 0, 0.3);
  backdrop-filter: blur(14px);
  z-index: 120;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s, transform 0.2s;
  cursor: default;
}

#leaderboard-modal.open {
  opacity: 1;
  pointer-events: auto;
  transform: translate(-50%, -50%) scale(1);
}

.leaderboard-tab-bar {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.lead-tab-btn {
  flex: 1;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 10px;
  padding: 8px 10px;
  color: #cbd5e1;
  font-family: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
}

.lead-tab-btn.active {
  background: #ffb703;
  color: #111;
  border-color: #ffea00;
}

.leaderboard-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 320px;
  overflow-y: auto;
}

.leaderboard-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 8px 12px;
}

.leaderboard-row.rank-1 {
  background: linear-gradient(90deg, rgba(255, 215, 0, 0.25), transparent);
  border-color: #ffd700;
}
.leaderboard-row.rank-2 {
  background: linear-gradient(90deg, rgba(192, 192, 192, 0.25), transparent);
  border-color: #c0c0c0;
}
.leaderboard-row.rank-3 {
  background: linear-gradient(90deg, rgba(205, 127, 50, 0.25), transparent);
  border-color: #cd7f32;
}

.user-badge {
  display: flex;
  align-items: center;
  gap: 8px;
}

.user-avatar-sm {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: 1.5px solid #ffeb3b;
  object-fit: cover;
}

.user-name-text {
  font-size: 13px;
  font-weight: 600;
}

.user-score-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.user-score-text {
  font-family: 'Lilita One', cursive;
  font-size: 16px;
  color: #ffeb3b;
}

.lead-controls {
  display: flex;
  align-items: center;
  gap: 5px;
}

.lead-btn {
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 8px;
  width: 26px;
  height: 26px;
  font-size: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #fff;
  transition: transform 0.12s, background 0.15s, border-color 0.15s;
  user-select: none;
}

.lead-btn:hover {
  transform: scale(1.15);
}

.lead-btn.btn-lead-plus:hover {
  background: #00e676;
  border-color: #a7f3d0;
}

.lead-btn.btn-lead-minus:hover {
  background: #ff9100;
  border-color: #fed7aa;
}

.lead-btn.btn-lead-remove:hover {
  background: #d90429;
  border-color: #fca5a5;
}

/* =====================================================================
   ROUND COMPLETE / WINNER PODIUM MODAL (Enlarged Text & Avatars)
   ===================================================================== */
.round-complete-modal {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(10, 10, 20, 0.88);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 200;
  backdrop-filter: blur(10px);
}

.round-complete-modal.open {
  display: flex;
}

.complete-card {
  background: linear-gradient(135deg, #1b162a 0%, #291a2e 100%);
  border: 3.5px solid #ffea00;
  border-radius: 32px;
  padding: 34px 44px;
  text-align: center;
  box-shadow: 0 12px 50px rgba(0,0,0,0.9), 0 0 35px rgba(255, 234, 0, 0.4);
  max-width: 620px;
  width: 94%;
  animation: cardPop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes cardPop {
  0% { transform: scale(0.8); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.complete-badge {
  font-family: 'Lilita One', cursive;
  font-size: 36px;
  color: #ffea00;
  margin-bottom: 6px;
  letter-spacing: 1px;
}

.complete-title {
  font-size: 20px;
  font-weight: 700;
  color: #fff;
  margin-bottom: 18px;
}

.complete-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 20px;
}

.cstat-box {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 14px;
  padding: 12px;
}

.cstat-label {
  font-size: 11px;
  color: #cbd5e1;
  text-transform: uppercase;
  margin-bottom: 4px;
}

.cstat-val {
  font-family: 'Lilita One', cursive;
  font-size: 24px;
  color: #80d8ff;
}

/* Podium Section */
.podium-section {
  background: rgba(0, 0, 0, 0.35);
  border: 1.5px solid rgba(255, 235, 59, 0.35);
  border-radius: 20px;
  padding: 18px 14px;
  margin-bottom: 22px;
}

.podium-title {
  font-size: 13px;
  font-weight: 800;
  color: #ffea00;
  letter-spacing: 1px;
  margin-bottom: 14px;
  text-transform: uppercase;
}

.podium-grid {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 18px;
}

.podium-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 130px;
}

.podium-item.podium-1 {
  order: 2; /* 1st in center */
}
.podium-item.podium-2 {
  order: 1; /* 2nd on left */
}
.podium-item.podium-3 {
  order: 3; /* 3rd on right */
}

.podium-crown {
  font-size: 32px;
  margin-bottom: -4px;
  animation: jamWiggle 0.6s infinite alternate;
}

.podium-avatar {
  width: 68px;
  height: 68px;
  border-radius: 50%;
  border: 3.5px solid #ffcc00;
  object-fit: cover;
  box-shadow: 0 4px 14px rgba(0,0,0,0.6);
}

.podium-item.podium-1 .podium-avatar {
  width: 86px;
  height: 86px;
  border-color: #ffd700;
  border-width: 4.5px;
  box-shadow: 0 0 25px rgba(255, 215, 0, 0.75);
}

.podium-name {
  font-size: 14px;
  font-weight: 800;
  color: #fff;
  margin-top: 6px;
  max-width: 120px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.podium-escapes {
  font-size: 14px;
  font-family: 'Lilita One', cursive;
  color: #00e676;
}

.podium-stand {
  width: 100%;
  background: linear-gradient(180deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05));
  border-radius: 8px 8px 0 0;
  margin-top: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Lilita One', cursive;
  font-size: 16px;
  color: #fff;
}

.podium-item.podium-1 .podium-stand {
  height: 46px;
  background: linear-gradient(180deg, #ffd700, #b8860b);
  color: #111;
}
.podium-item.podium-2 .podium-stand {
  height: 32px;
  background: linear-gradient(180deg, #e0e0e0, #9e9e9e);
  color: #111;
}
.podium-item.podium-3 .podium-stand {
  height: 22px;
  background: linear-gradient(180deg, #cd7f32, #8d5524);
  color: #fff;
}

.complete-btn {
  background: linear-gradient(180deg, #ffb703 0%, #fb8500 100%);
  border: 2.5px solid #fff;
  border-radius: 20px;
  padding: 12px 34px;
  font-family: 'Lilita One', cursive;
  font-size: 18px;
  color: #111;
  cursor: pointer;
  box-shadow: 0 6px 20px rgba(251, 133, 0, 0.6);
  transition: transform 0.15s;
}
.complete-btn:hover { transform: scale(1.06); }

/* =====================================================================
   OBS WIDGET COPY BUTTON & FEEDBACK
   ===================================================================== */
.obs-copy-section {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 12px;
}

.obs-copy-btn {
  background: linear-gradient(135deg, #00b4d8, #0077b6);
  border: 1.5px solid #90e0ef;
  border-radius: 12px;
  padding: 8px 14px;
  font-family: inherit;
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(0, 180, 216, 0.35);
  transition: transform 0.15s, background 0.15s, box-shadow 0.15s;
}

.obs-copy-btn:hover {
  transform: scale(1.02);
  background: linear-gradient(135deg, #48cae4, #0096c7);
  box-shadow: 0 6px 16px rgba(0, 180, 216, 0.5);
}

.obs-copy-btn:active {
  transform: scale(0.98);
}

.obs-copy-feedback {
  font-size: 11px;
  font-weight: 700;
  color: #00e676;
  text-align: center;
  min-height: 16px;
  transition: opacity 0.2s;
}

/* =====================================================================
   GIFT PICKER MODAL (630+ TIKTOK GIFTS)
   ===================================================================== */
.gift-picker-modal {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(10, 10, 20, 0.85);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 250;
  backdrop-filter: blur(10px);
}

.gift-picker-modal.open {
  display: flex;
}

.gift-picker-card {
  background: linear-gradient(135deg, #181528, #2a1b32);
  border: 2.5px solid #ffcc00;
  border-radius: 24px;
  padding: 20px 24px;
  width: 90%;
  max-width: 620px;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 12px 50px rgba(0,0,0,0.9), 0 0 25px rgba(255, 204, 0, 0.3);
  animation: cardPop 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.gift-picker-search-wrap {
  margin: 12px 0 14px;
}

.gift-picker-search {
  width: 100%;
  background: rgba(0, 0, 0, 0.5);
  border: 1.5px solid rgba(255, 204, 0, 0.4);
  border-radius: 12px;
  padding: 10px 14px;
  font-family: inherit;
  font-size: 14px;
  color: #fff;
  outline: none;
  transition: border-color 0.2s;
}
.gift-picker-search:focus {
  border-color: #ffcc00;
  box-shadow: 0 0 10px rgba(255, 204, 0, 0.3);
}

.gift-picker-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
  gap: 10px;
  overflow-y: auto;
  max-height: 52vh;
  padding-right: 4px;
}

.gift-picker-item {
  background: rgba(255, 255, 255, 0.05);
  border: 1.5px solid rgba(255, 255, 255, 0.12);
  border-radius: 14px;
  padding: 8px 6px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: transform 0.15s, border-color 0.15s, background 0.15s;
}

.gift-picker-item:hover {
  transform: translateY(-3px) scale(1.03);
  border-color: #ffea00;
  background: rgba(255, 234, 0, 0.12);
}

.gift-picker-img {
  width: 44px;
  height: 44px;
  object-fit: contain;
}

.gift-picker-name,
.gift-picker-name-tr {
  font-size: 11px;
  font-weight: 800;
  color: #ffde59;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 95px;
}

.gift-picker-name-en {
  font-size: 9.5px;
  font-weight: 600;
  color: #cbd5e1;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 95px;
  margin-top: -2px;
}

/* Catalog Card Customizations */
.btn-change-gift {
  background: rgba(255, 204, 0, 0.15);
  border: 1px solid #ffcc00;
  border-radius: 8px;
  padding: 4px 8px;
  font-size: 10px;
  font-weight: 700;
  color: #ffea00;
  cursor: pointer;
  transition: background 0.15s, transform 0.1s;
}
.btn-change-gift:hover {
  background: rgba(255, 204, 0, 0.35);
  transform: scale(1.05);
}

.gift-duration-select {
  background: rgba(0, 0, 0, 0.6);
  border: 1px solid #ff9100;
  border-radius: 6px;
  color: #ffb703;
  font-size: 10px;
  font-weight: 700;
  padding: 4px;
  margin-left: 6px;
  outline: none;
}

/* Coin Badges and Sorting Controls */
.gift-picker-coin-badge {
  background: rgba(255, 183, 3, 0.2);
  border: 1px solid #ffb703;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 800;
  color: #ffde59;
  padding: 1px 6px;
  letter-spacing: 0.5px;
}

.catalog-coin-badge {
  display: inline-block;
  background: rgba(255, 183, 3, 0.18);
  border: 1px solid rgba(255, 183, 3, 0.5);
  border-radius: 6px;
  color: #ffd700;
  font-size: 10px;
  font-weight: 800;
  padding: 2px 6px;
  margin-top: 3px;
}

.gift-picker-filter-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 12px;
}

.gift-picker-sort-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.gift-sort-label {
  font-size: 12px;
  font-weight: 700;
  color: #ffd700;
}

.gift-picker-sort-select {
  background: rgba(10, 10, 20, 0.9);
  border: 1.5px solid #ffcc00;
  border-radius: 8px;
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 4px 8px;
  outline: none;
  cursor: pointer;
}

.gift-picker-chips {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.gift-chip {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 12px;
  color: #cbd5e1;
  font-size: 10.5px;
  font-weight: 700;
  padding: 3px 10px;
  cursor: pointer;
  transition: all 0.15s;
}

.gift-chip:hover {
  background: rgba(255, 204, 0, 0.2);
  border-color: #ffd700;
  color: #fff;
}

.gift-chip.active {
  background: #ffb703;
  border-color: #ffea00;
  color: #111;
}

