{
  "name": "mng-pony-live",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "express": "4.22.3",
    "image-size": "^2.0.4",
    "lucide": "^0.468.0",
    "three": "^0.170.0",
    "tiktok-live-connector": "2.4.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.0",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.mng.tiktok.ponylife",
    "productName": "MNG Pony Life",
    "asar": false,
    "directories": { "output": "release-desktop-1.0.6" },
    "electronDist": "node_modules/electron/dist",
    "files": ["dist/**/*", "public/widget*", "server/**/*", "shared/**/*", "desktop/**/*", "build/**/*", "package.json", "launcher-widget-links.cjs", "node_modules/**/*"],
    "win": { "icon": "build/pony-life-icon.ico", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "MNG Pony Life" },
    "artifactName": "MNG-Pony-Life-${version}-${arch}.${ext}"
  }
}
