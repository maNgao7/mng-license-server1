const avatarCache = new Map();
const AVATAR_HOSTS = ["tiktokcdn.com", "byteimg.com", "ibytedtos.com", "tiktokv.com", "pravatar.cc", "unavatar.io"];
const LAUNCHER_AVATAR_CACHE = findAvatarCachePath();

let connection = null;
let activeUsername = "";
let topKeepers = [];
let teamScores = {
  galatasaray: 0,
  fenerbahce: 0,
  besiktas: 0,
  trabzonspor: 0,
  amedspor: 0
};

function eulerKey() {
  const candidates = [
    path.join(__dirname, "euler-api-key.txt"),
    path.join(__dirname, "..", "tiktok-vs", "euler-api-key.txt"),
    path.join(__dirname, "..", "mng-orbit", "euler-api-key.txt"),
    path.join(__dirname, "..", "crowd-control", "euler-api-key.txt"),
    path.join("C:", "Users", "User", "Desktop", "MNG-TikTok-Game", "apps", "tiktok-vs", "euler-api-key.txt")
  ];
  for (const c of candidates) {
    try {
      if (fs.existsSync(c)) {
        const val = fs.readFileSync(c, "utf8").trim();
        if (val) return val;
      }
    } catch {}
  }
  return undefined;
}

function trustedAvatarUrl(rawUrl) {
  if (!rawUrl || typeof rawUrl !== "string") return null;
  try {
    const parsed = new URL(rawUrl.trim());
    if (parsed.protocol !== "http:" && parsed.protocol !== "https:") return null;
    const hostname = parsed.hostname.toLowerCase();
    const isAllowed = AVATAR_HOSTS.some(host => hostname === host || hostname.endsWith(`.${host}`));
    return isAllowed ? parsed : null;
  } catch {
    return null;
  }
}

function uretVarsayilanAvatarSvg(username) {
  const clean = String(username || "U").trim();
  const harf = (clean.charAt(0) || "U").toUpperCase();
  const renkler = [
    "#f59e0b", "#ef4444", "#3b82f6", "#10b981", "#8b5cf6",
    "#ec4899", "#06b6d4", "#84cc16", "#f97316", "#6366f1"
  ];
  let h = 0;
  for (let i = 0; i < clean.length; i++) h = (h * 31 + clean.charCodeAt(i)) >>> 0;
  const bg = renkler[h % renkler.length];
  return `<svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" viewBox="0 0 128 128">
    <circle cx="64" cy="64" r="64" fill="${bg}"/>
    <text x="64" y="80" font-size="64" font-weight="900" font-family="system-ui, -apple-system, sans-serif" fill="#ffffff" text-anchor="middle" dominant-baseline="central">${harf}</text>
  </svg>`;
}

app.get("/api/health", (_req, res) => {
  res.json({ status: "ok", app: "mng-penalty-kick", port: PORT, activeUsername, connected: Boolean(connection) });
});

async function fetchUnavatarTikTok(username) {
  const clean = String(username || "").replace(/^@/, "").trim();
  if (!clean || clean === "MNG" || clean === "Kaleci" || clean === "YAYINCI") return null;
  try {
    const unavatarUrl = `https://unavatar.io/tiktok/${encodeURIComponent(clean)}`;
    const response = await fetch(unavatarUrl, {
      headers: { "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" },
      signal: AbortSignal.timeout(5000)
    });
    const contentType = response.headers.get("content-type") || "";
    if (response.ok && contentType.startsWith("image/")) {
      const buffer = Buffer.from(await response.arrayBuffer());
      if (buffer.length >= 1000) {
        return { buffer, contentType };
      }
    }
  } catch {}
  return null;
}

app.get("/api/avatar", async (req, res) => {
  const username = String(req.query.user || "").trim();
  const avatarUrl = trustedAvatarUrl(req.query.url);
  const cleanUser = username.replace(/^@/, "").replace(/[^a-zA-Z0-9_.-]/g, "_").slice(0, 100);

  // 1. Yerel Launcher önbelleği
  if (cleanUser) {
    try {
      const base = path.join(LAUNCHER_AVATAR_CACHE, `user_${cleanUser}`);
      const metadata = JSON.parse(fs.readFileSync(`${base}.json`, "utf8"));
      const buffer = fs.readFileSync(`${base}.bin`);
      if (buffer.length >= 1500) {
        res.set("Content-Type", metadata.contentType || "image/jpeg");
        res.set("Cache-Control", "public, max-age=900");
        return res.send(buffer);
      }
    } catch {}
  }

  // 2. Bellek önbelleği
  if (avatarUrl) {
    const cacheKey = avatarUrl.href;
    const cached = avatarCache.get(cacheKey);
    if (cached) {
      res.set("Content-Type", cached.contentType);
      res.set("Cache-Control", "public, max-age=900");
      return res.send(cached.buffer);
    }

    try {
      const response = await fetch(avatarUrl, {
        headers: {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124 Safari/537.36",
          "Accept": "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8",
          "Referer": "https://www.tiktok.com/"
        },
        signal: AbortSignal.timeout(6000)
      });
      const contentType = response.headers.get("content-type") || "";
      if (response.ok && contentType.startsWith("image/")) {
        const buffer = Buffer.from(await response.arrayBuffer());
        if (buffer.length && buffer.length <= 8 * 1024 * 1024) {
          avatarCache.set(cacheKey, { buffer, contentType });
          if (avatarCache.size > 400) avatarCache.delete(avatarCache.keys().next().value);
          res.set("Content-Type", contentType);
          res.set("Cache-Control", "public, max-age=900");
          return res.send(buffer);
        }
      }
    } catch {}
  }

  // 3. unavatar.io TikTok profil servisi
  if (cleanUser) {
    const unav = await fetchUnavatarTikTok(cleanUser);
    if (unav) {
      res.set("Content-Type", unav.contentType);
      res.set("Cache-Control", "public, max-age=1800");
      return res.send(unav.buffer);
    }
  }

  // 4. Varsayılan SVG Rozet
  res.set("Content-Type", "image/svg+xml");
  res.set("Cache-Control", "public, max-age=3600");
  res.send(uretVarsayilanAvatarSvg(username));
});

app.get("/api/tiktok-avatar", async (req, res) => {
  const username = String(req.query.user || "").replace(/^@/, "").trim();
  if (!username || username === "MNG" || username === "Kaleci" || username === "YAYINCI") {
    res.set("Content-Type", "image/svg+xml");
    res.set("Cache-Control", "public, max-age=86400");
    return res.send(uretVarsayilanAvatarSvg(username || "U"));
  }

  // 1. Yerel Launcher önbelleği
  const cleanUser = username.replace(/[^a-zA-Z0-9_.-]/g, "_").slice(0, 100);
  try {
    const base = path.join(LAUNCHER_AVATAR_CACHE, `user_${cleanUser}`);
    if (fs.existsSync(`${base}.bin`)) {
      const buffer = fs.readFileSync(`${base}.bin`);
      if (buffer.length >= 1500) {
        let contentType = "image/jpeg";
        try { contentType = JSON.parse(fs.readFileSync(`${base}.json`, "utf8")).contentType || contentType; } catch {}
        res.set("Content-Type", contentType);
        res.set("Cache-Control", "public, max-age=1800");
        return res.send(buffer);
      }
    }
  } catch {}

  // 2. unavatar.io TikTok profil servisi
  const unav = await fetchUnavatarTikTok(cleanUser);
  if (unav) {
    res.set("Content-Type", unav.contentType);
    res.set("Cache-Control", "public, max-age=3600");
    return res.send(unav.buffer);
  }

  // 3. Fallback SVG
  res.set("Content-Type", "image/svg+xml");
  res.set("Cache-Control", "public, max-age=86400");
  res.send(uretVarsayilanAvatarSvg(username));
});

