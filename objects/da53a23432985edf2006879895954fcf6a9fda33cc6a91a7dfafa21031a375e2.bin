function findCatalogPath() {
  const candidates = [
    path.join(__dirname, "public", "assets"),
    path.join(__dirname, "..", "tiktok-vs", "public", "assets"),
    path.join(__dirname, "..", "MNG-TikTok-Game", "apps", "tiktok-vs", "public", "assets"),
    path.join("C:", "Users", "User", "Desktop", "MNG-TikTok-Game", "apps", "tiktok-vs", "public", "assets"),
    path.join(__dirname, "..", "MNG-Duck-Hunt", "public", "assets")
  ];
  return candidates.find(p => fs.existsSync(path.join(p, "gift-images"))) || path.join(__dirname, "public");
}

function findSharedBackgroundsPath() {
  const candidates = [
    path.join(__dirname, "..", "tiktok-vs", "public", "assets", "backgrounds"),
    path.join(__dirname, "..", "MNG-TikTok-Game", "apps", "tiktok-vs", "public", "assets", "backgrounds"),
    path.join("C:", "Users", "User", "Desktop", "MNG-TikTok-Game", "apps", "tiktok-vs", "public", "assets", "backgrounds")
  ];
  return candidates.find(p => fs.existsSync(p)) || path.join(__dirname, "public");
}

function findAvatarCachePath() {
  const candidates = [
    path.join(__dirname, "..", "tiktok-vs", ".avatar-cache"),
    path.join(__dirname, "..", "MNG-TikTok-Game", "apps", "tiktok-vs", ".avatar-cache"),
    path.join("C:", "Users", "User", "Desktop", "MNG-TikTok-Game", "apps", "tiktok-vs", ".avatar-cache")
  ];
  return candidates.find(p => fs.existsSync(p)) || path.join(__dirname, ".avatar-cache");
}

