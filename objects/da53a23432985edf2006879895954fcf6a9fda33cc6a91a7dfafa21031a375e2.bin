  });
  console.log("🏆 Canlı liderlik tablosu ve takım gol skorları sıfırlandı.");
  res.json({ ok: true, topKeepers, teamScores });
});

function imageUrlFrom(...candidates) {
  for (const item of candidates) {
    if (!item) continue;
    if (typeof item === "string" && item.trim()) return item.trim();
    if (Array.isArray(item?.urlList) && item.urlList[0]) return item.urlList[0];
    if (Array.isArray(item?.url_list) && item.url_list[0]) return item.url_list[0];
    if (Array.isArray(item?.urls) && item.urls[0]) return item.urls[0];
    if (typeof item?.url === "string" && item.url.trim()) return item.url.trim();
    if (typeof item?.uri === "string" && item.uri.trim()) return item.uri.trim();
  }
  return null;
}

function playerFrom(data) {
  const user = data.user || data.author || data.sender || data;
  const id = String(user.userId || user.user_id || user.id || user.secUid || user.uniqueId || "").trim();
  if (!id) return null;
  const nickname = String(user.nickname || user.uniqueId || user.unique_id || user.name || id).trim();
  const avatar = imageUrlFrom(user.avatarLarge, user.avatar_large, user.profilePictureUrl, user.profile_picture_url, user.avatarThumb, user.avatar_thumb, user.avatarMedium, user.avatar_medium, user.avatar);
  const avatarFallback = imageUrlFrom(user.avatarThumb, user.avatar_thumb, user.avatarMedium, user.avatar_medium, user.avatar);
  return { id, nickname, avatar, avatarFallback };
}

function giftFrom(data) {
  const extended = data.extendedGiftInfo || {};
  const detail = data.giftDetails || {};
  const gift = data.gift || {};
  const count = Math.max(1, Number(data.repeatCount || data.repeat_count || data.comboCount || data.combo_count || data.count || extended.count || 1) || 1);
  const coins = Math.max(1, Number(extended.diamondCount || extended.diamond_count || detail.diamondCount || detail.diamond_count || data.diamondCount || data.diamond_count || gift.diamond_count || 1) || 1);
  const giftId = extended.id || data.giftId || data.gift_id || detail.giftId || detail.gift_id || gift.id || null;
  const giftName = extended.name || extended.giftName || detail.name || detail.giftName || data.giftName || gift.name || "Hediye";
  const giftImage = imageUrlFrom(extended.image, extended.icon, detail.image, detail.icon, gift.image, gift.icon);

  return { giftId, giftName, coins, count, giftImage };
}

function broadcast(msg) {
  const payload = JSON.stringify(msg);
  for (const client of wss.clients) {
    if (client.readyState === 1) client.send(payload);
  }
}

function disconnect() {
  if (!connection) return;
  try { connection.disconnect(); } catch {}
  connection = null;
  activeUsername = "";
  broadcast({ type: "status", state: "disconnected", activeUsername: "" });
}

function connect(username) {
  const clean = String(username || "").replace(/^@/, "").trim();
  if (!clean) {
    broadcast({ type: "status", state: "disconnected", error: "TikTok kullanıcı adı boş olamaz." });
    return;
  }
  disconnect();

  activeUsername = clean;
  const avatarFallback = `/api/tiktok-avatar?user=${encodeURIComponent(clean)}`;
  broadcast({
    type: "status",
    state: "connecting",
    activeUsername: clean,
    avatar: avatarFallback,
    message: `@${clean} yayınına bağlanılıyor...`
  });

  const apiKey = eulerKey();
  const options = {};
  if (apiKey) {
    options.signApiKey = apiKey;
  }

  connection = new TikTokLiveConnection(clean, options);
  const activeConn = connection;

  // Hata durumunda EventEmitter çökmesini engelleyen güvenli listener
  connection.on("error", err => {
    if (connection !== activeConn) return;
    const msg = err?.message || String(err || "Bağlantı hatası oluştu.");
    console.warn("TikTok Live Uyarısı/Hatası:", msg);
    broadcast({ type: "status", state: "disconnected", activeUsername: clean, avatar: avatarFallback, error: msg, message: msg });
  });

  connection.connect().then(state => {
    if (connection !== activeConn) return;
    const roomInfo = state?.roomInfo || {};
    const owner = roomInfo?.owner || {};
    const avatarUrl = owner?.avatar_thumb?.url_list?.[0] || owner?.avatar_medium?.url_list?.[0] || owner?.avatar_large?.url_list?.[0] || avatarFallback;
    console.log(`✅ @${clean} yayınına başarıyla bağlandı! (Room: ${state.roomId})`);
    broadcast({
      type: "status",
      state: "connected",
      activeUsername: clean,
      roomId: state.roomId,
      avatar: avatarUrl,
      message: `@${clean} yayınına başarıyla bağlandı!`
    });
  }).catch(err => {
    if (connection !== activeConn) return;
    connection = null;
    const rawMsg = err?.message || String(err || "");
    const friendlyMsg = rawMsg.includes("isn't online") || rawMsg.includes("not online") || rawMsg.includes("LIVE has ended")
      ? `@${clean} kullanıcısı şu anda canlı yayında değil.`
      : (rawMsg || "Yayın bulunamadı veya bağlantı kurulamadı.");
    console.warn("TikTok Bağlantı Hatası:", friendlyMsg);
    broadcast({
      type: "status",
      state: "disconnected",
      activeUsername: clean,
      avatar: avatarFallback,
      error: friendlyMsg,
      message: friendlyMsg
    });
  });

  connection.on(WebcastEvent.GIFT, data => {
    const player = playerFrom(data);
    if (!player) return;
    const g = giftFrom(data);
    widgetGiftPost({
      sender: player.nickname,
      avatar: player.avatar,
      giftName: g.giftName,
      count: g.count,
      diamondCount: g.coins
    });
    broadcast({
      type: "penalty-event",
      event: "gift",
      player,
      ...g
    });
  });

  connection.on(WebcastEvent.LIKE, data => {
    const player = playerFrom(data);
    if (!player) return;
    const count = Math.max(1, Number(data.likeCount || data.count || 1));
    widgetLikePost({
      sender: player.nickname,
      avatar: player.avatar,
      count
    });
    broadcast({
      type: "penalty-event",
      event: "like",
      player,
      count
    });
  });

  connection.on(WebcastEvent.FOLLOW, data => {
    const player = playerFrom(data);
    if (!player) return;
    broadcast({
      type: "penalty-event",
      event: "follow",
      player
    });
  });

  connection.on(WebcastEvent.CHAT, data => {
    const player = playerFrom(data);
    if (!player) return;
    broadcast({
      type: "penalty-event",
      event: "chat",
      player,
      comment: data.comment || ""
    });
  });

  connection.on(WebcastEvent.MEMBER, data => {
    const player = playerFrom(data);
    if (!player) return;
    broadcast({
      type: "penalty-event",
      event: "member",
      player
    });
  });

  connection.on(WebcastEvent.SHARE, data => {
    const player = playerFrom(data);
    if (!player) return;
    broadcast({
      type: "penalty-event",
      event: "share",
      player
    });
  });

  if (WebcastEvent.STREAM_END) {
    connection.on(WebcastEvent.STREAM_END, () => {
      if (connection !== activeConn) return;
      connection = null;
      activeUsername = "";
      broadcast({ type: "status", state: "disconnected", message: "Canlı yayın sona erdi." });
    });
  }
}

wss.on("connection", ws => {
  ws.on("error", () => {});

  try {
    ws.send(JSON.stringify({
      type: "status",
      state: connection ? "connected" : "disconnected",
      activeUsername
    }));

    ws.send(JSON.stringify({
      type: "init-leaderboard",
      goalkeepers: topKeepers,
      teams: teamScores
    }));
  } catch {}

  ws.on("message", raw => {
    let msg;
    try { msg = JSON.parse(raw); } catch { return; }

    if (msg.type === "connect") connect(msg.username);
    else if (msg.type === "disconnect") disconnect();
    else if (msg.type === "update-leaderboard") {
      if (Array.isArray(msg.goalkeepers)) topKeepers = msg.goalkeepers;
      if (msg.teams) teamScores = msg.teams;
      broadcast({
        type: "sync-leaderboard",
        goalkeepers: topKeepers,
        teams: teamScores
      });
    } else if (msg.type === "trigger-team-goal") {
      const teamKey = String(msg.team || "turkiye").toLowerCase();
      teamScores[teamKey] = (teamScores[teamKey] || 0) + 1;
      broadcast({
        type: "sync-leaderboard",
        goalkeepers: topKeepers,
        teams: teamScores
      });
    } else if (msg.type === "trigger-keeper-save") {
      const uname = String(msg.username || "Kaleci").trim();
      const kType = msg.keeperType || "normal";
      let existing = topKeepers.find(k => k.username.toLowerCase() === uname.toLowerCase());
      if (existing) {
        existing.saves = (existing.saves || 0) + 1;
        existing.keeperType = kType;
      } else {
        topKeepers.push({
          username: uname,
          saves: 1,
          keeperType: kType,
          avatar: `/api/avatar?user=${encodeURIComponent(uname)}`
        });
      }
      topKeepers.sort((a, b) => (b.saves || 0) - (a.saves || 0));
      broadcast({
        type: "sync-leaderboard",
        goalkeepers: topKeepers,
        teams: teamScores
      });
    } else if (msg.type === "reset-leaderboard") {
      topKeepers = [];
      teamScores = {
        galatasaray: 0,
        fenerbahce: 0,
        besiktas: 0,
        trabzonspor: 0,
        amedspor: 0
      };
      broadcast({
        type: "sync-leaderboard",
        goalkeepers: topKeepers,
        teams: teamScores
      });
    }
  });
});

server.listen(PORT, () => {
  console.log(`⚽ MNG Penalty Kick sunucusu http://localhost:${PORT} portunda çalışıyor.`);
});

process.on("uncaughtException", err => {
  console.warn("🛡️ Yakalanan Hata (uncaughtException):", err?.message || err);
});

process.on("unhandledRejection", err => {
  console.warn("🛡️ Yakalanan Red (unhandledRejection):", err?.message || err);
});

process.on("exit", code => {
  console.log(`Sunucu kapandı (Exit Code: ${code})`);
});

// Event loop'u daima canlı tutan periyodik kalp atışı (Background daemon güvencesi)
setInterval(() => {}, 30000);
if (process.stdin.isTTY === false) {
  try { process.stdin.resume(); } catch {}
}
