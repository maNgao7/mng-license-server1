app.get("/api/catalog", (_req, res) => {
  const localCatalog = path.join(__dirname, "gift-catalog.json");
  if (fs.existsSync(localCatalog)) {
    try {
      const data = JSON.parse(fs.readFileSync(localCatalog, "utf8"));
      if (Array.isArray(data) && data.length) {
        return res.json(data);
      }
    } catch {}
  }

  const giftDir = path.join(findCatalogPath(), "gift-images");
  const p = path.join(giftDir, "_kutuphane.json");
  let items = [];

  if (fs.existsSync(p)) {
    try {
      const data = JSON.parse(fs.readFileSync(p, "utf8"));
      if (Array.isArray(data) && data.length) items = data;
    } catch {}
  }

  if (fs.existsSync(giftDir)) {
    try {
      const existingFiles = new Set(items.map(x => (x.file || '').toLowerCase()));
      const files = fs.readdirSync(giftDir).filter(f => f.endsWith(".png") && !f.startsWith("."));
      files.forEach(f => {
        if (!existingFiles.has(f.toLowerCase())) {
          items.push({
            name: f.replace(/\.png$/i, "").replace(/_/g, " "),
            file: f,
            coins: 1,
            duplicate_image: false
          });
        }
      });
    } catch {}
  }

  res.json(items);
});

app.get("/api/sounds", (_req, res) => {
  const dir = path.join(__dirname, "public", "sounds");
  if (!fs.existsSync(dir)) return res.json([]);
  try {
    const files = fs.readdirSync(dir);
    res.json(files);
  } catch {
    res.json([]);
  }
});

