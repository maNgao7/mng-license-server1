  byId("introScreen").style.display = "flex";
});
byId("restartBtn").addEventListener("click", startGame);

// --- TİKTOK BAĞLANTISI (WEBSOCKET) ---
let socket = null;

function initSocket() {
  socket = new WebSocket(`ws://${location.host}`);

  socket.addEventListener("open", () => {
    console.log("Sunucu WebSocket bağlantısı kuruldu.");
    const autoUser = new URLSearchParams(location.search).get("autoUser");
    if (autoUser) {
      byId("username").value = autoUser;
      localStorage.setItem("mng_crowd_last_user", autoUser);
      socket.send(JSON.stringify({ type: "connect", username: autoUser }));
      byId("introStatus").textContent = `@${autoUser} yayınına otomatik bağlanılıyor...`;
    }
  });

  socket.addEventListener("message", (e) => {
    let msg;
    try { msg = JSON.parse(e.data); } catch { return; }

    if (msg.type === "status") {
      byId("introStatus").textContent = msg.message;
      if (msg.state === "connected") {
        byId("connectBtn").textContent = "✓ Bağlandı";
        byId("connectBtn").disabled = true;
        byId("startSection").style.display = "flex";
      } else if (msg.state === "idle" || msg.state === "error") {
        byId("connectBtn").textContent = "Yayına Bağlan";
        byId("connectBtn").disabled = false;
      }
    }

    if (msg.type === "crowd-event") {
      if (msg.event === "gift") {
        const matchedRule = settings.rules.find((r) =>
          String(r.id) === String(msg.giftId) ||
          r.name.toLowerCase() === String(msg.giftName).toLowerCase()
        ) || {
          action: Number(msg.coins) >= 500 ? "boss" : Number(msg.coins) >= 100 ? "heavy_wave" : Number(msg.coins) >= 20 ? "medium_wave" : "small_wave",
          count: Math.min(30, Math.max(1, msg.count || 1))
        };

        triggerGiftAction(matchedRule, msg.player);
      } else if (msg.event === "like") {
        const batch = Math.max(1, Number(msg.count || 1));
        const sender = msg.player || { nickname: "İzleyici", avatar: null };
        const pId = sender.id || sender.nickname;
        const currentLikes = (userLikes.get(pId) || 0) + batch;
        userLikes.set(pId, currentLikes);

        const threshold = Math.max(5, settings.likeThreshold || 50);
        let triggeredWaves = 0;
        while (userLikes.get(pId) >= threshold && triggeredWaves < 10) {
          userLikes.set(pId, userLikes.get(pId) - threshold);
          triggeredWaves++;
        }

        if (triggeredWaves > 0) {
          for (let w = 0; w < triggeredWaves; w++) {
            triggerGiftAction({
              action: settings.likeAction || "small_wave",
              count: settings.likeCount || 3,
              name: "Beğeni"
            }, sender);
          }
          showToast(`👍 @${sender.nickname} ${threshold * triggeredWaves} beğeni gönderdi!`, "#4de1ff");
        }
      } else if (msg.event === "follow") {
        const sender = msg.player || { nickname: "Yeni Takipçi", avatar: null };
        showToast(`⭐ @${sender.nickname} takip etti!`, "#2bd9a4");
        triggerGiftAction({
          action: settings.followAction || "small_wave",
          count: settings.followCount || 5,
          name: "Takip"
        }, sender);
      }
    }
  });

  socket.addEventListener("close", () => {
    setTimeout(initSocket, 2000);
  });
}

// --- FORM İŞLEYİCİSİ ---
const savedUser = localStorage.getItem("mng_crowd_last_user") || "";
if (savedUser) byId("username").value = savedUser;

byId("connectForm").addEventListener("submit", (e) => {
  e.preventDefault();
  const username = byId("username").value.trim();
  if (!username) return;
  localStorage.setItem("mng_crowd_last_user", username);

  byId("connectBtn").disabled = true;
  byId("connectBtn").textContent = "Bağlanılıyor...";
  byId("introStatus").textContent = `@${username} yayını aranıyor...`;

  if (socket && socket.readyState === WebSocket.OPEN) {
    socket.send(JSON.stringify({ type: "connect", username }));
  }
});

