  settings.dmg = 8;
  settings.fireRate = 15;
  settings.maxLives = 5;
  settings.bossHp = 1500;
  settings.megaHp = 5000;
  settings.megaGoal = 50;
  settings.obstacleScale = 1.0;
  settings.nameScale = 1.0;
  settings.likeThreshold = 50;
  settings.likeAction = "small_wave";
  settings.likeCount = 3;
  settings.followAction = "small_wave";
