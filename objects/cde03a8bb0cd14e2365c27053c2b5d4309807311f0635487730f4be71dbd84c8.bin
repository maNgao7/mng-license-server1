const byId = (id) => document.getElementById(id);
const canvas = byId("gameCanvas");
const ctx = canvas.getContext("2d");

// --- AUDIO SİSTEMİ (Web Audio API) ---
let audioCtx = null;
let soundEnabled = true;

function initAudio() {
  if (!audioCtx) {
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    if (AudioCtx) audioCtx = new AudioCtx();
  }
  if (audioCtx && audioCtx.state === "suspended") {
    audioCtx.resume().catch(() => {});
  }
}
["pointerdown", "keydown"].forEach((ev) => window.addEventListener(ev, initAudio, { once: true }));

function playTone(freq, duration, type = "sine", vol = 0.15, toFreq = null, delay = 0) {
  if (!soundEnabled || !audioCtx) return;
  try {
    const t = audioCtx.currentTime + delay;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, t);
    if (toFreq) osc.frequency.exponentialRampToValueAtTime(toFreq, t + duration);
    gain.gain.setValueAtTime(vol, t);
    gain.gain.exponentialRampToValueAtTime(0.001, t + duration);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(t);
    osc.stop(t + duration);
  } catch {}
}

const SFX = {
  shoot() { playTone(880, 0.07, "square", 0.05, 300); },
  hit() { playTone(220, 0.3, "sawtooth", 0.25, 50); playTone(90, 0.25, "square", 0.2, 40); },
  enemyHit() { playTone(160, 0.08, "sawtooth", 0.1, 70); },
  bossHit() { playTone(120, 0.12, "sawtooth", 0.18, 50); },
  gift() { playTone(660, 0.18, "sine", 0.15, 880); },
  shield() { playTone(500, 0.25, "sine", 0.18, 1200); playTone(750, 0.3, "triangle", 0.12, 1500, 0.08); },
  life() { [523, 659, 784, 1046].forEach((f, i) => playTone(f, 0.18, "triangle", 0.14, null, i * 0.06)); },
  boss() { playTone(70, 1.2, "sawtooth", 0.3, 35); playTone(140, 1.0, "square", 0.15, 50, 0.1); },
  megaBoss() {
    playTone(55, 2.0, "sawtooth", 0.45, 25);
    playTone(110, 1.6, "square", 0.3, 40, 0.15);
    playTone(40, 2.5, "sine", 0.5, 20);
  },
  bossDefeat() { [523, 659, 784, 1046, 1318].forEach((f, i) => playTone(f, 0.25, "triangle", 0.18, null, i * 0.08)); },
  gameOver() { [392, 330, 262, 196].forEach((f, i) => playTone(f, 0.35, "triangle", 0.2, null, i * 0.2)); }
};

