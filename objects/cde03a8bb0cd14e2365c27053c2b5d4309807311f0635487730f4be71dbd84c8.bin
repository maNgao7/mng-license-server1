// --- OBS WİDGET BUTONU ---
byId("widgetBtn").addEventListener("click", async () => {
  try {
    const response = await fetch("/api/launcher-widget-links", { cache: "no-store" });
    const data = await response.json();
    const widgetUrl = data.links?.ranking;
    if (!response.ok || !data.ready || typeof widgetUrl !== "string" || new URL(widgetUrl).protocol !== "https:") throw new Error(data.message || "HTTPS yayın bağlantısı hazır değil. Launcher içinden yayın bağlantısını hazırlayın.");
    try { await navigator.clipboard.writeText(widgetUrl); showToast("🏆 OBS Widget Bağlantısı Kopyalandı!", "#ffd166"); }
    catch { prompt("OBS Browser Kaynağına ekleyeceğiniz bağlantı:", widgetUrl); }
  } catch (error) { showToast(error.message || "HTTPS yayın bağlantısı kullanılamıyor.", "#ff6b6b"); }
});

