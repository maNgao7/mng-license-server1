/* ==========================================================================
   MNG UÇURUMDA DENGE 3D - MODERN GLASS STYLESHEET
   ========================================================================== */

:root {
  --bg-dark: #070d18;
  --panel-bg: rgba(15, 23, 42, 0.78);
  --panel-border: rgba(255, 255, 255, 0.14);
  --accent-gold: #facc15;
  --accent-gold-glow: rgba(250, 204, 21, 0.45);
  --team-blue: #0284c7;
  --team-blue-light: #38bdf8;
  --team-blue-glow: rgba(56, 189, 248, 0.5);
  --team-red: #e11d48;
  --team-red-light: #fb7185;
  --team-red-glow: rgba(244, 63, 94, 0.5);
  --font-main: 'Montserrat', sans-serif;
  --font-heading: 'Teko', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
  -webkit-user-select: none;
}

html, body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: var(--bg-dark);
  font-family: var(--font-main);
  color: #ffffff;
  position: relative;
}

#game-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

/* 3D Three.js Canvas */
#three-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 1;
}

/* ==========================================================================
   1. GİRİŞ EKRANI & LOBİ (INTRO OVERLAY)
   ========================================================================== */
.intro-screen-overlay {
  position: absolute;
  inset: 0;
  z-index: 100;
  background: radial-gradient(circle at center, rgba(14, 23, 42, 0.88) 0%, rgba(3, 7, 18, 0.96) 100%);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.4s ease, visibility 0.4s ease;
}

.intro-screen-overlay.hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.intro-card {
  max-height: calc(100dvh - 32px);
  overflow-y: auto;
  flex-shrink: 0;
  width: 90%;
  max-width: 520px;
  background: rgba(23, 37, 65, 0.85);
  border: 1.5px solid rgba(255, 255, 255, 0.18);
  border-radius: 28px;
  padding: 32px 28px;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8), 0 0 50px rgba(56, 189, 248, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  animation: introPop 0.4s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}

.character-picker { width: 100%; border: 0; padding: 0; margin: 16px 0; min-width: 0; }
.character-picker legend { color: #e2e8f0; font-size: 14px; font-weight: 700; margin: 0 auto 10px; }
.character-options { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.character-option { position: relative; display: flex; align-items: center; background: #1d343a; border: 2px solid #42545a; border-radius: 8px; cursor: pointer; overflow: hidden; min-height: 142px; transition: border-color .18s, background .18s; }
.character-option:has(input:checked) { border-color: #4ed7bd; background: #20483f; }
.character-option:has(input:focus-visible) { outline: 2px solid white; outline-offset: 3px; }
.character-option input { position: absolute; right: 8px; top: 8px; accent-color: #4ed7bd; }
.character-option img { width: 62%; height: 142px; object-fit: contain; }
.character-option span { text-align: left; font-size: 15px; font-weight: 800; color: #fff; }
.character-option small { display: block; font-size: 11px; font-weight: 500; color: #b7d0c8; margin-top: 5px; }

.voice-side, .mic-toggle { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; gap: 4px; width: 40px; height: 48px; padding: 5px; border: 1px solid #50746d; border-radius: 6px; color: #f5f8f6; background: #19342e; font-size: 19px; cursor: pointer; touch-action: none; }
.voice-side.held, .voice-side.recognized, .mic-toggle.hearing { background: #237b62; box-shadow: 0 0 12px #55db9c88; }
.mic-toggle[aria-pressed="true"] { border-color: #5ed9ab; }
.mic-level { display: block; width: 28px; height: 6px; }
.center-section .mic-toggle { position: absolute; right: -52px; margin: 0; top: 4px; width: 46px; height: 54px; }
.mic-toggle small { font-size: 8px; line-height: 1; font-weight: 900; letter-spacing: .03em; }
.center-section { position: relative; }
.team-battle-hud-card.red .voice-side { order: 3; }
@media (max-width: 700px) { .voice-side { width: 30px; height: 40px; } .center-section .mic-toggle { position: static; margin: 0; width: 32px; height: 32px; font-size: 14px; } }

@keyframes introPop {
  0% { transform: scale(0.92); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.intro-brand {
  margin-bottom: 20px;
}

.intro-icon-badge {
  font-size: 48px;
  margin-bottom: 6px;
  filter: drop-shadow(0 0 16px rgba(250, 204, 21, 0.6));
}

.intro-title {
  font-family: var(--font-heading);
  font-size: 44px;
  letter-spacing: 2px;
  line-height: 1;
  background: linear-gradient(135deg, #ffffff 30%, #38bdf8 80%, #facc15 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.intro-subtitle {
  font-size: 11px;
  letter-spacing: 1.8px;
  font-weight: 700;
  color: #94a3b8;
  margin-top: 4px;
}

/* Connection Box */
.intro-connection-box {
  width: 100%;
  background: rgba(15, 23, 42, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 18px;
  padding: 16px;
  margin-bottom: 14px;
}

.intro-input-label {
  font-size: 12px;
  font-weight: 700;
  color: #cbd5e1;
  margin-bottom: 8px;
  display: block;
  text-align: left;
}

.intro-input-row {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.45);
  border: 1.5px solid rgba(255, 255, 255, 0.15);
  border-radius: 12px;
  padding: 4px 6px 4px 12px;
  transition: border-color 0.2s ease;
}

.intro-input-row:focus-within {
  border-color: var(--team-blue-light);
  box-shadow: 0 0 12px var(--team-blue-glow);
}

.intro-input-prefix {
  font-family: var(--font-mono);
  font-size: 16px;
  font-weight: 700;
  color: var(--accent-gold);
}

.intro-input {
  flex: 1;
  background: transparent;
  border: none;
  color: #ffffff;
  font-family: var(--font-main);
  font-size: 15px;
  font-weight: 600;
  padding: 8px 10px;
  outline: none;
}

.intro-input::placeholder {
  color: #64748b;
}

.intro-btn-connect {
  background: linear-gradient(135deg, #0284c7, #0369a1);
  border: none;
  border-radius: 10px;
  color: #ffffff;
  font-family: var(--font-main);
  font-size: 13px;
  font-weight: 700;
  padding: 9px 18px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.intro-btn-connect:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(2, 132, 199, 0.5);
}

.intro-btn-profile,
.btn-profile-refresh {
  border: 1px solid #38bdf8;
  background: #0c4a6e;
  color: #fff;
  font-weight: 800;
  padding: 0 16px;
  cursor: pointer;
  white-space: nowrap;
}

.intro-btn-profile:hover,
.btn-profile-refresh:hover { background: #0369a1; }

.intro-input-row { flex-wrap: wrap; }
.intro-input-row .intro-input { min-width: 110px; flex: 1; width: 0; }
.intro-btn-profile { min-height: 36px; border-radius: 6px; font-size: 12px; }

.intro-status-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
  font-size: 11px;
  color: #94a3b8;
  text-align: left;
}

.intro-status-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  flex-shrink: 0;
}

.intro-status-dot.disconnected { background-color: #ef4444; box-shadow: 0 0 8px rgba(239, 68, 68, 0.7); }
.intro-status-dot.connecting { background-color: #f59e0b; box-shadow: 0 0 8px rgba(245, 158, 11, 0.7); animation: pulseDot 1s infinite; }
.intro-status-dot.connected { background-color: #10b981; box-shadow: 0 0 10px rgba(16, 185, 129, 0.9); }

@keyframes pulseDot { 0%, 100% { opacity: 0.4; } 50% { opacity: 1; } }

/* Distance preset chips */
.intro-distance-box {
  width: 100%;
  margin-bottom: 14px;
  text-align: left;
}

.intro-dist-label {
  font-size: 12px;
  font-weight: 700;
  color: #cbd5e1;
  display: block;
  margin-bottom: 8px;
}

.intro-dist-buttons {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}

.dist-chip {
  background: rgba(15, 23, 42, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 10px;
  color: #cbd5e1;
  font-family: var(--font-main);
  font-size: 12px;
  font-weight: 700;
  padding: 8px 10px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.dist-chip:hover {
  background: rgba(30, 41, 59, 0.9);
  border-color: rgba(255, 255, 255, 0.25);
}

.dist-chip.active {
  background: linear-gradient(135deg, rgba(2, 132, 199, 0.35), rgba(56, 189, 248, 0.2));
  border-color: var(--team-blue-light);
  color: #ffffff;
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.3);
}

/* Intro Tools: Gift Catalog & Template buttons */
.intro-tools-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  width: 100%;
  margin-bottom: 16px;
}

.btn-tool-link {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(15, 23, 42, 0.7);
  border: 1.5px solid rgba(255, 255, 255, 0.15);
  border-radius: 14px;
  padding: 10px 12px;
  text-decoration: none;
  color: #ffffff;
  cursor: pointer;
  transition: all 0.2s ease;
  text-align: left;
}

.btn-tool-link:hover {
  background: rgba(30, 41, 59, 0.95);
  border-color: var(--accent-gold);
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5);
}

.tool-icon { font-size: 22px; flex-shrink: 0; }
.tool-text { display: flex; flex-direction: column; overflow: hidden; }
.tool-title { font-size: 11.5px; font-weight: 800; color: #fde047; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
.tool-sub { font-size: 10px; color: #94a3b8; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }

/* Play button */
.intro-actions-row { width: 100%; }

.btn-play-game {
  width: 100%;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border: none;
  border-radius: 16px;
  color: #ffffff;
  font-family: var(--font-heading);
  font-size: 28px;
  letter-spacing: 1.5px;
  padding: 14px 24px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  box-shadow: 0 8px 24px rgba(16, 185, 129, 0.45);
  transition: all 0.25s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}

.btn-play-game:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 12px 30px rgba(16, 185, 129, 0.65);
}

.intro-footer-note {
  margin-top: 14px;
  font-size: 10.5px;
  color: #94a3b8;
}

/* ==========================================================================
   2. OYUN İÇİ HUD (GAME HUD LAYER)
   ========================================================================== */
.game-hud-layer {
  position: absolute;
  inset: 0;
  z-index: 10;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 16px 20px;
}

.game-hud-layer > * {
  pointer-events: auto;
}

/* Top Bar */
.hud-top-bar {
  position: relative;
  width: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  pointer-events: none;
}

.hud-left-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  pointer-events: auto;
  z-index: 30;
}

.hud-right-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  pointer-events: auto;
  z-index: 30;
}

/* ORTALANMIŞ UÇUŞ & DENGE PANELİ (EKRANIN TAM ORTASINDA KUSURSUZ SİMETRİ) */
.hud-center-flight-cluster {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  width: 580px;
  max-width: calc(100vw - 440px);
  pointer-events: auto;
  z-index: 25;
}

/* Distance Progress Tracker */
.hud-distance-tracker {
  width: 100%;
  background: var(--panel-bg);
  border: 1.5px solid var(--panel-border);
  border-radius: 18px;
  padding: 8px 16px;
  backdrop-filter: blur(16px);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
}

.dist-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
  font-size: 12px;
  font-weight: 800;
  gap: 12px;
}

.goal-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.5px;
}

.remaining-pill {
  background: rgba(239, 68, 68, 0.2);
  border: 1px solid rgba(239, 68, 68, 0.5);
  color: #fca5a5;
}
.remaining-pill .goal-val {
  color: #ffffff;
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 900;
  text-shadow: 0 0 8px rgba(239, 68, 68, 0.6);
}

.target-pill {
  background: rgba(16, 185, 129, 0.2);
  border: 1px solid rgba(16, 185, 129, 0.5);
  color: #6ee7b7;
}
.target-pill .goal-val {
  color: #ffffff;
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 900;
  text-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
}

.dist-readout {
  display: flex;
  align-items: baseline;
  gap: 4px;
  font-family: var(--font-mono);
}

.dist-current { font-size: 18px; color: var(--accent-gold); font-weight: 800; text-shadow: 0 0 10px var(--accent-gold-glow); }
.dist-sep { color: #64748b; }
.dist-total { color: #cbd5e1; }
.dist-pct { color: #94a3b8; font-size: 12px; margin-left: 4px; }

.dist-track-bar {
  position: relative;
  width: 100%;
  height: 12px;
  background: rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 10px;
  overflow: visible;
}

.dist-fill {
  height: 100%;
  border-radius: 10px;
  background: linear-gradient(90deg, #0284c7, #38bdf8 60%, #facc15 100%);
  box-shadow: 0 0 14px rgba(56, 189, 248, 0.7);
  transition: width 0.2s ease-out;
}

.dist-marker {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 18px;
  filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.9));
  transition: left 0.2s ease-out;
}

.dist-flag {
  position: absolute;
  top: -14px;
  transform: translateX(-50%);
  font-size: 12px;
  opacity: 0.8;
}

/* Right Actions */
.hud-right-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.hud-icon-btn {
  background: var(--panel-bg);
  border: 1px solid var(--panel-border);
  border-radius: 14px;
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: #ffffff;
  cursor: pointer;
  backdrop-filter: blur(12px);
  transition: all 0.2s ease;
}

.hud-icon-btn:hover {
  background: rgba(30, 41, 59, 0.95);
  transform: translateY(-2px);
  border-color: rgba(255, 255, 255, 0.3);
}

.hud-icon-btn.exit-btn:hover {
  background: rgba(239, 68, 68, 0.25);
  border-color: #ef4444;
}

/* ==========================================================================
   3. SU TERAZİSİ (SPIRIT LEVEL) & TAKIM AĞIRLIKLARI
   ========================================================================== */
.hud-spirit-level-container {
  position: static;
  transform: none;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  background: rgba(15, 23, 42, 0.90);
  border: 1.5px solid var(--panel-border);
  border-radius: 20px;
  padding: 6px 18px;
  height: 44px;
  backdrop-filter: blur(20px);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.7);
  z-index: 20;
  pointer-events: auto;
}

.team-badge {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 140px;
}

.team-badge.right-team { justify-content: flex-end; }

.team-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
}
.team-dot.blue { background: var(--team-blue-light); box-shadow: 0 0 12px var(--team-blue-glow); }
.team-dot.red { background: var(--team-red-light); box-shadow: 0 0 12px var(--team-red-glow); }

.team-info { display: flex; flex-direction: column; }
.team-info.align-right { text-align: right; }

.team-title {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
}
.left-team .team-title { color: var(--team-blue-light); }
.right-team .team-title { color: var(--team-red-light); }

.team-weight {
  font-family: var(--font-mono);
  font-size: 18px;
  font-weight: 800;
  color: #ffffff;
}

.spirit-gauge-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.spirit-gauge-tube {
  position: relative;
  width: 240px;
  height: 20px;
  background: rgba(0, 0, 0, 0.65);
  border: 2px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.8);
}

.spirit-safe-center {
  position: absolute;
  top: 0; bottom: 0;
  left: calc(50% - 24px);
  width: 48px;
  background: rgba(16, 185, 129, 0.2);
  border-left: 1.5px dashed rgba(16, 185, 129, 0.7);
  border-right: 1.5px dashed rgba(16, 185, 129, 0.7);
}

.spirit-center-pin {
  position: absolute;
  top: 0; bottom: 0;
  left: 50%;
  width: 2px;
  background: rgba(255, 255, 255, 0.8);
  transform: translateX(-50%);
}

.spirit-bubble {
  position: absolute;
  top: 2px;
  width: 26px;
  height: 12px;
  border-radius: 8px;
  background: radial-gradient(circle at 35% 35%, #67e8f9, #06b6d4);
  box-shadow: 0 0 10px rgba(6, 182, 212, 0.9);
  transform: translateX(-50%);
  transition: left 0.08s ease-out;
}

.spirit-readout {
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 800;
  color: #a7f3d0;
  letter-spacing: 0.5px;
}

/* ==========================================================================
   4. TEHLİKE / OLAY OVERLAYLERİ
   ========================================================================== */
.warning-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  box-shadow: inset 0 0 120px rgba(239, 68, 68, 0);
  transition: box-shadow 0.2s ease;
  z-index: 5;
}

.warning-vignette.active {
  box-shadow: inset 0 0 140px rgba(239, 68, 68, 0.75);
  animation: pulseVignette 0.8s infinite alternate;
}

@keyframes pulseVignette {
  0% { box-shadow: inset 0 0 100px rgba(239, 68, 68, 0.5); }
  100% { box-shadow: inset 0 0 160px rgba(239, 68, 68, 0.9); }
}

.tilt-warning-box {
  position: absolute;
  top: 140px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(239, 68, 68, 0.9);
  border: 2px solid #ffffff;
  border-radius: 16px;
  padding: 10px 22px;
  display: none;
  align-items: center;
  gap: 10px;
  font-weight: 800;
  font-size: 13px;
  color: #ffffff;
  box-shadow: 0 8px 30px rgba(239, 68, 68, 0.6);
  animation: shakeWarning 0.3s infinite;
  z-index: 15;
}

.tilt-warning-box.active { display: flex; }

.tilt-warning-box.overload-box {
  top: 195px;
  background: linear-gradient(135deg, rgba(220, 38, 38, 0.95), rgba(153, 27, 27, 0.95));
  border: 2px solid #fca5a5;
  box-shadow: 0 0 35px rgba(239, 68, 68, 0.8), 0 8px 24px rgba(0, 0, 0, 0.6);
  animation: pulseOverload 0.4s infinite alternate;
}

@keyframes pulseOverload {
  0% { transform: translateX(-50%) scale(1); filter: brightness(1); }
  100% { transform: translateX(-50%) scale(1.04); filter: brightness(1.2); }
}

@keyframes shakeWarning {
  0%, 100% { transform: translateX(-50%) rotate(0deg); }
  25% { transform: translateX(-52%) rotate(-1deg); }
  75% { transform: translateX(-48%) rotate(1deg); }
}

/* Event Overlays (Fall & Victory) */
.game-event-overlay {
  position: absolute;
  inset: 0;
  background: rgba(3, 7, 18, 0.85);
  backdrop-filter: blur(16px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.game-event-overlay.active { display: flex; }

.event-card {
  background: rgba(30, 41, 59, 0.95);
  border: 2px solid rgba(255, 255, 255, 0.2);
  border-radius: 28px;
  padding: 36px 32px;
  max-width: 440px;
  width: 90%;
  text-align: center;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
  animation: introPop 0.35s ease;
}

.fall-card { border-color: rgba(239, 68, 68, 0.6); }
.victory-card { border-color: rgba(250, 204, 21, 0.7); }

.event-emoji { font-size: 54px; margin-bottom: 8px; }

.event-card h2 {
  font-family: var(--font-heading);
  font-size: 38px;
  letter-spacing: 1px;
  line-height: 1.1;
  margin-bottom: 8px;
}

.fall-card h2 { color: #f87171; }
.victory-card h2 { color: #fde047; }

.event-card p {
  font-size: 13px;
  color: #cbd5e1;
  margin-bottom: 16px;
}

.parachute-status {
  font-size: 13px;
  font-weight: 700;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.15);
  padding: 8px 14px;
  border-radius: 12px;
}

.btn-celebrate-next {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  border: none;
  border-radius: 14px;
  color: #ffffff;
  font-family: var(--font-heading);
  font-size: 24px;
  letter-spacing: 1px;
  padding: 12px 24px;
  cursor: pointer;
  width: 100%;
  box-shadow: 0 6px 20px rgba(245, 158, 11, 0.5);
}

/* ==========================================================================
   5. ALT HIZLI TEST BARI (CANLI YAYIN TESTİ)
   ========================================================================== */
/* HUD Top Action Pill (Catalog Button) */
.hud-action-pill {
  background: linear-gradient(135deg, rgba(234, 88, 12, 0.4), rgba(245, 158, 11, 0.25));
  border: 1.5px solid rgba(245, 158, 11, 0.5);
  border-radius: 14px;
  color: #fde047;
  font-family: var(--font-main);
  font-size: 12px;
  font-weight: 800;
  padding: 8px 14px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s ease;
  backdrop-filter: blur(12px);
}

.hud-action-pill:hover {
  background: linear-gradient(135deg, rgba(234, 88, 12, 0.7), rgba(245, 158, 11, 0.45));
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(245, 158, 11, 0.35);
}

.hud-icon-btn.active {
  color: var(--accent-gold);
  border-color: rgba(250, 204, 21, 0.4);
}

/* ==========================================================================
   TRANSPARENT TEAM WEIGHT LEADERBOARD WIDGETS (ÇALIŞAN ŞEFFAF WIDGETLAR)
   ========================================================================== */
.team-leaderboard-widget {
  position: absolute;
  top: 125px;
  width: 215px;
  max-height: 290px;
  display: flex;
  flex-direction: column;
  background: rgba(10, 15, 29, 0.42); /* Şeffaf transparan arka plan */
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 14px;
  border: 1.5px solid rgba(255, 255, 255, 0.12);
  padding: 8px 10px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  z-index: 25;
  transition: all 0.3s ease;
}

.team-leaderboard-widget.left-side {
  left: 16px;
  border-color: rgba(56, 189, 248, 0.35);
  box-shadow: 0 6px 24px rgba(2, 132, 199, 0.2);
}

.team-leaderboard-widget.right-side {
  right: 16px;
  border-color: rgba(244, 63, 94, 0.35);
  box-shadow: 0 6px 24px rgba(225, 29, 72, 0.2);
}

.tlb-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 5px;
  margin-bottom: 6px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  font-size: 9.5px;
  font-weight: 800;
  letter-spacing: 0.4px;
}

.tlb-header.blue { color: #38bdf8; }
.tlb-header.red { color: #fb7185; }

.tlb-header .tlb-title {
  flex: 1;
  margin: 0 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-transform: uppercase;
}

.tlb-header .tlb-total {
  font-family: var(--font-mono);
  font-size: 11px;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
  padding: 1px 5px;
  border-radius: 6px;
}

.tlb-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
  overflow-y: auto;
  max-height: 200px;
}

.tlb-list::-webkit-scrollbar {
  width: 3px;
}
.tlb-list::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 3px;
}

.tlb-item, .tlb-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 3px 6px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.04);
  transition: background 0.15s ease;
}
.tlb-item:hover, .tlb-row:hover {
  background: rgba(255, 255, 255, 0.09);
}

.tlb-item.top-1 {
  background: rgba(250, 204, 21, 0.12);
  border: 1px solid rgba(250, 204, 21, 0.35);
}
.tlb-item.top-2 {
  background: rgba(226, 232, 240, 0.08);
  border: 1px solid rgba(226, 232, 240, 0.25);
}
.tlb-item.top-3 {
  background: rgba(249, 115, 22, 0.08);
  border: 1px solid rgba(249, 115, 22, 0.25);
}

.tlb-rank {
  font-size: 10px;
  font-weight: 900;
  min-width: 14px;
  text-align: center;
}
.tlb-rank.gold { color: #facc15; }
.tlb-rank.silver { color: #e2e8f0; }
.tlb-rank.bronze { color: #f97316; }
.tlb-rank.other { color: #94a3b8; }

.tlb-avatar {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.3);
  object-fit: cover;
  flex-shrink: 0;
}

.tlb-name-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  line-height: 1.1;
}

.tlb-nick, .tlb-name {
  flex: 1;
  font-size: 9.5px;
  font-weight: 700;
  color: #f8fafc;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tlb-subgift {
  font-size: 8px;
  color: #94a3b8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tlb-kg, .tlb-weight {
  font-family: var(--font-mono);
  font-size: 9.5px;
  font-weight: 800;
  color: #fde047;
  flex-shrink: 0;
}

.tlb-action-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 4px;
  color: #ffffff;
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 800;
  width: 16px;
  height: 16px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.15s ease;
  line-height: 1;
  padding: 0;
  flex-shrink: 0;
}
.tlb-action-btn:hover {
  background: rgba(255, 255, 255, 0.25);
  transform: scale(1.1);
}
.tlb-action-btn.minus:hover {
  background: rgba(239, 68, 68, 0.4);
  border-color: #ef4444;
}
.tlb-action-btn.plus:hover {
  background: rgba(16, 185, 129, 0.4);
  border-color: #10b981;
}
.tlb-actions-wrap {
  display: flex;
  gap: 2px;
  align-items: center;
  margin-left: 2px;
}

.tlb-empty {
  font-size: 9.5px;
  color: #64748b;
  text-align: center;
  padding: 12px 0;
  font-style: italic;
}

.tb-gift-tag.clickable {
  cursor: pointer;
  transition: all 0.2s ease;
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.18);
  font-family: var(--font-main);
  text-align: left;
}
.tb-gift-tag.clickable:hover {
  background: rgba(255, 255, 255, 0.12);
  transform: translateY(-2px);
  border-color: rgba(255, 255, 255, 0.4);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
}
.tb-gift-text-wrap {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}
.tb-change-hint {
  font-size: 8px;
  color: #38bdf8;
  font-weight: 800;
  letter-spacing: 0.3px;
}
.team-battle-hud-card.red .tb-change-hint {
  color: #fb7185;
}

/* ==========================================================================
   5. ALT GÖRSEL HEDİYE VE HIZLI TEST BARI
   ========================================================================== */
.hud-bottom-gift-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  background: rgba(15, 23, 42, 0.9);
  border: 1.5px solid var(--panel-border);
  border-radius: 22px;
  padding: 8px 16px;
  backdrop-filter: blur(20px);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.7);
}

/* Sleek Broadcast Team Battle Cards */
.team-battle-hud-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  background: rgba(15, 23, 42, 0.85);
  border: 1.5px solid rgba(255, 255, 255, 0.12);
  border-radius: 18px;
  padding: 8px 16px;
  min-width: 210px;
  backdrop-filter: blur(16px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  transition: all 0.25s ease;
}

.team-battle-hud-card.blue {
  border-color: rgba(56, 189, 248, 0.45);
  background: linear-gradient(135deg, rgba(2, 132, 199, 0.22) 0%, rgba(15, 23, 42, 0.85) 100%);
  box-shadow: 0 0 20px rgba(2, 132, 199, 0.25);
}

.team-battle-hud-card.red {
  border-color: rgba(244, 63, 94, 0.45);
  background: linear-gradient(135deg, rgba(225, 29, 72, 0.22) 0%, rgba(15, 23, 42, 0.85) 100%);
  box-shadow: 0 0 20px rgba(225, 29, 72, 0.25);
}

.tb-left-col {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.tb-header {
  display: flex;
  align-items: center;
  gap: 8px;
}

.tb-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}
.tb-dot.blue { background: #38bdf8; box-shadow: 0 0 10px #38bdf8; }
.tb-dot.red { background: #fb7185; box-shadow: 0 0 10px #fb7185; }

.tb-name {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.6px;
}
.team-battle-hud-card.blue .tb-name { color: #7dd3fc; }
.team-battle-hud-card.red .tb-name { color: #fda4af; }

.tb-weight-box {
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.tb-weight {
  font-family: var(--font-mono);
  font-size: 22px;
  font-weight: 900;
  color: #ffffff;
  line-height: 1.1;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
  white-space: nowrap;
}

.tb-right-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
}

.tb-gift-control-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
}

.tb-gift-tag {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(0, 0, 0, 0.45);
  padding: 4px 8px;
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  cursor: pointer;
  transition: all 0.2s ease;
}
.tb-gift-tag:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.3);
}

.tb-gift-icon {
  font-size: 15px;
}

.tb-gift-name {
  font-size: 11px;
  font-weight: 800;
  color: #f1f5f9;
}

.tb-change-hint {
  font-size: 10px;
  font-weight: 700;
  color: #94a3b8;
  margin-left: 2px;
}

.tb-quick-kg-box {
  display: flex;
  align-items: center;
  gap: 3px;
  background: rgba(15, 23, 42, 0.85);
  border: 1.5px solid rgba(250, 204, 21, 0.55);
  border-radius: 10px;
  padding: 4px 7px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  transition: border-color 0.2s ease;
}
.tb-kg-caption { font-size: 8px; font-weight: 900; color: #facc15; margin-right: 2px; }
.tb-quick-kg-input { width: 34px; font-size: 14px; font-weight: 900; text-align: center; }
.tb-quick-kg-box:focus-within {
  border-color: #facc15;
  box-shadow: 0 0 10px rgba(250, 204, 21, 0.6);
}

.btn-hud-step {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 17px;
  height: 19px;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 4px;
  color: #ffffff;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  padding: 0;
  line-height: 1;
  transition: all 0.15s ease;
  user-select: none;
}
.btn-hud-step:hover {
  background: rgba(255, 255, 255, 0.25);
  border-color: #facc15;
  color: #facc15;
}
.btn-hud-step:active {
  transform: scale(0.90);
}

.tb-quick-kg-input {
  width: 44px;
  background: transparent;
  border: none;
  color: #facc15;
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 900;
  text-align: center;
  outline: none;
  padding: 0 2px;
}
.tb-quick-kg-input::-webkit-inner-spin-button,
.tb-quick-kg-input::-webkit-outer-spin-button {
  opacity: 0.6;
}

.tb-quick-kg-unit {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 800;
  color: #cbd5e1;
}

.btn-team-test-drop {
  border: none;
  border-radius: 10px;
  padding: 5px 12px;
  font-family: var(--font-main);
  font-size: 11px;
  font-weight: 800;
  color: #ffffff;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}

.btn-team-test-drop.blue {
  background: linear-gradient(135deg, #0284c7, #0369a1);
  box-shadow: 0 2px 10px rgba(2, 132, 199, 0.4);
}
.btn-team-test-drop.blue:hover {
  transform: translateY(-2px);
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  box-shadow: 0 4px 16px rgba(2, 132, 199, 0.6);
}

.btn-team-test-drop.red {
  background: linear-gradient(135deg, #e11d48, #be123c);
  box-shadow: 0 2px 10px rgba(225, 29, 72, 0.4);
}
.btn-team-test-drop.red:hover {
  transform: translateY(-2px);
  background: linear-gradient(135deg, #f43f5e, #e11d48);
  box-shadow: 0 4px 16px rgba(225, 29, 72, 0.6);
}

/* Central Manual Walk Button */
.center-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.btn-walk-hold {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border: 2px solid #34d399;
  border-radius: 16px;
  color: #ffffff;
  font-family: var(--font-heading);
  font-size: 24px;
  letter-spacing: 1px;
  padding: 8px 24px;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(16, 185, 129, 0.45);
  transition: all 0.15s ease;
  user-select: none;
}

.btn-walk-hold:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 22px rgba(16, 185, 129, 0.65);
}

.btn-walk-hold:active, .btn-walk-hold.walking {
  transform: scale(0.96);
  background: linear-gradient(135deg, #059669 0%, #047857 100%);
  box-shadow: 0 2px 10px rgba(16, 185, 129, 0.8), 0 0 16px rgba(52, 211, 153, 0.7);
  border-color: #6ee7b7;
}

.btn-walk-hold small {
  font-size: 13px;
  font-family: var(--font-main);
  font-weight: 700;
  color: #d1fae5;
  opacity: 0.9;
}

.center-sub-actions {
  display: flex;
  align-items: center;
  gap: 6px;
}

.action-btn-chip {
  background: rgba(30, 41, 59, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  color: #cbd5e1;
  font-family: var(--font-main);
  font-size: 11px;
  font-weight: 700;
  padding: 6px 12px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.action-btn-chip:hover {
  background: rgba(51, 65, 85, 0.95);
  color: #ffffff;
  border-color: var(--accent-gold);
  transform: translateY(-1px);
}

.action-btn-chip.active {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  border-color: #60a5fa;
  color: #ffffff;
  box-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
}

/* ==========================================================================
   HEDİYE KATALOĞU MODAL (686 HEDİYE)
   ========================================================================== */
#catalog-modal {
  z-index: 150;
}

.catalog-dialog {
  max-width: 1040px !important;
  width: 94% !important;
  height: 86vh;
  display: flex;
  flex-direction: column;
}

.catalog-picking-banner {
  background: linear-gradient(135deg, rgba(2, 132, 199, 0.95), rgba(30, 58, 138, 0.95));
  border: 1.5px solid #38bdf8;
  border-radius: 12px;
  padding: 10px 16px;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-shadow: 0 4px 16px rgba(56, 189, 248, 0.35);
}

.catalog-picking-banner .picking-text {
  font-size: 13px;
  font-weight: 700;
  color: #ffffff;
}

.catalog-picking-banner .btn-cancel-pick {
  background: rgba(239, 68, 68, 0.3);
  border: 1px solid rgba(239, 68, 68, 0.6);
  color: #ffffff;
  padding: 5px 12px;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.catalog-picking-banner .btn-cancel-pick:hover {
  background: #ef4444;
}

.catalog-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
  flex-wrap: wrap;
}

.catalog-search-wrap {
  flex: 1;
  min-width: 260px;
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.5);
  border: 1.5px solid rgba(255, 255, 255, 0.15);
  border-radius: 12px;
  padding: 6px 12px;
  gap: 8px;
}

.catalog-search-wrap:focus-within {
  border-color: var(--accent-gold);
  box-shadow: 0 0 12px var(--accent-gold-glow);
}

.catalog-search-wrap input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: #ffffff;
  font-family: var(--font-main);
  font-size: 13px;
  font-weight: 600;
}

.catalog-filter-tabs {
  display: flex;
  gap: 6px;
}

.tab-btn {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 10px;
  padding: 7px 14px;
  color: #94a3b8;
  font-family: var(--font-main);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.tab-btn:hover { color: #ffffff; background: rgba(30, 41, 59, 0.9); }
.tab-btn.active {
  background: var(--team-blue);
  border-color: var(--team-blue-light);
  color: #ffffff;
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.35);
}

.catalog-grid {
  flex: 1;
  overflow-y: auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 6px 4px;
}

.catalog-item-card {
  background: rgba(15, 23, 42, 0.75);
  border: 1.5px solid rgba(255, 255, 255, 0.12);
  border-radius: 8px;
  padding: 10px 14px;
  display: grid;
  grid-template-columns: 52px minmax(90px, 1fr) 116px 190px;
  gap: 14px;
  min-height: 76px;
  flex-shrink: 0;
  align-items: center;
  text-align: left;
  transition: all 0.2s ease;
  cursor: pointer;
}

.catalog-item-card:hover {
  background: rgba(30, 41, 59, 0.95);
  border-color: rgba(255, 255, 255, 0.3);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
}

.catalog-item-card img {
  width: 48px;
  height: 48px;
  object-fit: contain;
  margin-bottom: 0;
}

.catalog-item-title {
  font-size: 13px;
  font-weight: 800;
  color: #ffffff;
  overflow-wrap: anywhere;
  min-width: 0;
}

.catalog-item-coins {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--accent-gold);
  margin-bottom: 0;
}

.catalog-item-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;
  width: 100%;
}
.catalog-item-title small, .catalog-item-coins small {
  display: block;
  margin-top: 5px;
  color: #aab8c0;
  font-size: 10px;
  font-weight: 600;
}
.catalog-item-actions button { min-height: 34px; }
.catalog-item-actions .btn-pick-for-rule { grid-column: 1 / -1; }
.catalog-dialog { border-radius: 8px; }
@media (max-width: 600px) {
  .catalog-item-card { grid-template-columns: 42px minmax(70px, 1fr) 86px; gap: 8px; padding: 10px; }
  .catalog-item-card img { width: 40px; height: 40px; }
  .catalog-item-actions { grid-column: 2 / -1; }
  .catalog-search-wrap { min-width: 0; width: 100%; }
  .catalog-filter-tabs { flex-wrap: wrap; }
  .catalog-item-title, .catalog-item-coins { font-size: 11px; }
  .live-connect-row { flex-wrap: wrap; }
}

.btn-assign-side {
  border: none;
  border-radius: 6px;
  padding: 5px 2px;
  font-size: 9.5px;
  font-weight: 800;
  cursor: pointer;
  color: #ffffff;
  transition: transform 0.15s ease;
}

.btn-assign-side.blue { background: #0284c7; }
.btn-assign-side.blue:hover { transform: scale(1.05); background: #0369a1; }
.btn-assign-side.red { background: #e11d48; }
.btn-assign-side.red:hover { transform: scale(1.05); background: #be123c; }

.btn-pick-for-rule {
  width: 100%;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  border: none;
  border-radius: 6px;
  padding: 6px 4px;
  font-size: 10.5px;
  font-weight: 800;
  cursor: pointer;
  color: #ffffff;
  box-shadow: 0 2px 8px rgba(245, 158, 11, 0.4);
  transition: transform 0.15s ease;
}
.btn-pick-for-rule:hover {
  transform: scale(1.04);
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
}

.catalog-hint {
  font-size: 11px;
  color: #94a3b8;
  flex: 1;
  text-align: left;
}

.intro-download-poster {
  display: flex;
  align-items: center;
  gap: 12px;
  width: min(520px, 100%);
  margin: 10px auto 0;
  padding: 9px 12px;
  color: #eef6ff;
  text-decoration: none;
  background: rgba(15, 23, 42, .82);
  border: 1px solid rgba(56, 189, 248, .45);
  border-radius: 8px;
}
.intro-download-poster:hover { background: rgba(30, 41, 59, .96); border-color: #38bdf8; }
.intro-download-poster img { width: 58px; height: 44px; object-fit: cover; border-radius: 4px; border: 1px solid rgba(255,255,255,.18); }
.intro-download-poster span { display: flex; flex-direction: column; gap: 3px; }
.intro-download-poster small { color: #9fb1c7; font-size: 10px; }

.movement-rule-card {
  margin-top: 14px;
  padding: 14px;
  background: rgba(12, 20, 34, .82);
  border: 1px solid rgba(45, 212, 191, .35);
  border-radius: 8px;
}
.movement-rule-header { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 12px; }
.movement-rule-header > div:first-child { display: flex; flex-direction: column; gap: 4px; }
.movement-rule-header small { color: #94a3b8; }
.social-distance-settings { display: flex; gap: 10px; flex-wrap: wrap; }
.social-distance-settings label { color: #cbd5e1; font-size: 11px; }
.social-distance-settings input, .movement-meter-input { width: 58px; background: #07101f; color: #fff; border: 1px solid #475569; border-radius: 5px; padding: 6px; }
.movement-rules-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.movement-rule-row { display: grid; grid-template-columns: 42px minmax(90px,1fr) 62px auto 62px 76px; gap: 8px; align-items: center; min-height: 58px; padding: 8px; background: rgba(30, 41, 59, .8); border: 1px solid rgba(255,255,255,.1); border-radius: 7px; }
.movement-rule-row img { width: 38px; height: 38px; object-fit: contain; }
.movement-rule-row div { display: flex; flex-direction: column; min-width: 0; }
.movement-rule-row small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #9fb1c7; }
.movement-rule-row span { color: #a7f3d0; font-size: 10px; }
.movement-fixed-label { grid-column: span 2; }
.btn-change-movement { min-height: 32px; border: 1px solid #2dd4bf; border-radius: 6px; background: #123c45; color: #e6fffb; cursor: pointer; }
.btn-test-movement, .btn-social-test { min-height: 30px; border: 1px solid #fbbf24; border-radius: 6px; background: #4a3210; color: #fff7d6; cursor: pointer; font-weight: 800; }
.btn-social-test { margin-left: 5px; padding: 4px 8px; min-height: 26px; }
@media (max-width: 800px) { .movement-rules-list { grid-template-columns: 1fr; } .movement-rule-header { align-items: stretch; flex-direction: column; } }

/* ==========================================================================
   6. AYARLAR MODAL
   ========================================================================== */
.modal-backdrop {
  position: absolute;
  inset: 0;
  z-index: 120;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(12px);
  display: none;
  align-items: center;
  justify-content: center;
}

.modal-backdrop.active { display: flex; }

.modal-dialog {
  background: rgba(23, 37, 65, 0.95);
  border: 1.5px solid rgba(255, 255, 255, 0.2);
  border-radius: 24px;
  padding: 24px 28px;
  max-width: 480px;
  width: 90%;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
  animation: introPop 0.25s ease;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.modal-header h3 {
  font-size: 18px;
  font-weight: 800;
}

.modal-close-btn {
  background: transparent;
  border: none;
  color: #94a3b8;
  font-size: 20px;
  cursor: pointer;
}
.modal-close-btn:hover { color: #ffffff; }

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
  text-align: left;
}

.form-group label {
  font-size: 12px;
  font-weight: 700;
  color: #cbd5e1;
}

.form-group input[type="text"],
.form-group input[type="number"],
.form-group select {
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 10px;
  padding: 8px 12px;
  font-family: var(--font-main);
  font-size: 14px;
  color: #ffffff;
  outline: none;
}

.form-row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.modal-dist-chips {
  display: flex;
  gap: 6px;
  margin-bottom: 4px;
}

.chip-setting {
  flex: 1;
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;
  padding: 6px 4px;
  font-size: 11px;
  font-weight: 700;
  color: #cbd5e1;
  cursor: pointer;
}

.chip-setting.active {
  background: var(--team-blue);
  border-color: var(--team-blue-light);
  color: #ffffff;
}

.range-val {
  font-size: 11px;
  color: #94a3b8;
  font-weight: 600;
}

.modal-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 20px;
}

.btn-cancel {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 10px;
  color: #cbd5e1;
  font-family: var(--font-main);
  font-size: 13px;
  font-weight: 700;
  padding: 8px 18px;
  cursor: pointer;
}

.btn-save {
  background: linear-gradient(135deg, #0284c7, #0369a1);
  border: none;
  border-radius: 10px;
  color: #ffffff;
  font-family: var(--font-main);
  font-size: 13px;
  font-weight: 700;
  padding: 8px 20px;
  cursor: pointer;
}

/* Responsive adjustments */
@media (max-width: 900px) {
  .hud-spirit-level-container { padding: 6px 14px; gap: 8px; }
  .spirit-gauge-tube { width: 150px; }
  .hud-bottom-test-bar { flex-wrap: wrap; justify-content: center; }
}

/* ==========================================================================
   HEDİYE AĞIRLIK & 3D PROFİL BOYUT AYARLARI CSS
   ========================================================================== */
.form-group-section {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 14px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.section-title-label {
  font-size: 13px;
  font-weight: 800;
  color: var(--accent-gold);
  letter-spacing: 0.5px;
}

.section-hint {
  font-size: 11px;
  color: #94a3b8;
  line-height: 1.4;
  margin-bottom: 6px;
}

.gift-weight-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

@media (max-width: 600px) {
  .gift-weight-grid {
    grid-template-columns: 1fr 1fr;
  }
}

.gift-weight-item {
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  padding: 8px 10px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.gift-weight-item.mega {
  grid-column: 1 / -1;
  border-color: rgba(250, 204, 21, 0.4);
  background: rgba(113, 63, 18, 0.25);
}

.gw-name {
  font-size: 12px;
  font-weight: 700;
  color: #e2e8f0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.gw-input {
  width: 54px;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 6px;
  color: #ffffff;
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 800;
  text-align: center;
  padding: 4px;
  outline: none;
}

.gw-input:focus {
  border-color: var(--accent-gold);
  box-shadow: 0 0 8px var(--accent-gold-glow);
}

.gw-unit {
  font-size: 11px;
  font-weight: 700;
  color: #64748b;
}

/* ==========================================================================
   YENİDEN TASARLANMIŞ BÜYÜK AYARLAR MODALI & SEKME SİSTEMİ
   ========================================================================== */
.settings-dialog-large {
  max-width: 1040px !important;
  width: 95% !important;
  max-height: 92vh;
  padding: 26px 32px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header-titles {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.modal-header-titles h3 {
  font-size: 21px !important;
  font-weight: 800;
}

.modal-subtitle {
  font-size: 13.5px;
  color: #94a3b8;
  font-weight: 500;
}

.settings-nav-tabs {
  display: flex;
  gap: 10px;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  margin-bottom: 18px;
  flex-wrap: wrap;
}

.set-tab-btn {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 12px;
  padding: 10px 18px;
  color: #94a3b8;
  font-family: var(--font-main);
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  gap: 8px;
}

.set-tab-btn:hover {
  background: rgba(30, 41, 59, 0.85);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.3);
}

.set-tab-btn.active {
  background: linear-gradient(135deg, #0284c7, #0369a1);
  color: #ffffff;
  border-color: #38bdf8;
  box-shadow: 0 0 16px rgba(56, 189, 248, 0.4);
}

.settings-scroll-body {
  flex: 1;
  overflow-y: auto;
  padding-right: 8px;
  display: flex;
  flex-direction: column;
}

.settings-scroll-body::-webkit-scrollbar {
  width: 7px;
}
.settings-scroll-body::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4px;
}

.settings-tab-pane {
  display: none;
}

.settings-tab-pane.active {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.settings-pane-intro {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 13px;
  color: #cbd5e1;
  line-height: 1.5;
}

/* ==========================================================================
   DİNAMİK HEDİYE & AĞIRLIK KURAL KARTLARI (SOL & SAĞ)
   ========================================================================== */
.team-rules-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14px;
  width: 100%;
}

@media (max-width: 768px) {
  .team-rules-grid {
    grid-template-columns: 1fr;
  }
}

.team-rule-card {
  min-width: 0;
  background: rgba(15, 23, 42, 0.75);
  border: 1.5px solid rgba(255, 255, 255, 0.14);
  border-radius: 16px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.team-rule-card.blue {
  border-color: rgba(56, 189, 248, 0.35);
  box-shadow: 0 6px 20px rgba(2, 132, 199, 0.15);
}

.team-rule-card.red {
  border-color: rgba(244, 63, 94, 0.35);
  box-shadow: 0 6px 20px rgba(225, 29, 72, 0.15);
}

.team-rule-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  padding-bottom: 10px;
}

.tr-badge {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.8px;
  padding: 4px 10px;
  border-radius: 8px;
  flex-shrink: 0;
}
.tr-badge.blue {
  background: rgba(2, 132, 199, 0.3);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.4);
}
.tr-badge.red {
  background: rgba(225, 29, 72, 0.3);
  color: #fb7185;
  border: 1px solid rgba(244, 63, 94, 0.4);
}

.tr-name-input-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
}
.tr-name-input-wrap label {
  font-size: 11.5px;
  font-weight: 700;
  color: #94a3b8;
  white-space: nowrap;
}
.tr-name-input-wrap input {
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;
  padding: 5px 8px;
  color: #ffffff;
  font-family: var(--font-main);
  font-size: 12.5px;
  font-weight: 700;
  width: 105px;
}

.team-rules-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 320px;
  overflow-y: auto;
  padding-right: 4px;
}

.team-rules-list::-webkit-scrollbar {
  width: 5px;
}
.team-rules-list::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4px;
}

.rule-row-item {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  padding: 7px 8px;
  transition: all 0.2s ease;
  min-width: 0;
}

.rule-row-item:hover {
  background: rgba(0, 0, 0, 0.6);
  border-color: rgba(255, 255, 255, 0.25);
}

.btn-rule-gift-chip {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 7px;
  background: rgba(15, 23, 42, 0.95);
  border: 1.5px solid rgba(255, 255, 255, 0.18);
  border-radius: 8px;
  padding: 5px 7px;
  color: #ffffff;
  cursor: pointer;
  transition: all 0.2s ease;
  min-width: 0;
  text-align: left;
  overflow: hidden;
}

.btn-rule-gift-chip:hover {
  background: rgba(30, 41, 59, 0.95);
  border-color: var(--accent-gold);
  box-shadow: 0 0 10px rgba(250, 204, 21, 0.25);
  transform: translateY(-1px);
}

.rule-chip-img {
  width: 28px;
  height: 28px;
  object-fit: contain;
  border-radius: 5px;
  flex-shrink: 0;
}

.rule-chip-icon {
  font-size: 20px;
  line-height: 1;
  flex-shrink: 0;
}

.rule-chip-name {
  flex: 1;
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #f8fafc;
  min-width: 0;
}

.rule-chip-action {
  font-size: 10px;
  font-weight: 700;
  color: var(--accent-gold);
  background: rgba(250, 204, 21, 0.15);
  padding: 2px 5px;
  border-radius: 4px;
  flex-shrink: 0;
}

.rule-gift-select {
  flex: 1;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;
  padding: 6px 8px;
  color: #ffffff;
  font-family: var(--font-main);
  font-size: 12.5px;
  font-weight: 600;
  outline: none;
}

.rule-kg-input-wrap {
  display: flex;
  align-items: center;
  gap: 2px;
  flex-shrink: 0;
}

.btn-rule-step {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 23px;
  height: 27px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 5px;
  color: #f8fafc;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  padding: 0;
  line-height: 1;
  transition: all 0.15s ease;
  user-select: none;
}
.btn-rule-step:hover {
  background: rgba(255, 255, 255, 0.22);
  border-color: var(--accent-gold);
  color: var(--accent-gold);
}
.btn-rule-step:active {
  transform: scale(0.92);
}

.rule-kg-input {
  width: 48px;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 6px;
  color: #ffffff;
  font-family: var(--font-mono);
  font-size: 13.5px;
  font-weight: 800;
  text-align: center;
  padding: 4px 2px;
  outline: none;
}

.rule-kg-input:focus {
  border-color: var(--accent-gold);
  box-shadow: 0 0 8px var(--accent-gold-glow);
}

.rule-kg-unit {
  font-size: 11px;
  font-weight: 700;
  color: #94a3b8;
  margin-left: 1px;
}

.btn-del-rule {
  background: rgba(239, 68, 68, 0.2);
  border: 1px solid rgba(239, 68, 68, 0.4);
  border-radius: 6px;
  color: #fca5a5;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.btn-del-rule:hover {
  background: rgba(239, 68, 68, 0.45);
  color: #ffffff;
  transform: scale(1.08);
}

.btn-add-rule {
  width: 100%;
  border: 1.5px dashed rgba(255, 255, 255, 0.25);
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12px;
  padding: 11px;
  font-family: var(--font-main);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-add-rule.blue {
  color: #7dd3fc;
  border-color: rgba(56, 189, 248, 0.4);
}
.btn-add-rule.blue:hover {
  background: rgba(2, 132, 199, 0.2);
  border-color: #38bdf8;
  color: #ffffff;
}

.btn-add-rule.red {
  color: #fda4af;
  border-color: rgba(244, 63, 94, 0.4);
}
.btn-add-rule.red:hover {
  background: rgba(225, 29, 72, 0.2);
  border-color: #fb7185;
  color: #ffffff;
}

/* ==========================================================================
   CANLI YAYIN & OBS WIDGET TAB STYLES
   ========================================================================== */
.settings-section-card {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16px;
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.settings-section-card h4 {
  font-size: 15px;
  font-weight: 800;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 8px;
}

.section-desc {
  font-size: 13px;
  color: #94a3b8;
  line-height: 1.45;
}

.live-connect-row {
  display: flex;
  gap: 12px;
  align-items: center;
}

.input-with-icon {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.45);
  border: 1.5px solid rgba(255, 255, 255, 0.15);
  border-radius: 12px;
  padding: 6px 12px;
}

.input-with-icon:focus-within {
  border-color: var(--team-blue-light);
  box-shadow: 0 0 12px var(--team-blue-glow);
}

.input-icon {
  color: var(--accent-gold);
  font-weight: 800;
  font-size: 16px;
  margin-right: 8px;
}

.input-with-icon input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: #ffffff;
  font-family: var(--font-main);
  font-size: 14px;
  font-weight: 600;
  padding: 6px 0;
}

.btn-primary-connect {
  background: linear-gradient(135deg, #0284c7, #0369a1);
  border: none;
  border-radius: 12px;
  color: #ffffff;
  font-family: var(--font-main);
  font-size: 14px;
  font-weight: 700;
  padding: 11px 22px;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.btn-primary-connect:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 14px rgba(2, 132, 199, 0.5);
}

.connection-status-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #94a3b8;
}

.status-indicator {
  width: 9px;
  height: 9px;
  border-radius: 50%;
}
.status-indicator.disconnected { background: #ef4444; box-shadow: 0 0 6px #ef4444; }
.status-indicator.connecting { background: #f59e0b; box-shadow: 0 0 6px #f59e0b; animation: pulseDot 1s infinite; }
.status-indicator.connected { background: #10b981; box-shadow: 0 0 8px #10b981; }

.obs-links-table {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.obs-link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 12px 14px;
}

.obs-link-info {
  display: flex;
  flex-direction: column;
  gap: 3px;
  overflow: hidden;
}

.obs-link-title {
  font-size: 13.5px;
  font-weight: 800;
  color: #ffffff;
}

.obs-link-url {
  font-family: var(--font-mono);
  font-size: 12px;
  color: #7dd3fc;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn-copy-widget {
  background: rgba(2, 132, 199, 0.25);
  border: 1px solid rgba(56, 189, 248, 0.4);
  border-radius: 10px;
  color: #ffffff;
  font-family: var(--font-main);
  font-size: 13px;
  font-weight: 700;
  padding: 7px 14px;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.btn-copy-widget:hover {
  background: var(--team-blue);
  box-shadow: 0 0 10px var(--team-blue-glow);
  transform: translateY(-1px);
}

.btn-copy-widget.copied {
  background: rgba(16, 185, 129, 0.35);
  border-color: #10b981;
  color: #a7f3d0;
}

/* ==========================================================================
   ARKA FON MÜZİĞİ VE SES AYARLARI KARTI
   ========================================================================== */
.settings-audio-card {
  background: linear-gradient(135deg, rgba(30, 41, 59, 0.75), rgba(15, 23, 42, 0.9));
  border: 1.5px solid rgba(245, 158, 11, 0.35);
  border-radius: 14px;
  padding: 14px 18px;
  margin-bottom: 16px;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);
}

.audio-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.audio-card-left {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.audio-tag {
  display: inline-block;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #f59e0b;
}

.audio-filename {
  font-size: 14px;
  font-weight: 700;
  color: #ffffff;
}

.audio-filename strong {
  color: #38bdf8;
}

.audio-subtext {
  font-size: 11px;
  color: #94a3b8;
}

.btn-audio-preview {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  border: none;
  border-radius: 10px;
  color: #0f172a;
  font-family: var(--font-main);
  font-size: 12px;
  font-weight: 800;
  padding: 8px 16px;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
  box-shadow: 0 4px 12px rgba(245, 158, 11, 0.35);
}

.btn-audio-preview:hover {
  transform: translateY(-1px);
  filter: brightness(1.1);
}

.btn-audio-preview.playing {
  background: linear-gradient(135deg, #10b981, #059669);
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.45);
}

@media (max-width: 800px) {
  .game-hud-layer { padding: 8px; overflow: hidden; }
  .hud-top-bar { min-height: 145px; }
  .hud-left-meta { max-width: 120px; font-size: 10px; }
  .hud-mode-pill { display: none; }
  .hud-right-actions { gap: 3px; max-width: calc(100% - 125px); flex-wrap: wrap; justify-content: flex-end; }
  .hud-right-actions button { min-width: 27px; width: 27px; height: 30px; padding: 3px; font-size: 13px; }
  #btn-hud-catalog { width: 63px; font-size: 9px; }
  .hud-center-flight-cluster { top: 65px; width: 100%; max-width: 100%; }
  .hud-distance-tracker, .hud-spirit-level-container { width: 100%; min-width: 0; padding: 7px; }
  .goal-pill { font-size: 9px; padding: 3px; }
  .goal-label, .dist-pct { display: none; }
  .dist-readout { font-size: 11px; gap: 3px; }
  .team-badge { gap: 4px; min-width: 60px; }
  .team-title { font-size: 8px; }
  .team-weight { font-size: 12px; }
  .spirit-gauge-box { width: auto; min-width: 0; flex: 1; }
  .spirit-readout { font-size: 8px; }
  .team-leaderboard-widget { top: 185px; width: 44%; min-width: 0; max-height: 72px; overflow: auto; padding: 4px; }
  .team-leaderboard-widget.left-side { left: 8px; }
  .team-leaderboard-widget.right-side { right: 8px; }
  .tlb-header { gap: 3px; font-size: 8px; }
  .tlb-title { font-size: 8px; }
  .hud-bottom-gift-bar { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 7px; width: 100%; border-radius: 8px; }
  .team-battle-hud-card { min-width: 0; width: 100%; padding: 6px; gap: 5px; display: grid; grid-template-columns: 30px 1fr; border-radius: 6px; }
  .team-battle-hud-card .voice-side { grid-column: 1; grid-row: 1 / 3; order: 0; }
  .tb-left-col { grid-column: 2; min-width: 0; }
  .tb-right-col { grid-column: 1 / 3; min-width: 0; }
  .tb-name { font-size: 10px; }
  .tb-weight { font-size: 18px; }
  .tb-gift-control-wrap { display: flex; flex-wrap: wrap; gap: 4px; }
  .tb-gift-tag { max-width: 100%; padding: 4px; }
  .tb-change-hint { font-size: 8px; white-space: normal; }
  .tb-quick-kg-box { gap: 2px; padding: 3px; max-width: 100%; }
  .tb-kg-caption { font-size: 7px; }
  .tb-quick-kg-input { width: 24px; }
  .hud-bottom-gift-bar .center-section { order: 3; grid-column: 1 / 3; width: 100%; display: grid; grid-template-columns: 32px 1fr; gap: 5px; }
  .center-section .mic-toggle { position: static; margin: 0; width: 30px; height: 32px; }
  .btn-walk-hold { min-width: 0; width: 100%; padding: 3px; font-size: 18px; }
  .center-sub-actions { grid-column: 1 / 3; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; }
  .center-sub-actions button { padding: 4px; font-size: 8px; white-space: normal; }
}

.voice-side {
  width: 66px;
  height: 64px;
  gap: 2px;
  border-width: 2px;
  border-radius: 10px;
  font-size: 25px;
  box-shadow: 0 2px 10px #0006;
}
.voice-side small { font-size: 9px; line-height: 1; font-weight: 900; letter-spacing: .04em; }
.voice-side .mic-level { width: 46px; height: 8px; }
.voice-side.left-voice { background: #073b54; border-color: #31c4ef; color: #b8f1ff; }
.voice-side.right-voice { background: #531d32; border-color: #ff5b7e; color: #ffd0d9; }
.voice-side.left-voice.held, .voice-side.left-voice.recognized, .voice-side.left-voice.supported { background: #087da2; box-shadow: 0 0 22px #36d5ffbb; transform: scale(1.06); }
.voice-side.right-voice.held, .voice-side.right-voice.recognized, .voice-side.right-voice.supported { background: #b7254c; box-shadow: 0 0 22px #ff527dbb; transform: scale(1.06); }
#camera-mode-hint { position: fixed; z-index: 80; left: 50%; top: 19%; transform: translateX(-50%); padding: 9px 15px; border: 1px solid #56d9c0; border-radius: 8px; color: #e8fff9; background: #071a1be8; font: 800 13px var(--font-main); opacity: 0; pointer-events: none; transition: opacity .16s; white-space: nowrap; }
#camera-mode-hint.visible { opacity: 1; }
.voice-lane { --voice-level: 0; --lane-color: #38cfff; display: flex; align-items: center; gap: 8px; flex: 1 1 140px; min-width: 50px; height: 44px; padding: 6px 10px; border: 1px solid #52606a; border-radius: 6px; color: #a9bac4; background: #0a1622; }
.voice-lane.right-lane { --lane-color: #ff557f; }
.voice-lane span { font-size: 10px; font-weight: 900; }
.voice-lane b { color: var(--lane-color); opacity: .35; font-size: 20px; }
.voice-track { flex: 1; height: 18px; background: #ffffff0b; overflow: hidden; border-radius: 3px; }
.voice-track i { display: block; width: calc(var(--voice-level) * 100%); height: 100%; background: var(--lane-color); transition: width 80ms linear; }
.right-lane .voice-track { display: flex; justify-content: flex-end; }
.voice-lane.active { color: white; border-color: var(--lane-color); box-shadow: 0 0 12px color-mix(in srgb, var(--lane-color) 45%, transparent); }
.voice-lane.active b { opacity: 1; }
@media (max-width: 1150px) and (min-width: 801px) { .voice-lane { position: absolute; bottom: 114px; width: 28%; } .left-lane { left: 15px; } .right-lane { right: 15px; } }
@media (max-width: 800px) {
  .team-battle-hud-card { grid-template-columns: 48px 1fr; }
  .team-battle-hud-card .voice-side { width: 46px; height: 48px; padding: 2px; font-size: 18px; }
  .voice-side small { font-size: 7px; }
  .voice-side .mic-level { width: 34px; height: 6px; }
  #camera-mode-hint { top: 24%; max-width: 94vw; font-size: 11px; }
  .voice-lane { grid-row: 2; min-width: 0; width: 100%; height: 30px; padding: 4px; gap: 4px; }
  .voice-lane .voice-track { height: 12px; }
  .voice-lane span { font-size: 8px; }
}

