<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MNG Şövalye Savaşı - Turnuva Widget</title>
  <style>
    *{box-sizing:border-box}body{margin:0;background:transparent;color:#fff;font-family:Segoe UI,Arial,sans-serif}.widget{width:350px;padding:16px;background:rgba(9,17,35,.9);border:1px solid rgba(251,191,36,.75);border-radius:8px;box-shadow:0 15px 45px rgba(0,0,0,.38)}.eyebrow{margin:0;color:#fbbf24;font-size:10px;font-weight:800;letter-spacing:1.6px}.title{margin:4px 0 13px;font-size:19px}.list{display:grid;gap:8px}.row{display:grid;grid-template-columns:27px 35px 1fr auto;align-items:center;gap:8px;min-height:43px}.rank{color:#fbbf24;font-weight:900;text-align:center}.avatar{width:35px;height:35px;object-fit:cover;border:1px solid #fbbf24;border-radius:50%;background:#293858}.name{overflow:hidden;font-size:12px;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.wins{color:#fff1a8;font-size:13px;font-weight:900}.empty{padding:16px 0;color:#b9c7df;font-size:12px;text-align:center}
  </style>
</head>
<body>
  <aside class="widget"><p class="eyebrow">CANLI TURNUVA</p><h1 class="title">Şövalye Galipleri</h1><div class="list" id="list"><p class="empty">Turnuva sonucu bekleniyor</p></div></aside>
  <script>
    const escapeHTML=value=>String(value??'').replace(/[&<>"\x27]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"\x27":'&#39;'}[c]));const list=document.getElementById('list');
    function render(entries){list.replaceChildren();if(!entries.length){list.innerHTML='<p class="empty">Turnuva sonucu bekleniyor</p>';return}entries.forEach((entry,index)=>{const row=document.createElement('div');row.className='row';const img=entry.avatar?`<img class="avatar" src="${escapeHTML(entry.avatar)}" alt="">`:'<span class="avatar"></span>';row.innerHTML=`<b class="rank">${index===0?'👑':index+1}</b>${img}<span class="name"></span><b class="wins">${Number(entry.count)||0}X</b>`;row.querySelector('.name').textContent=entry.name||'Kazanan';list.appendChild(row)})}
    function connect(){const ws=new WebSocket(`${location.protocol==='https:'?'wss:':'ws:'}//${location.host}`);ws.addEventListener('message',event=>{try{const message=JSON.parse(event.data);if(message.type==='tournament-winners')render(message.entries||[])}catch{}});ws.addEventListener('close',()=>setTimeout(connect,2500));ws.addEventListener('error',()=>ws.close())}connect();
  </script>
</body>
</html>
