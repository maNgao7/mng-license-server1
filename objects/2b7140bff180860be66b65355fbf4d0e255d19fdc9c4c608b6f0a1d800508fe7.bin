<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MNG Penalty Kick - OBS Canlı Skor Tablosu</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;800;900&family=Teko:wght@700&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
    }
    body {
      background: transparent;
      font-family: 'Montserrat', sans-serif;
      color: #ffffff;
      overflow: hidden;
      padding: 16px;
    }

    .widget-container {
      display: flex;
      flex-direction: column;
      gap: 14px;
      width: 380px;
    }

    /* Card Panels */
    .widget-card {
      background: rgba(15, 23, 42, 0.88);
      backdrop-filter: blur(14px);
      border: 2px solid rgba(255, 255, 255, 0.15);
      border-radius: 20px;
      padding: 14px 18px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 8px;
      margin-bottom: 10px;
    }

    .card-title-group {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .card-icon {
      font-size: 20px;
    }

    .card-title {
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 0.5px;
      color: #ffbe0b;
    }

    .live-dot {
      width: 8px;
      height: 8px;
      background: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 8px #10b981;
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(0.85); opacity: 0.5; }
    }

    /* Keepers List */
    .keepers-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .keeper-row {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(30, 41, 59, 0.7);
      padding: 6px 10px;
      border-radius: 12px;
      border-left: 3px solid #38bdf8;
    }

    .keeper-rank {
      font-family: 'Teko', sans-serif;
      font-size: 22px;
      font-weight: 700;
      color: #ffbe0b;
      min-width: 20px;
      line-height: 1;
    }

    .keeper-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid #ffbe0b;
    }

    .keeper-info {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .keeper-name {
      font-size: 11px;
      font-weight: 800;
      color: #ffffff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 170px;
    }

    .keeper-saves-tag {
      font-size: 10px;
      color: #38bdf8;
      font-weight: 700;
    }

    .empty-state {
      font-size: 11px;
      color: #64748b;
      text-align: center;
      padding: 10px 0;
      font-weight: 600;
    }

    /* Teams Leaderboard */
    .teams-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .team-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(30, 41, 59, 0.7);
      padding: 8px 12px;
      border-radius: 12px;
      position: relative;
      overflow: hidden;
    }

    .team-bar-fill {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      background: rgba(255, 255, 255, 0.08);
      z-index: 1;
      transition: width 0.3s ease;
    }

    .team-info {
      display: flex;
      align-items: center;
      gap: 8px;
      z-index: 2;
    }

    .team-badge {
      font-size: 18px;
      line-height: 1;
    }

    .team-name-group {
      display: flex;
      flex-direction: column;
    }

    .team-name {
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.5px;
    }

    .team-player {
      font-size: 9px;
      font-weight: 700;
      color: #94a3b8;
    }

    .team-score {
      font-family: 'Teko', sans-serif;
      font-size: 24px;
      font-weight: 700;
      color: #ffbe0b;
      z-index: 2;
      line-height: 1;
    }
  </style>
</head>
<body>
  <div class="widget-container">
    <!-- 1. En Çok Kurtaran Kaleciler -->
    <div class="widget-card" id="keepers-card">
      <div class="card-header">
        <div class="card-title-group">
          <span class="card-icon">🧤</span>
          <span class="card-title">EN ÇOK KURTARANLAR</span>
        </div>
        <div class="live-dot" title="Canlı Bağlantı"></div>
      </div>
      <div class="keepers-list" id="keepers-list">
        <div class="empty-state">Henüz kurtarış yapılmadı</div>
      </div>
    </div>

    <!-- 2. Takım Gol Krallığı -->
    <div class="widget-card" id="teams-card">
      <div class="card-header">
        <div class="card-title-group">
          <span class="card-icon">⚽</span>
          <span class="card-title">TAKIM GOL SIRALAMASI</span>
        </div>
        <span style="font-size: 10px; font-weight:800; color:#94a3b8;">CANLI SKOR</span>
      </div>
      <div class="teams-list" id="teams-list">
        <!-- Rendered dynamically -->
      </div>
    </div>
  </div>

  <script>
    const TEAMS = {
      galatasaray: { name: 'GALATASARAY', star: 'OSIMHEN #45', badge: '🟡🔴', color: '#fdb913' },
      fenerbahce: { name: 'FENERBAHÇE', star: 'LUKAKU #9', badge: '🟡🔵', color: '#fedd00' },
      besiktas: { name: 'BEŞİKTAŞ', star: 'RAFA SILVA #27', badge: '⚪⚫', color: '#ffffff' },
      trabzonspor: { name: 'TRABZONSPOR', star: 'SALAH #11', badge: '🔵🔴', color: '#6cace4' },
      amedspor: { name: 'AMEDSPOR', star: 'DIA SABA #10', badge: '🟢🔴', color: '#009639' }
    };

    let teamScores = {
      galatasaray: 0,
      fenerbahce: 0,
      besiktas: 0,
      trabzonspor: 0,
      amedspor: 0
    };

    let topKeepers = [];

    // URL parameter filtering (?type=keepers or ?type=teams) or clean pathname (/widget-keepers, /widget-teams)
    const urlParams = new URLSearchParams(window.location.search);
    const path = (window.location.pathname || '').toLowerCase();
    const widgetType = (urlParams.get('type') || '').toLowerCase();
    const isKeepersOnly = widgetType === 'keepers' || path.includes('keeper');
    const isTeamsOnly = widgetType === 'teams' || path.includes('team');

    if (isKeepersOnly) {
      const tc = document.getElementById('teams-card');
      if (tc) tc.style.display = 'none';
    } else if (isTeamsOnly) {
      const kc = document.getElementById('keepers-card');
      if (kc) kc.style.display = 'none';
    }

    const escapeHTML = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    function renderUI() {
      // Render Keepers
      const keepersEl = document.getElementById('keepers-list');
      if (topKeepers.length === 0) {
        keepersEl.innerHTML = '<div class="empty-state">Henüz kurtarış yapılmadı</div>';
      } else {
        keepersEl.innerHTML = '';
        topKeepers.slice(0, 5).forEach((k, idx) => {
          const row = document.createElement('div');
          row.className = 'keeper-row';
          row.innerHTML = `
            <span class="keeper-rank">#${idx + 1}</span>
            <img class="keeper-avatar" src="${escapeHTML(k.avatar || '/api/avatar?user=' + encodeURIComponent(k.username))}" alt="">
            <div class="keeper-info">
              <span class="keeper-name">@${escapeHTML(k.username)}</span>
              <span class="keeper-saves-tag">${Number(k.saves) || 0} Kurtarış</span>
            </div>
          `;
          keepersEl.appendChild(row);
        });
      }

      // Render Teams
      const teamsEl = document.getElementById('teams-list');
      teamsEl.innerHTML = '';
      const sortedTeams = Object.entries(TEAMS).sort((a, b) => (teamScores[b[0]] || 0) - (teamScores[a[0]] || 0));
      const maxScore = Math.max(1, ...Object.values(teamScores));

      sortedTeams.forEach(([key, t]) => {
        const score = teamScores[key] || 0;
        const pct = Math.min(100, Math.round((score / maxScore) * 100));
        const row = document.createElement('div');
        row.className = 'team-row';
        row.style.borderLeft = `3px solid ${t.color}`;

        row.innerHTML = `
          <div class="team-bar-fill" style="width: ${pct}%;"></div>
          <div class="team-info">
            <span class="team-badge">${t.badge}</span>
            <div class="team-name-group">
              <span class="team-name" style="color:${t.color};">${t.name}</span>
              <span class="team-player">${t.star}</span>
            </div>
          </div>
          <span class="team-score">${score}</span>
        `;
        teamsEl.appendChild(row);
      });
    }

    function connectWS() {
      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      const wsUrl = `${protocol}//${window.location.host}`;
      const ws = new WebSocket(wsUrl);

      ws.onmessage = evt => {
        let msg;
        try { msg = JSON.parse(evt.data); } catch { return; }
        if (msg.type === 'init-leaderboard' || msg.type === 'sync-leaderboard') {
          if (Array.isArray(msg.goalkeepers)) topKeepers = msg.goalkeepers;
          if (msg.teams) teamScores = msg.teams;
          renderUI();
        }
      };

      ws.onclose = () => {
        setTimeout(connectWS, 3000);
      };
    }

    renderUI();
    connectWS();
  </script>
</body>
</html>
